        def cancel_cooking(self):
            """Отмена готовки: сбрасывает порции и возвращает интерфейс в исходное состояние."""
            self.reset_feed_amount()

        def get_total_feed_multiply(self):
            """Возвращает общее количество еды, которое будет приготовлено"""
            return sum(self.feed_amount.values())

        def max_allowed_portions(self):
            """Максимум порций за ход для Седрика: 1 на ур 1-3, 2 на 4-6, 3 на 7-9, 4 на 10-12."""
            sedric = store.pers_dict.get("Седрик")
            if sedric is not None:
                lvl = max(1, int(getattr(sedric, "level", 1)))
                if hasattr(sedric, "feed") and len(sedric.feed) >= lvl:
                    return sedric.feed[lvl - 1]
                return max(1, 1 + (lvl - 1) // 3)
            return 1

        def can_increase(self):
            """Проверяет, можно ли увеличить суммарное число порций"""
            return self.get_total_feed_multiply() < self.max_allowed_portions()

        def can_add_portion(self, char_name, dish_name=None):
