    class FeednessPieChart(renpy.Displayable):
        """Круговая диаграмма состава очереди питания персонажа."""

        def __init__(self, char, size=40, **kwargs):
            super(FeednessPieChart, self).__init__(**kwargs)
            self.char = char
            self.size = size

        def render(self, width, height, st, at):
            render = renpy.Render(self.size, self.size)
            canvas = render.canvas()

            queue = get_feedness_queue(self.char)
            total = len(queue)
            if total <= 0:
                return render

            counts = {}
            for food_type in queue:
                counts[food_type] = counts.get(food_type, 0) + 1

            center = self.size // 2
            radius = max(1, center - 4)
            start_angle = -math.pi / 2.0
            for food_type, count in counts.items():
                if count <= 0:
                    continue

                angle_size = (2.0 * math.pi * count) / float(total)
                end_angle = start_angle + angle_size
                color = pygame.Color(store.feedness_type_colors.get(food_type, "#FFFFFF"))

                if angle_size >= (2.0 * math.pi - 0.001):
                    canvas.circle(color, (center, center), radius)
                else:
                    steps = max(8, int(radius * angle_size / 2.0))
                    points = [(center, center)]
                    for i in range(steps + 1):
                        angle = start_angle + (angle_size * i / float(steps))
                        x = center + int(round(math.cos(angle) * radius))
                        y = center + int(round(math.sin(angle) * radius))
                        points.append((x, y))
                    canvas.polygon(color, points)

                start_angle = end_angle

            canvas.circle(pygame.Color("#111111"), (center, center), radius, 1)
            return render

    def calculate_kris_atk3_difficulty(entity):
        """Сложность кликера «Удар щитом»: итоговая атака цели / защита Криса."""
        kris = (getattr(store, "pers_dict", None) or {}).get("Крис")
        if kris is None:
            return max(float(getattr(entity, "_kris_atk3_difficulty", 0.0)), 0.0)

        # Защита не может быть делителем, равным нулю.
        kris_defense = max(float(getattr(kris, "defense", 0.0)), 1.0)
        return max(float(getattr(entity, "atk", 0.0)) / kris_defense, 0.0)

