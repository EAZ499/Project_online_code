                            break

            # Добавляем артефакт в слоты
            store.wash_slots.append(self.instance_index)
            # Устанавливаем состояние "in washing machine" (1)
            store.artifact_wash_state[self.instance_index] = 1
            renpy.restart_interaction()

    class RemoveArtifactFromWashSlotAction(Action):
        """Action для удаления артефакта из слота для стирки (новый экран)."""

        def __init__(self, slot_index):
            self.slot_index = slot_index

        def __call__(self):
            if self.slot_index >= 0 and self.slot_index < len(store.wash_slots):
                # Получаем индекс экземпляра артефакта
                instance_index = store.wash_slots[self.slot_index]

                # Проверяем, есть ли сохраненный владелец
                if instance_index in store.wash_slot_owners:
                    owner_name = store.wash_slot_owners[instance_index]

                    # Если владелец существует, экипируем артефакт обратно
                    if owner_name in store.pers_dict:
                        char = store.pers_dict[owner_name]
                        inst = store.artifact_instances[instance_index]
                        artifact_id = inst["id"]

                        # Экипируем артефакт на исходного владельца
                        char.equip_artifact(artifact_id, instance_index)
                        renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} возвращён на {owner_name}!")

                    # Удаляем запись из словаря владельцев
                    del store.wash_slot_owners[instance_index]

                # Изменение состава слотов сбрасывает визуальное состояние стирки
                store.reset_wash_progress()

                # Удаляем артефакт из слота
                del store.wash_slots[self.slot_index]

                # Если стирка завершена, сохраняем статус "постиран".
                # Если нет — предмет вынули до завершения, поэтому очищаем статус.
                if store.is_washing == "success":
                    store.artifact_wash_state[instance_index] = 2
                else:
                    store.artifact_wash_state.pop(instance_index, None)
                renpy.restart_interaction()

