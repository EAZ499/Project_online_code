            """Полное восполнение запасов ингредиентов («Сбегать за продуктами» и старт боя)."""
            self.update_from_sedric()

        def reset_feed_amount(self):
            """Сброс выделенных порций для всех персонажей."""
            for k in self.feed_amount:
                self.feed_amount[k] = 0
