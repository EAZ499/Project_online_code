        @bonus_magic.setter
        def bonus_magic(self, value):
            self.bonus_magic2 = max(value, 0)

        @property
        def bonus_magic_mod(self):
            return max(self.bonus_magic_mod2, 0)

        @bonus_magic_mod.setter
        def bonus_magic_mod(self, value):
            self.bonus_magic_mod2 = max(value, 0)


        @property
        def magic_debuff_var(self):
            """Возвращает модификатор магии от дебафа с минимальным значением 0.3"""
            return max(1-self.magic_debuff*0.15, 0.3)











        # Свойства критического урона
        @property
        def base_crit(self):
            # Базовый критический урон с учётом модификатора артефактов
            return self.base_crit_levels[self.get_safe_index(self.base_crit_levels)] + self.critdmgartifactmod

        @property
        def crit(self):
            # Учет сверхкрита
            critrate_value = self.critrate  # Используем свойство для получения значения
            over = max((critrate_value - 1) * 0.5, 0) if critrate_value > 1 else 0
            # Следы на мече: вечная прибавка к крит. урону за добитых врагов.
            sword_marks_crit = kris_sword_marks_crit_bonus() if self.name == "Крис" else 0.0
            return max(
                (self.base_crit + self.crit_mod + self.bonus_crit + self.critdmg_debuff_var + over + sword_marks_crit,
                1.0)
            )

        @property
        def bonus_crit(self):
            return max(self.bonus_crit2, -0.9)

        @bonus_crit.setter
        def bonus_crit(self, value):
            self.bonus_crit2 = max(value, -0.9)

        @property
        def crit_mod(self):
