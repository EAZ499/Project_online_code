            if char is None or getattr(char, "picked", 0) != 1 or getattr(char, "current_hp", 0) <= 0:
                return False
            cur_feed = getattr(char, "current_feedness", 0)
            max_feed = getattr(char, "max_feedness", 0)
            allocated = self.feed_amount.get(char_name, 0)
            if cur_feed + allocated >= max_feed:
                return False
        def _get_recipe(self, dish_name):
            if hasattr(store, "get_sedric_recipe"):
                return store.get_sedric_recipe(dish_name)
            if "get_sedric_recipe" in globals():
                return globals()["get_sedric_recipe"](dish_name)
            return None

        def can_add_portion(self, char_name, dish_name=None):
            """Проверяет возможность добавить порцию конкретному персонажу."""
            if not self.can_increase():
                return False
            char = store.pers_dict.get(char_name)
            if char is None or getattr(char, "picked", 0) != 1 or getattr(char, "current_hp", 0) <= 0:
                return False
            cur_feed = getattr(char, "current_feedness", 0)
            max_feed = getattr(char, "max_feedness", 0)
            allocated = self.feed_amount.get(char_name, 0)
            if cur_feed + allocated >= max_feed:
                return False
            if dish_name is None:
                dish_name = getattr(store, "attackindex", None)
            cost = self._get_recipe(dish_name) if dish_name else None
            if cost:
                next_total = self.get_total_feed_multiply() + 1
                if self.current_bread_ing < cost["bread"] * next_total:
                    return False
                if self.current_plant_ing < cost["plant"] * next_total:
                    return False
                if self.current_animal_ing < cost["animal"] * next_total:
                    return False
                if self.current_spices_ing < cost["spices"] * next_total:
                    return False
            return True

        def add_portion(self, char_name, dish_name=None):
            """Добавляет 1 порцию для указанного персонажа."""
            if self.can_add_portion(char_name, dish_name):
                self.feed_amount[char_name] = self.feed_amount.get(char_name, 0) + 1
                self.waste_species_multiply = self.get_total_feed_multiply()
                self.update_future_ingredients(dish_name)

        def remove_portion(self, char_name, dish_name=None):
            """Уменьшает порцию для указанного персонажа на 1."""
            if self.feed_amount.get(char_name, 0) > 0:
                self.feed_amount[char_name] -= 1
                self.waste_species_multiply = self.get_total_feed_multiply()
                self.update_future_ingredients(dish_name)

        def update_future_ingredients(self, dish_name=None):
            """Обновляет будущие значения ингредиентов с учетом трат."""
            if dish_name is None:
                dish_name = getattr(store, "attackindex", None)
            cost = self._get_recipe(dish_name) if dish_name else None
            if cost:
                mult = self.get_total_feed_multiply()
                self.future_current_bread_ing = max(0, self.current_bread_ing - cost["bread"] * mult)
                self.future_current_plant_ing = max(0, self.current_plant_ing - cost["plant"] * mult)
                self.future_current_animal_ing = max(0, self.current_animal_ing - cost["animal"] * mult)
                self.future_current_spices_ing = max(0, self.current_spices_ing - cost["spices"] * mult)
            else:
                self.future_current_animal_ing = self.current_animal_ing - (self.waste_animal_ing * self.waste_species_multiply)
                self.future_current_plant_ing = self.current_plant_ing - (self.waste_plant_ing * self.waste_species_multiply)
                self.future_current_bread_ing = self.current_bread_ing - (self.waste_bread_ing * self.waste_species_multiply)
                self.future_current_spices_ing = self.current_spices_ing - (self.waste_spices_ing * self.waste_species_multiply)

        def can_cook_with_multiply(self, dish_name=None):
            """Проверяет, хватает ли ингредиентов для приготовления с учетом множителя"""
            if dish_name is None:
                dish_name = getattr(store, "attackindex", None)
            cost = self._get_recipe(dish_name) if dish_name else None
            if cost:
                mult = max(1, self.get_total_feed_multiply())
                return (
                    self.current_bread_ing >= cost["bread"] * mult and
                    self.current_plant_ing >= cost["plant"] * mult and
                    self.current_animal_ing >= cost["animal"] * mult and
                    self.current_spices_ing >= cost["spices"] * mult
                )
            animal_check = self.current_animal_ing - (self.waste_animal_ing * self.waste_species_multiply) >= 0
            plant_check = self.current_plant_ing - (self.waste_plant_ing * self.waste_species_multiply) >= 0
            bread_check = self.current_bread_ing - (self.waste_bread_ing * self.waste_species_multiply) >= 0
            spices_check = self.current_spices_ing - (self.waste_spices_ing * self.waste_species_multiply) >= 0
            return animal_check and plant_check and bread_check and spices_check

        def spend_allocated_ingredients(self, dish_name=None):
            """Фактически списывает потраченные ингредиенты."""
            if dish_name is None:
                dish_name = getattr(store, "attackindex", None)
            cost = self._get_recipe(dish_name) if dish_name else None
            if cost:
                mult = self.get_total_feed_multiply()
                self.current_bread_ing = max(0, self.current_bread_ing - cost["bread"] * mult)
                self.current_plant_ing = max(0, self.current_plant_ing - cost["plant"] * mult)
                self.current_animal_ing = max(0, self.current_animal_ing - cost["animal"] * mult)
                self.current_spices_ing = max(0, self.current_spices_ing - cost["spices"] * mult)
            else:
                self.current_animal_ing = max(0, self.future_current_animal_ing)
                self.current_plant_ing = max(0, self.future_current_plant_ing)
                self.current_bread_ing = max(0, self.future_current_bread_ing)
                self.current_spices_ing = max(0, self.future_current_spices_ing)
            self.future_current_bread_ing = self.current_bread_ing
            self.future_current_plant_ing = self.current_plant_ing
            self.future_current_animal_ing = self.current_animal_ing
            self.future_current_spices_ing = self.current_spices_ing
            self.waste_species_multiply = 0

        def apply_cooking(self):
            """Применяет изменения ингредиентов и сбрасывает множитель"""
            self.spend_allocated_ingredients()
            for char_name, amount in self.feed_amount.items():
                if amount > 0 and char_name in store.pers_dict:
                    store.pers_dict[char_name].feed_character(amount)
            self.reset_feed_amount()





