    class CurrentAttackerRef:
        attacker_order = ["Крис", "Азриель", "Чара", "Фриск", "Иззи", "Кловер", "Седрик", "Арчи", "Сильвия", "Фабри", "Эмили", "Сьюзи", "Ральзей", "Ноэлль", "Санс", "Бердли"]

        def __init__(self, value=None):
            self.value = value

        @property
        def name(self):
            if self.value is None:
                return None
            if hasattr(self.value, "name"):
                return self.value.name
            if isinstance(self.value, int):
                idx = self.value - 1
                if 0 <= idx < len(self.attacker_order):
                    return self.attacker_order[idx]
            return None

        def _as_index(self):
            if self.value is None:
                return 0
            if isinstance(self.value, int):
                return self.value
            if hasattr(self.value, "name"):
                try:
                    return self.attacker_order.index(self.value.name) + 1
                except ValueError:
                    return 0
            return 0

        def __int__(self):
            return self._as_index()

        def __index__(self):
            return self._as_index()

        def __sub__(self, other):
            return self._as_index() - other

        def __rsub__(self, other):
            return other - self._as_index()

        def __eq__(self, other):
            if isinstance(other, CurrentAttackerRef):
                return self._as_index() == other._as_index() and self.name == other.name
            if isinstance(other, int):
                return self._as_index() == other
            if hasattr(other, "name"):
                return self.name == other.name
            return self.value == other

        def __hash__(self):
            return hash(self._as_index())

        def __bool__(self):
            return self.value is not None

        def __getattr__(self, item):
            if self.value is None:
                raise AttributeError(item)
            return getattr(self.value, item)

        def __str__(self):
            return str(self.name if self.name is not None else self._as_index())

        def __repr__(self):
            return f"CurrentAttackerRef({self.value!r})"

