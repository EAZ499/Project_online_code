        """Изменяет дебафф по короткому префиксу и возвращает фактически добавленное значение.

        Для положительного значения первое наложение получает дополнительный
        стак по старому правилу боевых атак: при нулевом эффекте добавляется
        ``value + first_bonus``, иначе только ``value``.
        """
        if not isinstance(prefix, str):
            raise TypeError("Префикс дебафа должен быть строкой")

        normalized_prefix = prefix[:-7] if prefix.endswith("_debuff") else prefix
        allowed_prefixes = {
            "bloodshed",
            "prone",
            "atk",
            "def",
            "magic",
            "accuracy",
            "critrate",
            "critdmg",
            "tank",
        }
        if normalized_prefix not in allowed_prefixes:
            raise ValueError("Неизвестный префикс дебафа: {}".format(prefix))

        # «Стойкий» ур.2: Азриеля нельзя повалить за 20 MP.
        if normalized_prefix == "prone" and value > 0 and azri_try_prevent_prone(entity):
            return 0

        debuff_attr = normalized_prefix + "_debuff"
        current_value = getattr(entity, debuff_attr, 0)
        applied_value = value
        if value > 0 and current_value == 0:
            applied_value += first_bonus

        setattr(entity, debuff_attr, current_value + applied_value)

        indicator_attr = debuff_attr + "_got"
        if hasattr(entity, indicator_attr):
            setattr(
                entity,
                indicator_attr,
                getattr(entity, indicator_attr, 0) + applied_value,
            )

        return applied_value


