                store.button_states[self.button_key] = 1
                store.selected_button = self.button_key

                # Устанавливаем данные артефакта для экрана описания
                if self.char_name in store.pers_dict:
                    char = store.pers_dict[self.char_name]
                    # Получаем ID артефакта в слоте
                    if self.slot_index < len(char.equipped_artifacts):
                        artifact_id = char.equipped_artifacts[self.slot_index]
                        store.art_desc_artifact_id = artifact_id
                        # Находим индекс экземпляра артефакта
                        for i, inst in enumerate(store.artifact_instances):
                            if inst["id"] == artifact_id and inst["owner"] == self.char_name:
                                store.art_desc_instance_index = i
                                break

                        # Обновляем предпросмотр HP для снятия артефакта
                        store.update_hp_preview("unequip", self.char_name, artifact_id)
                    else:
                        store.update_hp_preview(None)
                else:
                    store.update_hp_preview(None)

                renpy.restart_interaction()
            else:
                # Второе нажатие: выполняем действие и сбрасываем состояние
                store.button_states[self.button_key] = 0
                store.selected_button = None

                # Сбрасываем данные артефакта
                store.art_desc_artifact_id = None
                store.art_desc_instance_index = None
                renpy.hide_screen("art_desc")

                # Отключаем предпросмотр перед выполнением действия
                store.update_hp_preview(None)

                if self.char_name in store.pers_dict:
                    char = store.pers_dict[self.char_name]
                    char.unequip_artifact(self.slot_index)

        def get_image(self):
            """Возвращает изображение кнопки в зависимости от состояния"""
            state = store.button_states.get(self.button_key, 0)
            if state == 1:
                return "images/equip1.png"
            return "images/equip0.png"


