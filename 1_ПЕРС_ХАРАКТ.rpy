    class AddArtifactToWashSlotAction(Action):
        """Action для добавления артефакта в слот для стирки."""

        def __init__(self, instance_index):
            self.instance_index = instance_index

        def __call__(self):
            if self.instance_index < 0 or self.instance_index >= len(store.artifact_instances):
                return

            inst = store.artifact_instances[self.instance_index]
            artifact_id = inst["id"]

            # Проверяем, можно ли стирать этот артефакт
            wash_type = store.artifact_wash_type.get(artifact_id, "nothing")
            if wash_type == "nothing":
                renpy.notify("Этот артефакт нельзя стирать.")
                return

            # Проверяем, не превышен ли лимит слотов (6)
            if len(store.wash_slots) >= 6:
                renpy.notify("Достигнут лимит слотов для стирки (6).")
                return

            # Проверяем, не добавлен ли уже этот артефакт
            if self.instance_index in store.wash_slots:
                renpy.notify("Этот артефакт уже добавлен в слоты стирки.")
                return

            # Если артефакт экипирован, снимаем его перед добавлением в слот стирки
            if inst["owner"] is not None and inst["owner"] in store.pers_dict:
                char = store.pers_dict[inst["owner"]]
                # Сохраняем владельца для последующего возвращения
                store.wash_slot_owners[self.instance_index] = inst["owner"]
                # Находим и снимаем артефакт с персонажа
                if artifact_id in char.equipped_artifacts:
                    # Находим индекс слота с этим артефактом
                    for slot_idx, equipped_id in enumerate(char.equipped_artifacts):
                        if equipped_id == artifact_id:
                            # Снимаем артефакт
                            char.equipped_artifacts.pop(slot_idx)
                            inst["owner"] = None
                            char.recalc_artifactmod()
                            renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} снят с {char.name} для стирки.")
                            break

            # Добавляем артефакт в слоты
            store.wash_slots.append(self.instance_index)
            renpy.restart_interaction()

    class RemoveArtifactFromWashSlotAction(Action):
        """Action для удаления артефакта из слота для стирки."""

        def __init__(self, slot_index):
            self.slot_index = slot_index

        def __call__(self):
            if self.slot_index >= 0 and self.slot_index < len(store.wash_slots):
                # Получаем индекс экземпляра артефакта
                instance_index = store.wash_slots[self.slot_index]

                # Проверяем, есть ли сохраненный владелец
                if instance_index in store.wash_slot_owners:
                    owner_name = store.wash_slot_owners[instance_index]

                    # Если владелец существует, экипируем артефакт обратно
                    if owner_name in store.pers_dict:
                        char = store.pers_dict[owner_name]
                        inst = store.artifact_instances[instance_index]
                        artifact_id = inst["id"]

                        # Экипируем артефакт на исходного владельца
                        char.equip_artifact(artifact_id, instance_index)
                        renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} возвращен на {owner_name}!")

                    # Удаляем запись из словаря владельцев
                    del store.wash_slot_owners[instance_index]

                # Удаляем артефакт из слота
                del store.wash_slots[self.slot_index]

                # Если стирка завершена, сохраняем статус "постиран".
                # Если нет — предмет вынули до завершения, поэтому очищаем статус.
                if store.is_washing == "success":
                    store.artifact_wash_state[instance_index] = 2
                else:
                    store.artifact_wash_state.pop(instance_index, None)
                renpy.restart_interaction()

    class IdentifyFromSlotAction(Action):
        """Action для опознания артефакта из слота."""

        def __call__(self):
            # Проверяем, что слот не пуст
            if store.identify_slot is None:
                renpy.notify("Слот опознания пуст.")
                return

            instance_index = store.identify_slot
            inst = store.artifact_instances[instance_index]
            artifact_id = inst["id"]

            # Проверяем, достаточно ли денег
            cost = store.artifact_identify_cost.get(artifact_id, 0)
            if store.money < cost:
                renpy.notify(f"Недостаточно денег! Требуется {cost} золота.")
                return

            # Списываем деньги до попытки опознания (тратятся всегда)
            store.money -= cost

            # Пытаемся опознать артефакт
            if identify_artifact(instance_index):
                # Успешное опознание
                store.is_checking = "success"
                renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} опознан за {cost} золота!")
                # Очищаем слот
                store.identify_slot = None
            else:
                # Неудачное опознание - деньги уже потрачены
                store.is_checking = "fail"
                renpy.notify(f"Опознание не удалось! {cost} золота потрачено.")
                # Очищаем слот
                store.identify_slot = None

            renpy.restart_interaction()

