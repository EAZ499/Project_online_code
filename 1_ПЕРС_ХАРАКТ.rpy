        @property
        def critdmg_debuff_var(self):
            """Возвращает модификатор критического урона от дебафа с минимальным значением -0.5"""
            return max(0-self.critdmg_debuff*0.1, -0.5)

        @property
        def next_attack_multiplier(self):
