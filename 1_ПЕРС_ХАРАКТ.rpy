# ------------------------------------------------------------
# Обновление прогресса и завершение стирки выполняются функцией
# wash_background_update, вызываемой таймерами из всех ключевых
# экранов (wash_screen, game_screen, artifacts_menu,
# wash_proceed_in_progress). Прогресс считается от реального времени,
# поэтому выход с экрана стирки или смена контекста больше не
# «замораживает» его.

init python:
    def wash_background_update():
        """
        Фоновая логика стирки: обновление прогресса и завершение.
        Не привязана к конкретному экрану — вызывается таймерами
        из всех ключевых контекстов.
        """
        if not getattr(store, "wash_in_progress", False):
            return
        if store.is_washing != "is_washing":
            return

        # Прогресс считается от реального времени,
        # поэтому не может «замереть».
        elapsed = time.time() - store.wash_start_time
        store.wash_timer_elapsed = min(elapsed, store.wash_timer_total)

        # Завершение — однократно (wash_artifacts_from_slots
        # сбрасывает wash_in_progress в False).
        if elapsed >= store.wash_timer_total:
            store.wash_artifacts_from_slots()
            renpy.restart_interaction()


