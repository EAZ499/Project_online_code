        # Свойства уровня
        @property
        def level(self):
            return Pers.global_level + 1 if self.name == "Иззи" else Pers.global_level

        @level.setter
        def level(self, new_level):
            # Для Иззи вычитаем 1 из нового уровня, т.к. она всегда на +1 выше
            Pers.global_level = max(1, new_level)
            # Обновляем HP и MP до новых максимумов для текущего уровня
            self.current_hp = self.max_hp
            self.current_mp = self.max_mp
            # Проверяем и удаляем лишние артефакты, если слотов стало меньше
            if hasattr(self, 'check_and_remove_excess_artifacts'):
                self.check_and_remove_excess_artifacts()

        def set_level(self, new_level):
            """Метод для установки уровня (совместимость с существующим кодом)"""
            self.level = new_level

        def get_safe_index(self, arr):
            """Безопасное получение индекса для массива уровней"""
            return min(self.level - 1, len(arr) - 1)

        # Свойства здоровья
        @property
        def max_hp(self):
            # Максимальное HP с учётом модификатора артефактов.
            # DECAYING: у Криса оно навсегда урезано на число смертей
            # (persistent, не привязано к слоту сохранения).
            decaying_penalty = kris_decaying_penalty() if self.name == "Крис" else 0
            return max(1, self.max_hp_levels[self.get_safe_index(self.max_hp_levels)]
                       + self.maxhpartifactmod - decaying_penalty)

        @max_hp.setter
        def max_hp(self, value):
            # Устанавливаем значение для текущего уровня
            index = self.get_safe_index(self.max_hp_levels)
            self.max_hp_levels[index] = value

        def change_hp(self, delta):
            self.current_hp = int(max(0, min(self.current_hp + delta, self.max_hp)))

            # Проверка на поражение всех персонажей
            all_dead = True
            for char in store.characters.values():
                if char.current_hp > 0:
                    all_dead = False
                    break
            if all_dead and not store.game_over_triggered:
                store.game_over_triggered = True
                renpy.jump("gameover")

        # Свойства маны
        @property
        def max_mp(self):
            if self.name == "Кловер":
                # Для Кловера max_mp зависит от калибра оружия, а не от уровня
                return self.caliber_mp_values.get(self.gun_caliber, 0)
            # Максимальная мана с учётом модификатора артефактов
            return self.max_mp_levels[self.get_safe_index(self.max_mp_levels)] + self.maxmpartifactmod

        @max_mp.setter
        def max_mp(self, value):
            if self.name == "Кловер":
                # Для Кловера max_mp зависит от калибра оружия, а не от уровня
                # Изменение max_mp для Кловера не поддерживается напрямую
                pass
            else:
                # Устанавливаем значение для текущего уровня
                index = self.get_safe_index(self.max_mp_levels)
                self.max_mp_levels[index] = value

        def change_gun_caliber(self, new_caliber):
            if self.name == "Кловер" and new_caliber in self.caliber_mp_values:
                self.gun_caliber = new_caliber
                # Убедимся, что текущее MP не превышает новый максимум
                self.current_mp = min(self.current_mp, self.max_mp)

















        # Свойства атаки
        @property
        def base_atk(self):
            # Базовая атака с учётом модификатора артефактов
            return self.base_atk_levels[self.get_safe_index(self.base_atk_levels)] + self.atkartifactmod

        @property
        def atk(self):
            # Атака считается аддитивно: к (base_atk + base_atk_mod) прибавляются
            # отдельные вклады каждого множителя, умноженные только на базовую атаку.
            # Следы на мече: вечная прибавка за каждого добитого Крисом врага.
            sword_marks_atk = kris_sword_marks_atk_bonus() if self.name == "Крис" else 0.0
            return max(
                (self.base_atk + self.base_atk_mod) +
                (self.base_atk * self.bonus_atk) +
                (self.base_atk * (self.atk_debuff_var - 1)) +
                (self.base_atk * (self.rtlns_mod - 1)) +
                (self.base_atk * sword_marks_atk)
            , 1)

        @property
        def kris_atk3_difficulty(self):
            return calculate_kris_atk3_difficulty(self)

        @kris_atk3_difficulty.setter
        def kris_atk3_difficulty(self, value):
            self._kris_atk3_difficulty = max(float(value), 0.0)


        @property
        def base_atk_mod(self):
            return self.base_atk_mod2

        @base_atk_mod.setter
        def base_atk_mod(self, value):
            self.base_atk_mod2 = value

        @property
        def bonus_atk(self):
            return max(self.bonus_atk2, 0)

        @bonus_atk.setter
        def bonus_atk(self, value):
            self.bonus_atk2 = max(value, 0)

        @property
        def bonus_atk_mod(self):
            return max(self.bonus_atk_mod2, 0)

        @bonus_atk_mod.setter
        def bonus_atk_mod(self, value):
            self.bonus_atk_mod2 = max(value, 0)

        @property
        def atk_debuff_var(self):
            """Возвращает модификатор атаки от дебафа с минимальным значением -0.5"""
            return max(1-self.atk_debuff*0.1, -0.5)












        # Свойства магии
        @property
        def base_magic(self):
            # Проверяем, существует ли base_magic_levels
            if not hasattr(self, 'base_magic_levels'):
                return 0
            # Базовая магия с учётом модификатора артефактов.
            # «Подсознательная память»: Азриель навсегда прибавляет магию
            # за каждый проигранный бой (persistent, вне слотов сохранения).
            memory_bonus = azri_memory_bonus() if self.name == "Азриель" else 0
            return (self.base_magic_levels[self.get_safe_index(self.base_magic_levels)]
                    + self.magicartifactmod + memory_bonus)

        @property
        def magic(self):
            # Магия считается аддитивно, как атака: к (base_magic + base_magic_mod)
            # прибавляются отдельные вклады каждого множителя, умноженные на базовую магию.
            return max(
                (self.base_magic + self.base_magic_mod) +
                (self.base_magic * self.bonus_magic) +
                (self.base_magic * (self.magic_debuff_var - 1)) +
                (self.base_magic * (self.rtlns_mod - 1))
            , 1)

        @property
        def base_magic_mod(self):
            return max(self.base_magic_mod2, 0)

        @base_magic_mod.setter
        def base_magic_mod(self, value):
            self.base_magic_mod2 = max(value, 0)

        @property
        def bonus_magic(self):
