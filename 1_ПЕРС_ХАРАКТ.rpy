# Экран для отображения урона
screen damage_display_screen(attacker, target, self_dmg, target_dmg):
    zorder 100
    modal True

    # Фон
    add "#00000080"

    # Заголовок
    text "Результаты атаки '{attacker}'" size 40 xalign 0.5 yalign 0.2 color "#ffffff"

    # Урон по цели
    if target_dmg > 0:
        text "{target} получил урон: [target_dmg]" size 30 xalign 0.5 yalign 0.4 color "#ff0000"
    else:
        text "{target} не получил урона" size 30 xalign 0.5 yalign 0.4 color "#ffffff"

    # Урон по себе
    if self_dmg > 0:
        text "{attacker} получила урон: [self_dmg]" size 30 xalign 0.5 yalign 0.6 color "#ff6666"
    else:
        text "{attacker} не получила урона" size 30 xalign 0.5 yalign 0.6 color "#ffffff"

    # Таймер для автоматического закрытия
    timer 2.0 action Hide("damage_display_screen")

# Новый лейбл для магии Иззи "Осколок себя"
label izzymag1_is_done:
    # Получаем цель
    $ target = store.oskolok_sebya_target

    # Количество успешных нажатий
    $ successful_presses = store.simon_game.successful_presses

    # Увеличиваем магическую атаку на 10% за каждую успешную кнопку
    $ attack_bonus = 1.0 + (successful_presses * 0.1)
    $ original_magic = store.pers_dict["Иззи"].bonus_magic
    $ store.pers_dict["Иззи"].bonus_magic *= attack_bonus

    # Рассчитываем урон Иззи (10%*максхп*кнопок)
    $ self_damage = int(store.pers_dict["Иззи"].max_hp * 0.1 * successful_presses)

    # Наносим урон Иззи
    $ store.pers_dict["Иззи"].change_hp(-self_damage)

    # Наносим урон противнику
    if target and target.current_hp > 0:
        $ magic_dmg = int(max(0, store.pers_dict["Иззи"].calculate_magic(target)))
        $ target.current_hp = max(0, target.current_hp - magic_dmg)
        $ store._log_magic_damage(store.pers_dict["Иззи"], target, magic_dmg, is_crit=False)

        # Показываем экран с уроном на 2 секунды
        $ store.show_damage_screen(store.pers_dict["Иззи"].name, target.name, self_damage, magic_dmg)

    # Возвращаем исходное значение бонуса магии (баф пропадает)
    $ store.pers_dict["Иззи"].bonus_magic = original_magic

    # ХП НЕ возвращается по условию задачи

    # Завершаем ход Иззи
    $ store.pers_dict["Иззи"].turn = 0

    # Показываем экран урона на 2 секунды
    $ renpy.pause(2.0)

    # Возвращаемся к выбору персонажа
    call choose_attacker_screen

