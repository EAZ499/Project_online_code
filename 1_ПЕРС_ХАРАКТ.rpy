            sedric = store.pers_dict.get("Седрик")
            if sedric is not None:
                lvl = max(1, int(getattr(sedric, "level", 1)))
                idx = min(len(sedric.animal_ing) - 1, lvl - 1)
                self.current_animal_ing = sedric.animal_ing[idx]
                self.current_plant_ing = sedric.plant_ing[idx]
                self.current_bread_ing = sedric.bread_ing[idx]
                self.current_spices_ing = sedric.spices_ing[idx]
