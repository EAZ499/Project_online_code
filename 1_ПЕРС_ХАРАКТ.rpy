            self.sequence = [renpy.random.randint(1, 7) for i in range(self.difficulty)]
            self.player_sequence = []
            self.current_step = 0
            self.showing_sequence = True
            self.demo_index = 0
            self.successful_presses = 0  # Сбрасываем счетчик успешных нажатий
            renpy.show_screen("izzy_saimon2")
            #renpy.restart_interaction()
            renpy.pause(0.1)
            self.demo_step(0)

        def demo_step(self, index):
            """Рекурсивная функция для демонстрации шагов"""
            if index < len(self.sequence):
                self.demo_index = index
                renpy.pause(0.3)
                renpy.invoke_in_main_thread(self.demo_step, index + 1)
            else:
                self.showing_sequence = False
                self.demo_index = 0
                renpy.pause(0.3)

        def check_button(self, button_number):
            """Проверяет нажатую кнопку"""
            if self.showing_sequence:
                return

            self.player_sequence.append(button_number)

            if self.current_step < len(self.sequence) and button_number == self.sequence[self.current_step]:
                # Правильное нажатие
                self.current_step += 1
                self.successful_presses += 1  # Увеличиваем счетчик успешных нажатий
                store.base_perform += 0.2

                if self.current_step >= len(self.sequence):
                    # Успешное завершение игры
                    renpy.hide_screen("izzy_saimon2")
                    renpy.jump("izzymag1_is_done")  # Переходим к новому лейблу
