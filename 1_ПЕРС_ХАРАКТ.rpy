    def sync_equipped_artifacts():
        """
        Синхронизирует экипированные артефакты с artifact_instances.
        Эта функция обновляет поле 'owner' в artifact_instances на основе
        списка equipped_artifacts каждого персонажа.
        """
        # Сначала сбрасываем владельцев всех артефактов
        for inst in store.artifact_instances:
            inst["owner"] = None

        # Затем устанавливаем владельцев для экипированных артефактов
        if store.pers_dict:
            for char_name, char in store.pers_dict.items():
                if hasattr(char, 'equipped_artifacts'):
                    # Создаем словарь для подсчета количества каждого типа артефакта
                    artifact_counts = {}
                    for artifact_id in char.equipped_artifacts:
                        if artifact_id is not None:
                            artifact_counts[artifact_id] = artifact_counts.get(artifact_id, 0) + 1

                    # Проходим по artifact_instances и устанавливаем владельцев
                    for inst in store.artifact_instances:
                        artifact_id = inst["id"]
                        if artifact_id in artifact_counts and artifact_counts[artifact_id] > 0:
                            inst["owner"] = char_name
                            artifact_counts[artifact_id] -= 1

