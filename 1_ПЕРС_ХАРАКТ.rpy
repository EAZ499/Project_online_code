        def calculate_dmg_to_hero(self, hero):
            store.last_protected_box_style = "damaged"

            # Проверка на попадание (ДО обработки щита)
            hit_prob = min(self.dmgchance, 1.0)
            if random.random() > hit_prob:
                # Промах: щит НЕ тратится, попадания нет
                self.popal = 0
                store.is_crit = False
                self.crits = 0
                store.dmg = 0
                hero.damage_gain_for_vis = 0  # Мимо (0 = промах, -1 = не был целью)
                store.clear_swoon_pending_for_visual(hero)
                return 0

            # Попадание
            self.popal = 1

            # Проверка на критический удар
            crit_roll = renpy.random.randint(1, 100)
            store.is_crit = 1 if crit_roll <= (self.critrate * 100) else 0  # Преобразуем из доли в проценты
            self.crits = store.is_crit

            # Случайный множитель от 0.9 до 1.1
            random_factor = renpy.random.uniform(0.9, 1.1)

            # Расчет базового урона с учетом защиты героя
            if store.is_crit:
                base_damage = self.atk * self.crit * random_factor * store.enemy_ind_atk_ratio
            else:
                base_damage = self.atk * random_factor * store.enemy_ind_atk_ratio

            next_attack_multiplier = max(0.0, getattr(self, "next_attack_damage_multiplier", 1.0))
            if next_attack_multiplier != 1.0:
                base_damage *= next_attack_multiplier
                self.next_attack_damage_multiplier = 1.0

            # Применение защиты героя. Бонус связи «Позвать за щит»
            # (kris_shield_def_bonus) уже входит в Pers.defense.
            effective_defense = hero.defense
            damage = max(10, base_damage - effective_defense)

            # Ограничение урона
            damage = int(round(damage))
            damage = max(10, damage)

            # Крис может связать с собой союзника заклинанием «Позвать за щит».
            # Попадание в любого из них тогда наносит урон обоим.
            linked = getattr(hero, "kris_shield_partner", None)
            if linked is not None and getattr(linked, "kris_shield_partner", None) is not hero:
                linked = None

            def apply_hero_damage(victim, amount):
                # «Правильный угол» (магия Криса ур.5): 50% шанс полностью
                # проигнорировать урон, заряд тратится на эту атаку.
                if kris_try_right_angle_dodge(victim):
                    store.clear_swoon_pending_for_visual(victim)
                    victim.damage_gain_for_vis = 0
                    return 0
                # Сильвия «Ловкость в бою» (ур.1): шанс полностью уклониться
                # от атаки. Работает только когда цель — сама Сильвия.
                if sylvia_try_dodge(victim):
                    store.clear_swoon_pending_for_visual(victim)
                    victim.damage_gain_for_vis = 0
                    return 0
                # Фабри «Не поймаешь» (магия М-с Морковки ур.3): шанс
                # уклонения = танк цели − 35, действует на выбранную цель.
                if fabri_try_dodge(victim):
                    store.clear_swoon_pending_for_visual(victim)
                    victim.damage_gain_for_vis = 0
                    return 0
                if getattr(victim, "shield", 0) > 0:
                    victim.shield -= 1
                    new_character_bubble_burst(victim)
                    if getattr(victim, "sans_bone_shield", 0) and victim.shield <= 0:
                        new_character_add_status(self, "sans_karma", 3)
                        victim.sans_bone_shield = 0
                    store.last_protected_box_style = "shield"
                    store.clear_swoon_pending_for_visual(victim)
                    victim.damage_gain_for_vis = 1
                    return 1
                # Санс: «Ответственность старшего» — смертельный удар по
                # союзнику принимает на себя Санс, если он ещё жив.
                sans = (getattr(store, "pers_dict", {}) or {}).get("Санс")
                if (getattr(victim, "name", None) != "Санс" and sans is not None and
                        getattr(sans, "current_hp", 0) > 0 and
                        getattr(victim, "current_hp", 0) > 0 and amount >= victim.current_hp):
                    victim.damage_gain_for_vis = 0
                    return apply_hero_damage(sans, amount)
                old_hp = victim.current_hp
                victim.current_hp = max(0, victim.current_hp - max(0, amount))
                new_character_on_damage_taken(victim, max(0, amount), self)
                # Пассивки Криса: «Вмятины на щите» (+2% bonus_def за удар
                # в стойке со щитом) и «Желание жить» (20% HP раз за бой).
                kris_passive_on_hero_damage(victim, old_hp)
                # Пассивки Азриеля: «Лоб в лоб», «Стойкий» и «Рука помощи».
                azri_on_damage_taken(victim, old_hp)
                azri_try_helping_hand(victim)
                # Сильвия: урон сбивает комбинацию движений и накопленный танк.
                if getattr(victim, "name", None) == "Сильвия":
                    sylvia_on_damage_received(amount)
                store.update_swoon_pending_for_visual(victim, old_hp)
                victim.damage_gain_for_vis = amount
                return amount

            raw_damage = damage
            damage = apply_hero_damage(hero, raw_damage)
            if linked is not None and linked.current_hp > 0:
                apply_hero_damage(linked, raw_damage)
                linked.got_crit_for_visual = hero.got_crit_for_visual

            # Обновление переменных цели для визуализации
            if damage == 1:
                hero.damage_gain_for_vis = 1
                store.clear_swoon_pending_for_visual(hero)
            elif damage > 1:
                hero.damage_gain_for_vis = damage  # Сохраняем урон для визуализации
            else:
                hero.damage_gain_for_vis = 0  # Нулевой урон
                store.clear_swoon_pending_for_visual(hero)

            if store.is_crit:
                hero.got_crit_for_visual = 1  # Критический удар
            else:
                hero.got_crit_for_visual = 0  # Обычное попадание

            # Применение дебафов
            self.apply_debuffs_to_hero(hero)

            # Особый дебафф кровотечения для Джевила
            if self.name == "Джевил" and hero.shield == 0:
                hero.bloodshed_debuff += 3
                hero.bloodshed_debuff_got += 3

            return damage













        def apply_debuffs_to_hero(self, hero):
            """Применяет дебафы к герою с учетом шансов"""
            # Кровотечение
            if renpy.random.randint(0, 100) <= self.bloodshed_debuffchance and hero.shield == 0:
                #if hero.bloodshed_debuff == 0:
