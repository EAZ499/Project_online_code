        #функции инвентаря

        def get_max_slots(self):
            """Возвращает максимальное количество слотов для экипировки"""
            # Таблица базового количества слотов по уровню:
            #   1:3, 2:4, 3:5, 4:6, 5:7, 6:8, 7:8, 8:9, 9:9, 10:10
            level = self.level
            if level <= 6:
                base_slots = level + 2
            elif level <= 8:
                base_slots = level + 1
            else:
                base_slots = level
            return base_slots + self.extraequip

        def check_and_remove_excess_artifacts(self):
            """Проверяет и удаляет лишние артефакты, если их больше доступных слотов"""
            max_slots = self.get_max_slots()
            while len(self.equipped_artifacts) > max_slots:
                # Удаляем последний артефакт
                excess_item = self.equipped_artifacts.pop()
                # Освобождаем владельца в экземпляре
                for inst in store.artifact_instances:
                    if inst["id"] == excess_item and inst["owner"] == self.name:
                        inst["owner"] = None
                        break
                renpy.notify("Лишний артефакт [store.artifact_names.get(excess_item, excess_item)] снят из-за ограничения слотов!")
            self.recalc_artifactmod()




        # Методы для работы с артефактами
        def recalc_artifactmod(self):
            # Сбрасываем все модификаторы
            self.atkartifactmod = 0
            self.defartifactmod = 0
            self.maxhpartifactmod = 0
            self.maxmpartifactmod = 0
            self.hpregenartifactmod = 0
            self.mpregenartifactmod = 0
            self.mpcostartifactmod = 0.0
            self.magicartifactmod = 0
            self.accuracyartifactmod = 0
            self.critrateartifactmod = 0
            self.critdmgartifactmod = 0
            # Сбрасываем новые модификаторы
            self.socializationartifactmod = 0
            self.diplomacyartifactmod = 0
            self.charmartifactmod = 0
            self.perceptionartifactmod = 0
            self.rhetoricartifactmod = 0
            self.artistryartifactmod = 0
            self.comfortartifactmod = 0
            self.powerartifactmod = 0
            self.bonus_tank = 0

            # Считаем модификаторы для каждого экипированного артефакта
            for artifact_id in self.equipped_artifacts:
                if artifact_id is not None:
                    modifier_types = store.artifact_modifiers.get(artifact_id, [])
                    modifier_values = store.artifact_modifier_values.get(artifact_id, [])

                    # Социальные модификаторы
                    social_modifiers = store.artifact_social_modifiers.get(artifact_id, [])
                    social_values = store.artifact_social_modifier_values.get(artifact_id, [])

                    # Проходим по всем боевым модификаторам артефакта
                    for i, modifier_type in enumerate(modifier_types):
                        if i < len(modifier_values):
                            modifier_value = modifier_values[i]

                            if modifier_type == "atkartifactmod":
                                self.atkartifactmod += modifier_value
                            elif modifier_type == "defartifactmod":
                                self.defartifactmod += modifier_value
                            elif modifier_type == "maxhpartifactmod":
                                self.maxhpartifactmod += modifier_value
                            elif modifier_type == "maxmpartifactmod":
                                self.maxmpartifactmod += modifier_value
                            elif modifier_type == "hpregenartifactmod":
                                self.hpregenartifactmod += modifier_value
                            elif modifier_type == "mpregenartifactmod":
                                self.mpregenartifactmod += modifier_value
                            elif modifier_type == "mpcostartifactmod":
                                self.mpcostartifactmod += modifier_value
                            elif modifier_type == "magicartifactmod":
                                self.magicartifactmod += modifier_value
                            elif modifier_type == "accuracyartifactmod":
                                self.accuracyartifactmod += modifier_value
                            elif modifier_type == "critrateartifactmod":
                                self.critrateartifactmod += modifier_value
                            elif modifier_type == "critdmgartifactmod":
                                self.critdmgartifactmod += modifier_value
                            elif modifier_type == "perceptionartifactmod":
                                self.perceptionartifactmod += modifier_value
                            elif modifier_type == "artistryartifactmod":
                                self.artistryartifactmod += modifier_value
                            elif modifier_type == "socializationartifactmod":
                                self.socializationartifactmod += modifier_value
                            elif modifier_type == "diplomacyartifactmod":
                                self.diplomacyartifactmod += modifier_value
                            elif modifier_type == "charmartifactmod":
                                self.charmartifactmod += modifier_value
                            elif modifier_type == "rhetoricartifactmod":
                                self.rhetoricartifactmod += modifier_value
                            elif modifier_type == "comfortartifactmod":
                                self.comfortartifactmod += modifier_value
                            elif modifier_type == "powerartifactmod":
                                self.powerartifactmod += modifier_value
                            elif modifier_type == "tankartifactmod":
                                self.bonus_tank += modifier_value

                    # Проходим по всем социальным модификаторам артефакта
                    for i, modifier_type in enumerate(social_modifiers):
                        if i < len(social_values):
                            modifier_value = social_values[i]

                            if modifier_type == "socializationartifactmod":
                                self.socializationartifactmod += modifier_value
                            elif modifier_type == "diplomacyartifactmod":
                                self.diplomacyartifactmod += modifier_value
                            elif modifier_type == "charmartifactmod":
                                self.charmartifactmod += modifier_value
                            elif modifier_type == "perceptionartifactmod":
                                self.perceptionartifactmod += modifier_value
                            elif modifier_type == "rhetoricartifactmod":
                                self.rhetoricartifactmod += modifier_value
                            elif modifier_type == "artistryartifactmod":
                                self.artistryartifactmod += modifier_value
                            elif modifier_type == "comfortartifactmod":
                                self.comfortartifactmod += modifier_value
                            elif modifier_type == "powerartifactmod":
                                self.powerartifactmod += modifier_value

                    # Индивидуальные (персонажные) бонусы артефакта
                    char_overrides = store.artifact_character_modifiers.get((artifact_id, self.name), {})
                    for modifier_type, modifier_value in char_overrides.items():
                        if hasattr(self, modifier_type):
                            setattr(self, modifier_type, getattr(self, modifier_type) + modifier_value)

            # ============================================================
            # СЕТОВЫЕ БОНУСЫ
            # ============================================================
            for mod_type, mod_value in get_active_set_bonuses(self).items():
                if mod_type == "tankartifactmod":
                    self.bonus_tank += mod_value
                elif hasattr(self, mod_type):
                    setattr(self, mod_type, getattr(self, mod_type) + mod_value)

            # Для обратной совместимости считаем общий artifactmod
            self.artifactmod = self.atkartifactmod + self.defartifactmod + self.maxhpartifactmod

        def can_equip_artifact(self, item_id, instance_index=None):
            # Проверяем, можно ли экипировать этот артефакт
            if instance_index is not None:
                # Проверяем конкретный экземпляр: он должен существовать
                if instance_index < 0 or instance_index >= len(store.artifact_instances):
                    return False
                # Экземпляр можно экипировать, если он не принадлежит текущему персонажу
                # (если прина��лежит, то это значит нужно снять и надеть заново)
                return True
            else:
                # Старое поведение: ищем любой свободный экземпляр
                free_count = 0
                for inst in store.artifact_instances:
                    if inst["id"] == item_id and inst["owner"] is None:
                        free_count += 1
                return free_count > 0

        def equip_artifact(self, item_id, instance_index=None):
            # Проверяем, есть ли свободные слоты
            max_slots = self.get_max_slots()
            equipped_count = sum(1 for x in self.equipped_artifacts if x is not None)
            if equipped_count >= max_slots:
                renpy.notify("Нет свободных слотов. Максимум: [max_slots]")
                return

            # Если указан конкретный экземпляр, работаем с ним
            if instance_index is not None:
                # Проверяем валидность индекса
                if instance_index < 0 or instance_index >= len(store.artifact_instances):
                    renpy.notify("Неверный индекс артефакта.")
                    return

                inst = store.artifact_instances[instance_index]

                # Проверяем, что это нужный тип артефакта
                if inst["id"] != item_id:
                    renpy.notify("Несовпадение типа артефакта.")
                    return

                # Если этот экземпляр уже экипирован на текущего персонажа
                if inst["owner"] == self.name:
                    renpy.notify("Этот артефакт уже надет на [self.name].")
                    return

                # Если артефакт принадлежит другому персонажу, снимаем его с него
                if inst["owner"] is not None and inst["owner"] != self.name:
                    prev_owner = store.pers_dict.get(inst["owner"])
                    if prev_owner:
                        # Снимаем артефакт с предыдущего владельца
                        if item_id in prev_owner.equipped_artifacts:
                            prev_owner.equipped_artifacts.remove(item_id)
                        prev_owner.recalc_artifactmod()

                # Экипируем артефакт на текущего персонажа
                self.equipped_artifacts.append(item_id)
                inst["owner"] = self.name
                self.recalc_artifactmod()
                notify_set_change(self, item_id, True)
                renpy.notify("[self.name] теперь экипировал этот артефакт!")
                return


            # Старое поведение: ищем свободный экземпляр
            if not self.can_equip_artifact(item_id):
                renpy.notify("Нет свободных экземпляров этого артефакта.")
                return

            # Находим первый свободный экземпляр этого типа артефакта
            instance_index = None
            for i, inst in enumerate(store.artifact_instances):
                if inst["id"] == item_id and inst["owner"] is None:
                    instance_index = i
                    break

            if instance_index is None:
                renpy.notify("Нет свободных экземпляров этого артефакта.")
                return

            # Артефакты больше не удаляются из инвентаря при экипировке
            self.equipped_artifacts.append(item_id)
            store.artifact_instances[instance_index]["owner"] = self.name
            self.recalc_artifactmod()
            notify_set_change(self, item_id, True)

        def use_weapon_consumable(self, item_id, target_enemy=None):
            item_display_name = getattr(store, "consumable_names", {}).get(item_id, item_id)
            if hasattr(store, 'apply_weapon_consumable_effects'):
                store.apply_weapon_consumable_effects(self, item_id, target_enemy)
                return True

            renpy.notify("Для предмета [item_display_name] не найден обработчик.")
            return False

        def use_regular_consumable(self, item_id):
            if not self.can_be_fed():
                renpy.notify("[self.name] больше не может есть сейчас.")
                return False

            # Применяем все уровни эффектов от consumable
            if hasattr(store, 'apply_consumable_all_effects'):
                store.apply_consumable_all_effects(self, item_id)
            else:
                # Обратная совместимость: старая система
                heal_amount = store.consumable_effects.get(item_id, 0)
                self.current_hp = min(self.current_hp + heal_amount, self.max_hp)

            self.feed_character(1)
            push_feedness_item(self, item_id)
            # «Привыкший к общажной жизни»: вредная еда запоминается до конца хода.
            kris_register_junk_food(self, item_id)
            # «Запаха достаточно!» Арчи ур.8: шанс = магия получить 30% от
            # эффекта расходника союзника; аппетит Арчи не заполняется.
            if hasattr(store, "archie_on_consumable_used"):
                _fx = {}
                if hasattr(store, "get_consumable_item_effects_level1"):
                    _fx = store.get_consumable_item_effects_level1(item_id) or {}
                archie_on_consumable_used(self, item_id, _fx)
            return True

        def use_regular_consumable_teamwide(self, item_id):
            is_teamwide_food = hasattr(store, "consumable_has_all_picked_effects") and store.consumable_has_all_picked_effects(item_id)

            if is_teamwide_food:
                if hasattr(store, "get_feedable_party_targets") and not store.get_feedable_party_targets(self):
                    renpy.notify("Никто в команде больше не может есть сейчас.")
                    return False
            elif not self.can_be_fed():
                renpy.notify("[self.name] больше не может есть сейчас.")
                return False

            if hasattr(store, 'apply_consumable_all_effects'):
                used = store.apply_consumable_all_effects(self, item_id)
            else:
                heal_amount = store.consumable_effects.get(item_id, 0)
                self.current_hp = min(self.current_hp + heal_amount, self.max_hp)
                used = True

            if not used:
                return False

            if not is_teamwide_food:
                self.feed_character(1)
                push_feedness_item(self, item_id)
            # «Привыкший к общажной жизни»: вредная еда запоминается до конца хода.
            kris_register_junk_food(self, item_id)
            return True

        def use_consumable(self, item_id):
            if store.consumable_inventory.get(item_id, 0) <= 0:
                renpy.notify("Этого предмета нет в инвентаре.")
                return

            is_weapon_consumable = hasattr(store, "is_weapon_consumable_item") and store.is_weapon_consumable_item(item_id)
            item_display_name = getattr(store, "consumable_names", {}).get(item_id, item_id)

            if is_weapon_consumable:
                used = self.use_weapon_consumable(item_id, None)
            else:
                used = self.use_regular_consumable(item_id)

            if not used:
                return

            # Удаляем consumable из инвентаря
            store.consumable_inventory[item_id] = store.consumable_inventory.get(item_id, 0) - 1
            if store.consumable_inventory[item_id] <= 0:
                store.consumable_inventory.pop(item_id, None)

            if is_weapon_consumable:
                #renpy.notify("[self.name] использовал(а) [item_display_name].")
                return

            # Формируем сообщение об эффектах
            effects1 = store.get_consumable_item_effects_level1(item_id) if hasattr(store, 'get_consumable_item_effects_level1') else store.consumable_effects_level1.get(item_id, {})
            hp_heal = effects1.get("hp_heal", 0)
            mp_heal = effects1.get("mp_heal", 0)
            shield_heal = effects1.get("shield_heal", 0)

            message_parts = []
            if hp_heal != 0:
                message_parts.append(f"+{hp_heal} HP")
            if mp_heal != 0:
                message_parts.append(f"+{mp_heal} MP")
            if shield_heal != 0:
                message_parts.append(f"+{shield_heal} Щит")

            if message_parts:
                #renpy.notify("[self.name]: {', '.join(message_parts)}")
                pass
            else:
                #renpy.notify("[self.name] использовал(а) [item_display_name]!")
                pass


        def unequip_artifact(self, slot_index, instance_index=None):
            if slot_index < 0 or slot_index >= len(self.equipped_artifacts):
                return
            prev = self.equipped_artifacts[slot_index]
            if prev is None:
                return

            # Если указан конкретный экземпляр, снимаем именно его
            if instance_index is not None:
                if instance_index < 0 or instance_index >= len(store.artifact_instances):
                    return
                inst = store.artifact_instances[instance_index]
                if inst["id"] == prev and inst["owner"] == self.name:
                    inst["owner"] = None
            else:
                # Старое поведение: ищем экземпляр по типу и владельцу
                for inst in store.artifact_instances:
                    if inst["id"] == prev and inst["owner"] == self.name:
                        inst["owner"] = None
                        break

            # Удаляем артефакт из списка экипированных
            self.equipped_artifacts.pop(slot_index)
            self.recalc_artifactmod()
            notify_set_change(self, prev, False)

        def unequip_all_artifacts(self, notify=True):
            """Снимает все артефакты с персонажа."""
            removed_count = 0
            # Проходим по всем экипированным артефактам
            for artifact_id in list(self.equipped_artifacts):
                if artifact_id is not None:
                    # Ищем экземпляр этого артефакта и освобождаем владельца
                    for inst in store.artifact_instances:
                        if inst["id"] == artifact_id and inst["owner"] == self.name:
                            inst["owner"] = None
                            break
                    removed_count += 1

            # Очищаем список экипированных артефактов
            self.equipped_artifacts = []

            # Пересчитываем модификаторы
            self.recalc_artifactmod()

            if notify:
                if removed_count > 0:
                    renpy.notify(f"С {self.name} снято {removed_count} артефакт(ов)!")
                else:
                    renpy.notify(f"У {self.name} нет экипированных артефактов.")

        def identify_equipped_artifact(self, slot_index):
            """Опознать экипированный артефакт в указанном слоте. Возвращает True/False."""
            if slot_index < 0 or slot_index >= len(self.equipped_artifacts):
                return False

            artifact_id = self.equipped_artifacts[slot_index]
            if artifact_id is None:
                return False

            # Находим индекс экземпляра этого артефакта, принадлежащего текущему персонажу
            instance_index = None
            for i, inst in enumerate(store.artifact_instances):
                if inst["id"] == artifact_id and inst["owner"] == self.name:
                    instance_index = i
                    break

            if instance_index is None:
                return False

            # Проверяем, можно ли опознать этот артефакт
            if store.artifact_identifiable.get(artifact_id, 0) == 0:
                renpy.notify("Этот артефакт нельзя опознать.")
                return False

            # Проверяем, уже ли опознан артефакт
            if store.artifact_identified_state.get(instance_index, 0) == 1:
                renpy.notify("Этот артефакт уже опознан.")
                return False

            # Опознаём артефакт
            store.artifact_identified_state[instance_index] = 1

            # Получаем бонусы при опознании
            bonuses = store.artifact_identified_bonuses.get(artifact_id, {})
            bonus_modifiers = bonuses.get("modifiers", [])
            bonus_values = bonuses.get("values", [])

            # Добавляем бонусы к словарям модификаторов артефакта
            for i, mod_type in enumerate(bonus_modifiers):
                if i < len(bonus_values):
                    existing_mods = store.artifact_modifiers.get(artifact_id, [])
                    existing_values = store.artifact_modifier_values.get(artifact_id, [])

                    if mod_type not in existing_mods:
                        existing_mods.append(mod_type)
                        existing_values.append(bonus_values[i])
                    else:
                        idx = existing_mods.index(mod_type)
                        existing_values[idx] += bonus_values[i]

                    store.artifact_modifiers[artifact_id] = existing_mods
                    store.artifact_modifier_values[artifact_id] = existing_values

            # Пересчитываем модификаторы
            self.recalc_artifactmod()

            renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} опознан!")
            return True

        def wash_inventory_artifact(self, instance_index):
            """Стирка артефакта из инвентаря по индексу экземпляра. Возвращает True/False."""
            if instance_index < 0 or instance_index >= len(store.artifact_instances):
                return False

            inst = store.artifact_instances[instance_index]
            artifact_id = inst["id"]

            # Проверяем, экипирован ли артефакт
            if inst["owner"] is not None:
                renpy.notify("Нельзя стирать экипированный артефакт!")
                return False

            # Получаем тип стирки
            wash_type = store.artifact_wash_type.get(artifact_id, "nothing")

            if wash_type == "nothing":
                renpy.notify("При стирке ничего не происходит.")
                return True

            elif wash_type == "delete":
                # Заменяем артефакт на "trash" вместо удаления
                # Это предотвращает смещение индексов в слотах персонажей
                inst["id"] = "trash"
                inst["owner"] = None  # Освобождаем владельца

                # Уменьшаем счётчик оригинального типа артефакта
                if artifact_id in store.artifact_inventory:
                    store.artifact_inventory[artifact_id] -= 1
                    if store.artifact_inventory[artifact_id] <= 0:
                        store.artifact_inventory.pop(artifact_id, None)

                renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} уничтожен при стирке!")
                return True

            elif wash_type == "extra":
                # Получаем дополнительные характеристики
                extras = store.artifact_wash_extras.get(artifact_id, {})
                extra_modifiers = extras.get("modifiers", [])
                extra_values = extras.get("values", [])

                # Добавляем дополнительные модификаторы к артефакту
                for i, mod_type in enumerate(extra_modifiers):
                    if i < len(extra_values):
                        existing_mods = store.artifact_modifiers.get(artifact_id, [])
                        existing_values = store.artifact_modifier_values.get(artifact_id, [])

                        if mod_type not in existing_mods:
                            existing_mods.append(mod_type)
                            existing_values.append(extra_values[i])
                        else:
                            idx = existing_mods.index(mod_type)
                            existing_values[idx] += extra_values[i]

                        store.artifact_modifiers[artifact_id] = existing_mods
                        store.artifact_modifier_values[artifact_id] = existing_values

                # Пересчитываем модификаторы для владельца артефакта (если есть)
                if inst["owner"] and inst["owner"] in store.pers_dict:
                    char = store.pers_dict[inst["owner"]]
                    char.recalc_artifactmod()

                renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} изменился при стирке!")
                return True

            return False


    def add_item(item_id, amount=1):
        """Добавить предмет(ы) в инвентарь."""
        for _ in range(int(amount)):
            store.artifact_instances.append({"id": item_id, "owner": None})
        store.artifact_inventory[item_id] = store.artifact_inventory.get(item_id, 0) + int(amount)

    def remove_item(item_id, amount=1):
        """Убрать предмет(ы) из инвентаря. Возвращает True/False."""
        if store.artifact_inventory.get(item_id, 0) < int(amount):
            return False
        store.artifact_inventory[item_id] -= int(amount)
        if store.artifact_inventory[item_id] <= 0:
            store.artifact_inventory.pop(item_id, None)
        # Удаляем экземпляры из списка
        removed_count = 0
        for i in range(len(store.artifact_instances) - 1, -1, -1):
            if store.artifact_instances[i]["id"] == item_id and store.artifact_instances[i]["owner"] is None:
                del store.artifact_instances[i]
                removed_count += 1
                if removed_count >= int(amount):
                    break
        return True

    def add_consumable(item_id, amount=1):
        """Добавить consumable(s) в инвентарь."""
        store.consumable_inventory[item_id] = store.consumable_inventory.get(item_id, 0) + int(amount)

    def remove_consumable(item_id, amount=1):
        """Убрать consumable(s) из инвентаря. Возвращает True/False."""
        if store.consumable_inventory.get(item_id, 0) < int(amount):
            return False
        store.consumable_inventory[item_id] -= int(amount)
        if store.consumable_inventory[item_id] <= 0:
            store.consumable_inventory.pop(item_id, None)
        return True

    def identify_artifact(instance_index):
        """Опознать артефакт по индексу экземпляра. Возвращает True/False."""
        if instance_index < 0 or instance_index >= len(store.artifact_instances):
            return False

        inst = store.artifact_instances[instance_index]
        artifact_id = inst["id"]

        # Проверяем, можно ли опознать этот артефакт
        if store.artifact_identifiable.get(artifact_id, 0) == 0:
            renpy.notify("Этот артефакт нельзя опознать.")
            return False

        # Проверяем, уже ли опознан артефакт
        if store.artifact_identified_state.get(instance_index, 0) == 1:
            renpy.notify("Этот артефакт уже опознан.")
            return False

        # Проверяем шанс опознания
        identify_chance = store.artifact_identify_chance.get(artifact_id, 100)
        if renpy.random.randint(1, 100) > identify_chance:
            renpy.notify(f"Опознание не удалось! Шанс был {identify_chance}%")
            return False

        # Опознаём артефакт
        store.artifact_identified_state[instance_index] = 1

        # Получаем бонусы при опознании
        bonuses = store.artifact_identified_bonuses.get(artifact_id, {})
        bonus_modifiers = bonuses.get("modifiers", [])
        bonus_values = bonuses.get("values", [])

        # Добавляем бонусы к словарям модификаторов артефакта
        for i, mod_type in enumerate(bonus_modifiers):
            if i < len(bonus_values):
                # Добавляем модификатор к существующим
                existing_mods = store.artifact_modifiers.get(artifact_id, [])
                existing_values = store.artifact_modifier_values.get(artifact_id, [])

                if mod_type not in existing_mods:
                    existing_mods.append(mod_type)
                    existing_values.append(bonus_values[i])
                else:
                    # Если модификатор уже есть, увеличиваем значение
                    idx = existing_mods.index(mod_type)
                    existing_values[idx] += bonus_values[i]

                store.artifact_modifiers[artifact_id] = existing_mods
                store.artifact_modifier_values[artifact_id] = existing_values

        # Пересчитываем модификаторы для владельца артефакта
        if inst["owner"] and inst["owner"] in store.pers_dict:
            char = store.pers_dict[inst["owner"]]
            char.recalc_artifactmod()

        renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} опознан!")
        return True

    def identify_artifact_from_slot():
        """Обёртка для опознания артефакта из слота identify_slot."""
        if store.identify_slot is None:
            renpy.notify("Слот опознания пуст.")
            store.is_checking = "fail"
            return

        # Проверяем, достаточно ли денег
        inst = store.artifact_instances[store.identify_slot]
        artifact_id = inst["id"]
        cost = store.artifact_identify_cost.get(artifact_id, 0)
        if store.money < cost:
            renpy.notify(f"Недостаточно денег! Требуется {cost} золота.")
            store.is_checking = "fail"
            return

        # Списываем деньги
        store.money -= cost

        # Вызываем существующую функцию опознания
        result = identify_artifact(store.identify_slot)

        if result:
            store.is_checking = "success"
        else:
            store.is_checking = "fail"

    def wash_artifacts_from_slots():
        """Стирка всех артефактов из слотов wash_slots."""
        # Защита от двойного завершения: теперь завершение может вызываться
        # и из per-frame callback, и из экранных таймеров.
        if not store.wash_in_progress:
            return
        if store.is_washing != "is_washing":
            return
        if not store.wash_slots:
            renpy.notify("Слоты стирки пусты.")
            store.is_washing = "fail"
            return

        # Сортируем индексы в обратном порядке для безопасной обработки
        for inst_idx in sorted(store.wash_slots, reverse=True):
            # Проверяем, что индекс всё ещё валиден
            if inst_idx < len(store.artifact_instances):
                inst = store.artifact_instances[inst_idx]
                artifact_id = inst["id"]

                # Проверяем, экипирован ли артефакт
                if inst["owner"] is not None:
                    renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} пропущен - он экипирован!")
                    continue

                # Получаем тип стирки
                wash_type = store.artifact_wash_type.get(artifact_id, "nothing")

                # Сам факт успешной стирки нужно сохранять независимо от её эффекта.
                # Иначе предметы с типом "nothing" после стирки снова попадают в
                # инвентарь wash_screen и отображаются как непостиранные.
                store.artifact_wash_state[inst_idx] = 2

                if wash_type == "delete":
                    # Помечаем артефакт как постиранный (get_washed = 2)
                    store.artifact_wash_state[inst_idx] = 2
                    # Заменяем артефакт на "trash" вместо удаления
                    # Это предотвращает смещение индексов в слотах персонажей
                    inst["id"] = "trash"
                    inst["owner"] = None  # Освобождаем владельца

                    # Уменьшаем счётчик оригинального типа артефакта
                    if artifact_id in store.artifact_inventory:
                        store.artifact_inventory[artifact_id] -= 1
                        if store.artifact_inventory[artifact_id] <= 0:
                            store.artifact_inventory.pop(artifact_id, None)

                    renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} уничтожен при стирке!")

                elif wash_type == "extra":
                    # Особая логика для грязного носка Санса (art13 -> art14)
                    if artifact_id == "art13":
                        # Превращаем грязный носок в чистый
                        old_name = store.artifact_names.get(artifact_id, artifact_id)
                        inst["id"] = "art14"
                        new_name = store.artifact_names.get("art14", "art14")
                        
                        # Обновляем инвентарь: уменьшаем счётчик art13, увеличиваем art14
                        if artifact_id in store.artifact_inventory:
                            store.artifact_inventory[artifact_id] -= 1
                            if store.artifact_inventory[artifact_id] <= 0:
                                store.artifact_inventory.pop(artifact_id, None)
                        store.artifact_inventory["art14"] = store.artifact_inventory.get("art14", 0) + 1
                        
                        # Пересчитываем модификаторы для владельца артефакта (если есть)
                        if inst["owner"] and inst["owner"] in store.pers_dict:
                            char = store.pers_dict[inst["owner"]]
                            char.recalc_artifactmod()
                        
                        # Помечаем артефакт как постиранный (get_washed = 2)
                        store.artifact_wash_state[inst_idx] = 2
                        
                        renpy.notify(f"Артефакт {old_name} превратился в {new_name}!")
                    else:
                        # Получаем дополнительные характеристики
                        extras = store.artifact_wash_extras.get(artifact_id, {})
                        extra_modifiers = extras.get("modifiers", [])
                        extra_values = extras.get("values", [])

                        # Добавляем дополнительные модификаторы к артефакту
                        for i, mod_type in enumerate(extra_modifiers):
                            if i < len(extra_values):
                                existing_mods = store.artifact_modifiers.get(artifact_id, [])
                                existing_values = store.artifact_modifier_values.get(artifact_id, [])

                                if mod_type not in existing_mods:
                                    existing_mods.append(mod_type)
                                    existing_values.append(extra_values[i])
                                else:
                                    # Если модификатор уже есть, увеличиваем значение
                                    idx = existing_mods.index(mod_type)
                                    existing_values[idx] += extra_values[i]

                                store.artifact_modifiers[artifact_id] = existing_mods
                                store.artifact_modifier_values[artifact_id] = existing_values

                        # Пересчитываем модификаторы для владельца артефакта (если есть)
                        if inst["owner"] and inst["owner"] in store.pers_dict:
                            char = store.pers_dict[inst["owner"]]
                            char.recalc_artifactmod()

                        # Помечаем артефакт как постиранный (get_washed = 2)
                        store.artifact_wash_state[inst_idx] = 2

                        renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} изменился при стирке!")

        # НЕ очищаем слоты стирки автоматически - предметы остаются в слотах
        # store.wash_slots = []  # Убрано для ручного возврата через кнопку
        # Стирка завершена - шкала должна быть полной
        store.wash_timer_elapsed = store.wash_timer_total

        store.is_washing = "success"
        store.wash_in_progress = False
        store.wash_slots_locked = False

    def retrieve_washed_artifacts():
        """Возврат всех артефактов из слотов стирки в инвентарь."""
        if not store.wash_slots:
            renpy.notify("Слоты стирки пусты.")
            return

        # Проходим по всем слотам стирки
        for inst_idx in list(store.wash_slots):
            # Проверяем, что индекс всё ещё валиден
            if inst_idx < len(store.artifact_instances):
                inst = store.artifact_instances[inst_idx]
                artifact_id = inst["id"]

                # Проверяем, есть ли сохраненный владелец
                if inst_idx in store.wash_slot_owners:
                    owner_name = store.wash_slot_owners[inst_idx]

                    # Если владелец существует, экипируем артефакт обратно
                    if owner_name in store.pers_dict:
                        char = store.pers_dict[owner_name]

                        # Экипируем артефакт на исходного владельца
                        char.equip_artifact(artifact_id, inst_idx)
                        renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} возвращён на {owner_name}!")

                    # Удаляем запись из словаря владельцев
                    del store.wash_slot_owners[inst_idx]
                else:
                    # Если владельца нет, артефакт просто остаётся в инвентаре
                    renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} возвращён в инвентарь!")

        # Очищаем слоты стирки
        store.wash_slots = []
        # Сбрасываем состояние стирки, чтобы кнопка изменилась обратно на "НАЧАТЬ СТИРКУ"
        store.is_washing = None
        renpy.restart_interaction()

    def reset_wash_progress():
        """Отдельная функция сброса визуального состояния стирки.
        Обнуляет прогресс и статус, НО не трогает wash_slots (предметы остаются)."""
        store.wash_timer_elapsed = 0.0
        store.is_washing = None
        store.wash_in_progress = False
        store.wash_slots_locked = False

    def is_artifact_in_wash_slot(instance_index):
        """Проверка, находится ли экземпляр артефакта в слотах стирки."""
        return instance_index in store.wash_slots

    def wash_artifact(instance_index):
        """Стирка артефакта по индексу экземпляра. Возвращает True/False."""
        if instance_index < 0 or instance_index >= len(store.artifact_instances):
            return False

        inst = store.artifact_instances[instance_index]
        artifact_id = inst["id"]

        # Проверяем, экипирован ли артефакт
        if inst["owner"] is not None:
            renpy.notify("Нельзя стирать экипированный артефакт!")
            return False

        # Получаем тип стирки
        wash_type = store.artifact_wash_type.get(artifact_id, "nothing")

        if wash_type == "nothing":
            renpy.notify("При стирке ничего не происходит.")
            return True

        elif wash_type == "delete":
            # Удаляем артефакт из инвентаря
            del store.artifact_instances[instance_index]
            if artifact_id in store.artifact_inventory:
                store.artifact_inventory[artifact_id] -= 1
                if store.artifact_inventory[artifact_id] <= 0:
                    store.artifact_inventory.pop(artifact_id, None)
            renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} уничтожен при стирке!")
            return True

        elif wash_type == "extra":
            # Особая логика для грязного носка Санса (art13 -> art14)
            if artifact_id == "art13":
                # Превращаем грязный носок в чистый
                old_name = store.artifact_names.get(artifact_id, artifact_id)
                inst["id"] = "art14"
                new_name = store.artifact_names.get("art14", "art14")
                
                # Обновляем инвентарь: уменьшаем счётчик art13, увеличиваем art14
                if artifact_id in store.artifact_inventory:
                    store.artifact_inventory[artifact_id] -= 1
                    if store.artifact_inventory[artifact_id] <= 0:
                        store.artifact_inventory.pop(artifact_id, None)
                store.artifact_inventory["art14"] = store.artifact_inventory.get("art14", 0) + 1
                
                # Пересчитываем модификаторы для владельца артефакта (если есть)
                if inst["owner"] and inst["owner"] in store.pers_dict:
                    char = store.pers_dict[inst["owner"]]
                    char.recalc_artifactmod()
                
                renpy.notify(f"Артефакт {old_name} превратился в {new_name}!")
            else:
                # Получаем дополнительные характеристики
                extras = store.artifact_wash_extras.get(artifact_id, {})
                extra_modifiers = extras.get("modifiers", [])
                extra_values = extras.get("values", [])

                # Добавляем дополнительные модификаторы к артефакту
                for i, mod_type in enumerate(extra_modifiers):
                    if i < len(extra_values):
                        existing_mods = store.artifact_modifiers.get(artifact_id, [])
                        existing_values = store.artifact_modifier_values.get(artifact_id, [])

                        if mod_type not in existing_mods:
                            existing_mods.append(mod_type)
                            existing_values.append(extra_values[i])
                        else:
                            # Если модификатор уже есть, увеличиваем значение
                            idx = existing_mods.index(mod_type)
                            existing_values[idx] += extra_values[i]

                        store.artifact_modifiers[artifact_id] = existing_mods
                        store.artifact_modifier_values[artifact_id] = existing_values

                # Пересчитываем модификаторы для владельца артефакта (если есть)
                if inst["owner"] and inst["owner"] in store.pers_dict:
                    char = store.pers_dict[inst["owner"]]
                    char.recalc_artifactmod()

                renpy.notify(f"Артефакт {store.artifact_names.get(artifact_id, artifact_id)} изменился при стирке!")
            return True

        return False

    def get_artifact_identified_status(instance_index):
        """Возвращает статус опознания артефакта (0 - не опознан, 1 - опознан)."""
        return store.artifact_identified_state.get(instance_index, 0)

    def get_artifact_wash_type(artifact_id):
        """Возвращает тип стирки артефакта."""
        return store.artifact_wash_type.get(artifact_id, "nothing")

    def sell_artifact(instance_index):
        """Продать артефакт по индексу экземпляра. Возвращает True/False."""
        if instance_index < 0 or instance_index >= len(store.artifact_instances):
            return False

        inst = store.artifact_instances[instance_index]

        # Проверяем, что артефакт не экипирован
        if inst["owner"] is not None:
            renpy.notify("Нельзя продать экипированный артефакт!")
            return False

        artifact_id = inst["id"]

        # Проверяем, не является ли артефакт "мусором"
        if artifact_id == "trash":
            renpy.notify("Нельзя продать мусор!")
            return False

        price = store.artifact_prices.get(artifact_id, 0)

        # Добавляем деньги
        store.money += price

        # Заменяем артефакт на "trash" вместо удаления
        # Это предотвращает смещение индексов
        inst["id"] = "trash"
        inst["owner"] = None

        # Уменьшаем счётчик оригинального типа артефакта
        if artifact_id in store.artifact_inventory:
            store.artifact_inventory[artifact_id] -= 1
            if store.artifact_inventory[artifact_id] <= 0:
                store.artifact_inventory.pop(artifact_id, None)

        renpy.notify("Продано [store.artifact_names.get(artifact_id, artifact_id)] за [price] золота!")
        return True

    def add_to_player_selling(instance_index):
        """Добавить артефакт игрока в список на продажу."""
        if instance_index < 0 or instance_index >= len(store.artifact_instances):
            return False
        inst = store.artifact_instances[instance_index]
        if inst["owner"] is not None:
            renpy.notify("Нельзя продать экипированный артефакт!")
            return False
        if instance_index not in store.player_selling:
            store.player_selling.append(instance_index)
        return True

    def remove_from_player_selling(instance_index):
        """Убрать артефакт игрока из списка на продажу."""
        if instance_index in store.player_selling:
            store.player_selling.remove(instance_index)
        return True

    def add_to_merchant_selling(merchant_index):
        """Добавить артефакт торговца в список на покупку."""
        if merchant_index < 0 or merchant_index >= len(store.merchant_inventory):
            return False
        if merchant_index not in store.merchant_selling:
            store.merchant_selling.append(merchant_index)
        return True

    def remove_from_merchant_selling(merchant_index):
        """Убрать артефакт торговца из списка на покупку."""
        if merchant_index in store.merchant_selling:
            store.merchant_selling.remove(merchant_index)
        return True
    
    def get_artifact_merchant_relation_bonus():
        """Бонус к отношению торговцев от носимых артефактов.

        Каждая книга «Искусство переговоров» (art33), надетая любым персонажем,
        даёт +2, а «Краткий экскурс в торговлю» (art32) — +9.
        Дипломатия на торговлю не влияет.
        """
        bonus = 0
        pers_dict = getattr(store, "pers_dict", None) or {}
        for char in pers_dict.values():
            equipped = getattr(char, "equipped_artifacts", []) or []
            for aid in equipped:
                if aid is None:
                    continue
                if aid == "art32":
                    bonus += 9
                elif aid == "art33":
                    bonus += 2
        return bonus

    def get_total_relation(merchant_id=None):
        """Получить итоговое отношение торговца с учётом бонуса и индивидуального значения."""
        if hasattr(store, "cleanup_merchant_relation_timers"):
            store.cleanup_merchant_relation_timers()
        if merchant_id is None:
            merchant_id = store.current_merchant_id
        merchant = store.merchants_data.get(merchant_id, {})
        base_relation = merchant.get("relation", 0)
        personal_relation = store.merchants_personal_relation.get(merchant_id, 0)
        total = base_relation + store.merchant_relation_bonus + personal_relation + store.get_artifact_merchant_relation_bonus()
        return max(-25, min(25, total))

    def get_player_sell_price(base_price):
        """Рассчитать цену продажи артефакта игроком (с учётом отношения и множителя 0.5)."""
        relation = store.get_total_relation()
        # Множитель: 0.5 * (1 + отношение/100)
        # Если отношение = -25, то множитель = 0.5 * (1 - 0.25) = 0.5 * 0.75 = 0.375
        # Если отношение = 25, то множитель = 0.5 * (1 + 0.25) = 0.5 * 1.25 = 0.625
        multiplier = 0.5 * (1 + relation / 100.0)
        return int(base_price * multiplier)

    def get_merchant_sell_price(base_price):
        """Рассчитать цену покупки артефакта у торговца (с учётом отношения)."""
        relation = store.get_total_relation()
        # Множитель: 1 - отношение/100
        # Если отношение = -25, то множитель = 1 - (-0.25) = 1.25 (дороже)
        # Если отношение = 25, то множитель = 1 - 0.25 = 0.75 (дешевле)
        multiplier = 1 - relation / 100.0
        return int(base_price * multiplier)

    def calculate_trade_cost():
        """Рассчитать стоимость сделки с учётом отношений."""
        # Стоимость артефактов игрока (продажа) с учётом отношения и множителя 0.5
        player_cost = 0
        for idx in store.player_selling:
            if idx < len(store.artifact_instances):
                artifact_id = store.artifact_instances[idx]["id"]
                base_price = store.artifact_prices.get(artifact_id, 0)
                player_cost += get_player_sell_price(base_price)

        # Стоимость consumables игрока (продажа) с учётом отношения и множителя 0.5
        for item_id in store.player_selling_consumables:
            base_price = store.get_scaled_consumable_price(item_id) if hasattr(store, "get_scaled_consumable_price") else store.consumable_prices.get(item_id, 0)
            player_cost += get_player_sell_price(base_price)

        # Стоимость артефактов торговца (покупка) с учётом отношения
        merchant_cost = 0
        for idx in store.merchant_selling:
            if idx < len(store.merchant_inventory):
                base_price = store.merchant_inventory[idx]["price"]
                merchant_cost += get_merchant_sell_price(base_price)

        # Стоимость consumables торговца (покупка) с учётом отношения
        for item_id in store.merchant_selling_consumables:
            base_price = store.get_scaled_consumable_price(item_id) if hasattr(store, "get_scaled_consumable_price") else store.consumable_prices.get(item_id, 0)
            merchant_cost += get_merchant_sell_price(base_price)

        return merchant_cost - player_cost  # Положительное = игрок платит, отрицательное = игрок получает

    def confirm_trade():
        """Подтвердить сделку с учётом отношений."""
        trade_cost = calculate_trade_cost()

        # Проверяем, хватает ли денег
        if trade_cost > store.money:
            # Ухудшаем отношение торговца на 0.5
            current_personal = store.merchants_personal_relation.get(store.current_merchant_id, 0)
            new_personal = max(-25, min(25, current_personal - 0.5))
            store.merchants_personal_relation[store.current_merchant_id] = new_personal
            renpy.notify(f"Недостаточно денег! Отношение торговца ухудшилось до {store.get_total_relation()}%")
            # Не закрываем экран торговли, возвращаем False
            return False

        # Выполняем сделку
        # Удаляем проданные артефакты игрока (с учётом множителя 0.5 и отношения)
        # И добавляем их в инвентарь торговца
        for idx in sorted(store.player_selling, reverse=True):
            artifact_id = store.artifact_instances[idx]["id"]
            base_price = store.artifact_prices.get(artifact_id, 0)
            price = get_player_sell_price(base_price)
            store.money += price

            # Добавляем артефакт в инвентарь торговца
            store.merchant_inventory.append({"id": artifact_id, "price": base_price})

            del store.artifact_instances[idx]
            if artifact_id in store.artifact_inventory:
                store.artifact_inventory[artifact_id] -= 1
                if store.artifact_inventory[artifact_id] <= 0:
                    store.artifact_inventory.pop(artifact_id, None)

        # Удаляем проданные consumables игрока (с учётом множителя 0.5 и отношения)
        # И добавляем их в инвентарь торговца
        for item_id in store.player_selling_consumables:
            base_price = store.get_scaled_consumable_price(item_id) if hasattr(store, "get_scaled_consumable_price") else store.consumable_prices.get(item_id, 0)
            price = get_player_sell_price(base_price)
            store.money += price

            # Добавляем consumable в инвентарь торговца
            store.merchant_consumables_inventory.append({"id": item_id, "price": base_price})

            store.consumable_inventory[item_id] -= 1
            if store.consumable_inventory[item_id] <= 0:
                store.consumable_inventory.pop(item_id, None)

        # Добавляем купленные артефакты (с учётом отношения)
        for idx in sorted(store.merchant_selling, reverse=True):
            item = store.merchant_inventory[idx]
            base_price = item["price"]
            price = get_merchant_sell_price(base_price)
            store.money -= price
            store.artifact_instances.append({"id": item["id"], "owner": None})
            store.artifact_inventory[item["id"]] = store.artifact_inventory.get(item["id"], 0) + 1
            del store.merchant_inventory[idx]

        # Добавляем купленные consumables (с учётом отношения)
        for item_id in store.merchant_selling_consumables:
            base_price = store.get_scaled_consumable_price(item_id) if hasattr(store, "get_scaled_consumable_price") else store.consumable_prices.get(item_id, 0)
            price = get_merchant_sell_price(base_price)
            store.money -= price
            store.consumable_inventory[item_id] = store.consumable_inventory.get(item_id, 0) + 1

            # Удаляем один экземпляр этого расходника у торговца
            for merch_idx, merch_item in enumerate(store.merchant_consumables_inventory):
                if merch_item.get("id") == item_id:
                    del store.merchant_consumables_inventory[merch_idx]
                    break

        # Очищаем списки
        store.player_selling = []
        store.player_selling_consumables = []
        store.merchant_selling = []
        store.merchant_selling_consumables = []

        renpy.notify("Сделка завершена!")
        return True

    def get_selected_consumable_count(item_id, source="player"):
        """Вернуть, сколько экземпляров расходника уже выбрано в сделке."""
        if source == "merchant":
            return store.merchant_selling_consumables.count(item_id)
        return store.player_selling_consumables.count(item_id)

    def get_merchant_consumables_stacks():
        """Собрать стакнутый список расходников торговца.
        Возвращает список словарей: {"id": item_id, "count": n, "price": base_price}.
        """
        stacks = {}
        order = []
        for item in store.merchant_consumables_inventory:
            item_id = item.get("id")
            if item_id is None:
                continue
            if item_id not in stacks:
                stacks[item_id] = {
                    "id": item_id,
                    "count": 0,
                    "price": item.get("price", store.get_scaled_consumable_price(item_id) if hasattr(store, "get_scaled_consumable_price") else store.consumable_prices.get(item_id, 0))
                }
                order.append(item_id)
            stacks[item_id]["count"] += 1
        return [stacks[item_id] for item_id in order]

    def init_merchant():
        """Инициализация инвентаря торговца на основе current_merchant_id.

        Использует ПЕРСИСТЕНТНЫЙ инвентарь торговца:
        - первый заход: current_inventory копируется из шаблона inventory;
        - последующие заходы: берётся уже накопленный current_inventory
        (в нём лежит всё, что игрок продал этому торговцу, минус купленное).
        """
        merchant = store.merchants_data.get(store.current_merchant_id, {})
        store.merchant_name = merchant.get("name", "Торговец")

        # Ленивая инициализация персистентного инвентаря
        if "current_inventory" not in merchant or merchant["current_inventory"] is None:
            merchant["current_inventory"] = list(merchant.get("inventory", []))
        if "current_consumables_inventory" not in merchant or merchant["current_consumables_inventory"] is None:
            merchant["current_consumables_inventory"] = list(merchant.get("consumables_inventory", []))

        # ССЫЛКА, а не копия — иначе append/del не попадут в merchants_data
        store.merchant_inventory = merchant["current_inventory"]
        store.merchant_consumables_inventory = merchant["current_consumables_inventory"]

        # Индексы "на покупку" невалидны после смены торговца — чистим
        store.merchant_selling = []
        store.merchant_selling_consumables = []

        store.player_shop_tab = "artifacts"
        store.merchant_shop_tab = "artifacts"

    def init_char(char_id, name, hp=100):
        """Минимальная инициализация персонажа под артефакты."""
        p = store.Pers(name)        # <-- подстрой под свой конструктор Pers(...)
        p.current_hp = hp           # можно удалить, если current_hp не используется

        # --- артефакты ---
        p.artifactmod = 0
        p.atkartifactmod = 0      # Модификатор атаки от артефактов
        p.defartifactmod = 0     # Модификатор защиты от артефактов
        p.maxhpartifactmod = 0    # Модификатор максимального HP от артефактов
        p.maxmpartifactmod = 0     # Модификатор максимальной маны от артефактов
        p.hpregenartifactmod = 0  # Модификатор регенерации HP от артефактов
        p.mpregenartifactmod = 0  # Модификатор регенерации маны от артефактов
        p.mp_cost_multiplier = 1.0
        p.mpcostartifactmod = 0.0
        p.magicartifactmod = 0    # Модификатор магии от артефактов
        p.accuracyartifactmod = 0 # Модификатор точности (шанса попадания) от артефактов
        p.critrateartifactmod = 0 # Модификатор шанса крита от артефактов
        p.critdmgartifactmod = 0  # Модификатор критического урона от артефактов
        p.equipped_artifacts = []  # Динамический список экипированных артефактов

        # --- методы внутри объекта (если их НЕТ в классе Pers, можно оставить так)
        # Лучше: перенести методы в сам class Pers. Но этот блок позволяет работать сразу.

        def recalc_artifactmod(self):
            # Сбрасываем все модификаторы
            self.atkartifactmod = 0
            self.defartifactmod = 0
            self.maxhpartifactmod = 0
            self.maxmpartifactmod = 0
            self.hpregenartifactmod = 0
            self.mpregenartifactmod = 0
            self.mpcostartifactmod = 0.0
            self.magicartifactmod = 0
            self.accuracyartifactmod = 0
            self.critrateartifactmod = 0
            self.critdmgartifactmod = 0
            # Сбрасываем новые модификаторы
            self.socializationartifactmod = 0
            self.diplomacyartifactmod = 0
            self.charmartifactmod = 0
            self.perceptionartifactmod = 0
            self.rhetoricartifactmod = 0
            self.artistryartifactmod = 0
            self.comfortartifactmod = 0
            self.powerartifactmod = 0
            self.bonus_tank = 0

            # Считаем модификаторы для каждого экипированного артефакта
            for artifact_id in self.equipped_artifacts:
                if artifact_id is not None:
                    modifier_types = store.artifact_modifiers.get(artifact_id, [])
                    modifier_values = store.artifact_modifier_values.get(artifact_id, [])

                    # Социальные модификаторы
                    social_modifiers = store.artifact_social_modifiers.get(artifact_id, [])
                    social_values = store.artifact_social_modifier_values.get(artifact_id, [])

                    # Проходим по всем боевым модификаторам артефакта
                    for i, modifier_type in enumerate(modifier_types):
                        if i < len(modifier_values):
                            modifier_value = modifier_values[i]

                            if modifier_type == "atkartifactmod":
                                self.atkartifactmod += modifier_value
                            elif modifier_type == "defartifactmod":
                                self.defartifactmod += modifier_value
                            elif modifier_type == "maxhpartifactmod":
                                self.maxhpartifactmod += modifier_value
                            elif modifier_type == "maxmpartifactmod":
                                self.maxmpartifactmod += modifier_value
                            elif modifier_type == "hpregenartifactmod":
                                self.hpregenartifactmod += modifier_value
                            elif modifier_type == "mpregenartifactmod":
                                self.mpregenartifactmod += modifier_value
                            elif modifier_type == "mpcostartifactmod":
                                self.mpcostartifactmod += modifier_value
                            elif modifier_type == "magicartifactmod":
                                self.magicartifactmod += modifier_value
                            elif modifier_type == "accuracyartifactmod":
                                self.accuracyartifactmod += modifier_value
                            elif modifier_type == "critrateartifactmod":
                                self.critrateartifactmod += modifier_value
                            elif modifier_type == "critdmgartifactmod":
                                self.critdmgartifactmod += modifier_value
                            elif modifier_type == "perceptionartifactmod":
