        #функция для расчёта итоговых значений героя и врага при переговорах
        def try_to_nego(self, enemy):
            """Проверка социального действия героя против цели."""
            store.dip_multiply = 1

            if enemy is None or not isinstance(getattr(store, "attackindex", None), str) or store.attackindex not in store.ACTS_CONFIG:
                store.nego_difficulty = 0
                store.nego_total_score = 0
                return False

            act_cfg = store.ACTS_CONFIG[store.attackindex]
            stat_key = act_cfg["check"]
            use_social = act_cfg["social"]

            store.nego_selected_stat_name = store.ACT_STAT_RU.get(stat_key, stat_key)
            store.nego_selected_stat_value = int(getattr(self, stat_key, 0))
            store.nego_social_value = int(self.socialization if use_social else 0)
            store.nego_charm_value = int(self.charm)

            karma_bonus = int(getattr(enemy, "sans_karma", 0) or 0) if self.name == "Санс" else 0
            hero_score = int(store.base_nego_perform) + store.nego_selected_stat_value + store.nego_social_value + karma_bonus

            if hasattr(enemy, "base_difficulty"):
                mood = getattr(enemy, "mood", "neutral")
                diff_mods = getattr(enemy, f"{stat_key}_difficulty_mod", {})
                store.nego_difficulty = int(enemy.base_difficulty + diff_mods.get(mood, 0) - getattr(enemy, "noelle_frost_social_penalty", 0))
            else:
                store.nego_difficulty = int(getattr(self, "base_difficulty", 10))

            store.nego_total_score = hero_score
            # По дизайн-документу проверка успешна только при строгом превышении.
            success = hero_score > store.nego_difficulty
            if getattr(enemy, "name", None) == "Арчи":
                store.nego_difficulty = store.archie_difficulty(enemy, store.attackindex) + int(getattr(enemy, "dc_offset", 0))
                success = hero_score > store.nego_difficulty

            if success and renpy.random.random() <= min(1, self.charm / 100.0):
                store.dip_multiply = 2

            return success



        # Методы расчета урона
        def calculate_dmg(self, enemy, apply_shield=True): #######################
            # Проверка на попадание
            hit_prob = min(self.dmgchance, 1.0)


            renpy.log(f"=== НАЧАЛО РАСЧЕТА УРОНА ===")
            renpy.log(f"Атакующий: {self.name}, Цель: {enemy.name}")
            renpy.log(f"Шанс попадания: {hit_prob} (dmgchance: {self.dmgchance})")


            if random.random() > hit_prob:
                self.popal = 0
                if getattr(enemy, "name", None) == "Арчи" and "archie_mark_enemy_miss" in globals():
                    archie_mark_enemy_miss(enemy)
                store.dmg = 0  # Сохраняем в глобальную переменную
                enemy.damage_gain_for_vis = 0  # Промах
                enemy.got_crit_for_visual = 0
                store.clear_swoon_pending_for_visual(enemy)
                result = 0

                renpy.log("ПРОМАХ! popal установлен в 0")
                return result  # Промах
            else:
                self.popal = 1


                renpy.log("ПОПАДАНИЕ! popal установлен в 1")

                # Определение критического удара
                critrate_value = self.critrate  # Используем свойство для получения значения
                store.is_crit = random.random() < critrate_value
                renpy.log(f"Критический удар: {store.is_crit} (critrate: {critrate_value})")

                next_attack_multiplier = max(0.0, self.next_attack_multiplier)

                # Расчет базового урона
                if store.is_crit:
                    base_dmg = (self.atk * self.crit * self.perform * store.atk_ind_ratio - enemy.armor) * self.popal


                    renpy.log(f"Расчет КРИТИЧЕСКОГО урона: ({self.atk} * {self.crit} * {self.perform} * {store.atk_ind_ratio} - {enemy.armor}) * {self.popal}")
                else:
                    base_dmg = (self.atk * self.perform * store.atk_ind_ratio - enemy.armor) * self.popal


                    renpy.log(f"Расчет ОБЫЧНОГО урона: {self.atk} * {self.perform} * {store.atk_ind_ratio} - {enemy.armor} * {self.popal}")

                
                if next_attack_multiplier != 1.0:
                    base_dmg *= next_attack_multiplier
                    self.next_attack_multiplier = 1.0

                # «Крылья птицы» (танец Сильвии «Синяя птица»): пока бафф
                # активен, атаки команды наносят дополнительно 50% урона
                # от магии персонажа. Стак расходуется в sylvia_tick_team_effects().
                _sylvia_wings_add = 0
                if "sylvia_wings_bonus" in globals():
                    _sylvia_wings_add = sylvia_wings_bonus(self)
                    if _sylvia_wings_add:
                        base_dmg += _sylvia_wings_add


                renpy.log(f"Базовый урон до штрафов: {base_dmg}")

                # Применение прогрессивных штрафов
                final_dmg = self.calculate_progressive(base_dmg, self.DAMAGE_THRESHOLDS)


                renpy.log(f"Финальный урон после штрафов: {final_dmg}")

                result = int(max(min(final_dmg, 600), 10))
                store.dmg = result  # Сохраняем в глобальную переменную

                # Обработка щитов врага
                if hasattr(enemy, 'shield') and enemy.shield > 0:
                    # Уменьшаем количество щитов врага
                    enemy.shield -= 1
                    # Урон не применяется, но визуализация показывается
                    enemy.damage_gain_for_vis = 1
                    enemy.got_crit_for_visual = 0  # При поглощении щитом крит не отображается
                    store.clear_swoon_pending_for_visual(enemy)
                    renpy.notify("Урон поглощен щитом!")
                    return 1

                else:
                    # Применение урона к врагу
                    old_hp = enemy.current_hp
                    enemy.current_hp = max(0, enemy.current_hp - result)
                    applied_result = max(0, old_hp - enemy.current_hp)
                    store.update_swoon_pending_for_visual(enemy, old_hp)

                    # Обновление переменных цели для визуализации
                    if self.popal == 1 and applied_result >= 1:
                        enemy.damage_gain_for_vis = applied_result  # Сохраняем фактически прошедший урон
                    else:
                        enemy.damage_gain_for_vis = 0  # Промах или нулевой урон
                        store.clear_swoon_pending_for_visual(enemy)

                    if store.is_crit:
                        enemy.got_crit_for_visual = 1  # Критический удар
                    else:
                        enemy.got_crit_for_visual = 0  # Обычное попадание

                    #renpy.notify(f"Итоговый урон: {result}")


                    return applied_result

        def calculate_dmg_from_def(self, enemy):
            """Рассчитывает физический урон, используя итоговую защиту персонажа."""
            # Проверка на попадание
            hit_prob = min(self.dmgchance, 1.0)

            renpy.log(f"=== НАЧАЛО РАСЧЕТА УРОНА ОТ ЗАЩИТЫ ===")
            renpy.log(f"Атакующий: {self.name}, Цель: {enemy.name}")
            renpy.log(f"Шанс попадания: {hit_prob} (dmgchance: {self.dmgchance})")

            if random.random() > hit_prob:
                self.popal = 0
                store.is_crit = False
                store.dmg = 0
                enemy.damage_gain_for_vis = 0
                enemy.got_crit_for_visual = 0
                store.clear_swoon_pending_for_visual(enemy)
                renpy.log("ПРОМАХ! popal установлен в 0")
                return 0

            self.popal = 1
            renpy.log("ПОПАДАНИЕ! popal установлен в 1")

            # Определение критического удара
            critrate_value = self.critrate
            store.is_crit = random.random() < critrate_value
            renpy.log(f"Критический удар: {store.is_crit} (critrate: {critrate_value})")

            next_attack_multiplier = max(0.0, self.next_attack_multiplier)

            # Вместо итоговой атаки используем итоговую защиту персонажа.
            if store.is_crit:
                base_dmg = (self.defense *2* self.crit * self.perform * store.atk_ind_ratio - enemy.armor) * self.popal
                renpy.log(f"Расчет КРИТИЧЕСКОГО урона от защиты: ({self.defense} * {self.crit} * {self.perform} * {store.atk_ind_ratio} - {enemy.armor}) * {self.popal}")
            else:
                base_dmg = (self.defense *2* self.perform * store.atk_ind_ratio - enemy.armor) * self.popal
                renpy.log(f"Расчет ОБЫЧНОГО урона от защиты: {self.defense} * {self.perform} * {store.atk_ind_ratio} - {enemy.armor} * {self.popal}")

            if next_attack_multiplier != 1.0:
                base_dmg *= next_attack_multiplier
                self.next_attack_multiplier = 1.0

            renpy.log(f"Базовый урон до штрафов: {base_dmg}")

            # Применение прогрессивных штрафов
            final_dmg = self.calculate_progressive(base_dmg, self.DAMAGE_THRESHOLDS)
            renpy.log(f"Финальный урон после штрафов: {final_dmg}")

            result = int(max(min(final_dmg, 600), 10))
            store.dmg = result

            # Обработка щитов врага
            if apply_shield and hasattr(enemy, 'shield') and enemy.shield > 0:
                enemy.shield -= 1
                enemy.damage_gain_for_vis = 1
                enemy.got_crit_for_visual = 0
                store.clear_swoon_pending_for_visual(enemy)
                renpy.notify("Урон поглощен щитом!")
                return 1

            # Применение урона к врагу и подготовка визуализации
            old_hp = enemy.current_hp
            enemy.current_hp = max(0, enemy.current_hp - result)
            store.update_swoon_pending_for_visual(enemy, old_hp)

            if self.popal == 1 and result >= 1:
                enemy.damage_gain_for_vis = result
            else:
                enemy.damage_gain_for_vis = 0
                store.clear_swoon_pending_for_visual(enemy)

            enemy.got_crit_for_visual = 1 if store.is_crit else 0
            return result

        def calculate_magic(self, enemy):
            # Проверка на попадание
            hit_prob = min(self.dmgchance, 1.0)
            if random.random() > hit_prob:
                self.popal = 0
                store.dmg = 0  # Сохраняем в глобальную переменную
                enemy.damage_gain_for_vis = 0  # Промах
                enemy.got_crit_for_visual = 0
                store.clear_swoon_pending_for_visual(enemy)
                return 0  # Промах
            else:
                self.popal = 1

                # Определение критического удара
                critrate_value = self.critrate  # Используем свойство для получения значения
                store.is_crit = random.random() < critrate_value

                # Расчет базового магического урона с учетом магической защиты врага
                if store.is_crit:
                    base_dmg = (self.magic * self.crit * self.perform * store.atk_ind_ratio - enemy.armor) * self.popal
                else:
                    base_dmg = (self.magic * self.perform * store.atk_ind_ratio - enemy.magic_armor) * self.popal

                # Применение прогрессивных штрафов
                final_magic = self.calculate_progressive(base_dmg, self.DAMAGE_THRESHOLDS)
                result = max(min(final_magic, 600), 10)
                store.dmg = result  # Сохраняем в глобальную переменную

                # Обработка щитов врага
                if hasattr(enemy, 'shield') and enemy.shield > 0:
                    # Уменьшаем количество щитов врага
                    enemy.shield -= 1
                    # Урон не применяется, но визуализация показывается
                    enemy.damage_gain_for_vis = 1
                    enemy.got_crit_for_visual = 0  # При поглощении щитом крит не отображается
                    store.clear_swoon_pending_for_visual(enemy)
                    return 1
                else:
                    # Применение урона к врагу
                    old_hp = enemy.current_hp
                    enemy.current_hp = max(0, enemy.current_hp - result)
                    store.update_swoon_pending_for_visual(enemy, old_hp)

                    # Обновление переменных цели для визуализации
                    if result >= 1:
                        enemy.damage_gain_for_vis = result  # Сохраняем урон для визуализации
                    else:
                        enemy.damage_gain_for_vis = 0  # Нулевой урон
                        store.clear_swoon_pending_for_visual(enemy)

                    if store.is_crit:
                        enemy.got_crit_for_visual = 1 # Критический удар
                    else:
                        enemy.got_crit_for_visual = 0  # Обычное попадание

                    return result



        @staticmethod
        def calculate_progressive(x, thresholds):
            result = 0
            prev_threshold = 0
            for threshold, multiplier in thresholds:
                if x <= prev_threshold:
                    break
                segment = min(x, threshold) - prev_threshold
                result += segment * multiplier
                prev_threshold = threshold
            return result

