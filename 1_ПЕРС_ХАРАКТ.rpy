    def set_character_level(char_name, new_level):
        """
        Безопасно устанавливает уровень персонажа.

        Параметры:
            char_name: имя персонажа (строка)
            new_level: новый уровень (целое число)
        """
        # Проверяем, существует ли pers_dict
        if not hasattr(store, 'pers_dict') or store.pers_dict is None:
            renpy.log("ОШИБКА: pers_dict не существует")
            return

        # Проверяем, существует ли персонаж
        if char_name not in store.pers_dict:
            renpy.log(f"ОШИБКА: Персонаж '{char_name}' не найден в pers_dict")
            return

        char = store.pers_dict[char_name]

        # Проверяем валидность нового уровня
        max_level = len(char.max_hp_levels)
        if new_level < 1:
            renpy.log(f"ОШИБКА: Уровень не может быть меньше 1")
            return
        if new_level > max_level:
            renpy.log(f"ОШИБКА: Максимальный уровень для {char_name} - {max_level}")
            return

        # Сохраняем старый уровень для лога
        old_level = char.level

        # Устанавливаем новый уровень (setter автоматически обновит HP, MP и проверит артефакты)
        char.level = new_level

        renpy.log(f"{char_name}: уровень изменен с {old_level} на {new_level}")
        renpy.notify(f"{char_name} достиг {new_level} уровня!")

    class SetCharacterLevelAction(Action):
        """
        Action для изменения уровня персонажа.
        Используется с таймерами или кнопками.
        """

        def __init__(self, char_name, new_level):
            self.char_name = char_name
            self.new_level = new_level

        def __call__(self):
            set_character_level(self.char_name, self.new_level)
            renpy.restart_interaction()

    class SetAllCharactersLevelAction(Action):
        """
        Action для изменения уровня ВСЕХ персонажей.
        Используется с таймерами или кнопками.
        """

        def __init__(self, new_level):
            self.new_level = new_level

        def __call__(self):
            for char_name in store.pers_dict:
                set_character_level(char_name, self.new_level)
            renpy.restart_interaction()

    class ModifyAllCharactersLevelAction(Action):
        """
        Action для изменения уровня ВСЕХ персонажей на указанное значение (+1, -1 и т.д.).
        Используется с таймерами или кнопками.
        """

        def __init__(self, level_change):
            self.level_change = level_change  # может быть положительным (+1) или отрицательным (-1)

        def __call__(self):
            for char_name in store.pers_dict:
                char = store.pers_dict[char_name]
                new_level = char.level + self.level_change
                set_character_level(char_name, new_level)
