    def get_active_set_bonuses(char):
        """Возвращает словарь суммарных бонусов от всех активных сетов для персонажа."""
        result = {}
        equipped_ids = [a for a in char.equipped_artifacts if a is not None]

        for set_id, set_data in store.artifact_sets.items():
            pieces = set_data["pieces"]
            required = set_data.get("required", len(pieces))
            equipped_count = sum(1 for aid in pieces if aid in equipped_ids)

            if equipped_count >= required:
                for mod_type, mod_value in set_data["bonuses"].items():
                    result[mod_type] = result.get(mod_type, 0) + mod_value

        return result

    def get_set_status(char):
        """Возвращает статус каждого сета для персонажа: {set_id: (equipped_count, required, active)}."""
        status = {}
        equipped_ids = [a for a in char.equipped_artifacts if a is not None]
        for set_id, set_data in store.artifact_sets.items():
            pieces = set_data["pieces"]
            required = set_data.get("required", len(pieces))
            equipped_count = sum(1 for aid in pieces if aid in equipped_ids)
            status[set_id] = (equipped_count, required, equipped_count >= required)
        return status

    def notify_set_change(char, item_id, just_equipped):
        """Уведомляет об активации/потере сета, если затронутый артефакт изменил статус сета."""
        # Каждое надевание/снятие сбрасывает подсветку, чтобы солид показывался
        # только если в этом же действии сет образовался или распался.
        store.set_event_flash.clear()
        affected_sets = []  # Список (set_name, bonuses, mode) для одного действия
        for set_id, set_data in store.artifact_sets.items():
            if item_id not in set_data["pieces"]:
                continue
            equipped_count, required, active = get_set_status(char).get(set_id, (0, 1, False))
            set_name = set_data["name"]
            if just_equipped and active and equipped_count == required:
                renpy.notify(f"{char.name}: активирован сет «{set_name}» ({equipped_count}/{required})!")
                affected_sets.append((set_name, dict(set_data["bonuses"]), "equip"))
                _flash_set_event(set_data["pieces"], "equip")
                store.artifact_sets_discovered[set_id] = True
            elif not just_equipped and not active and equipped_count == required - 1:
                renpy.notify(f"{char.name}: сет «{set_name}» больше не активен.")
                affected_sets.append((set_name, dict(set_data["bonuses"]), "unequip"))
                _flash_set_event(set_data["pieces"], "unequip")
        # Если одним действием затронуто несколько сетов, показываем их одним окном:
        # названия через запятую, а бонусы суммируются.
        if affected_sets:
            store.show_set_stats_popup(affected_sets)

