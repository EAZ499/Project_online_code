        def sync_picked_from_team(self):
            """Синхронизирует picked переменные с team_slots."""
            # Сбрасываем всех
            for char_name, char in store.characters.items():
                if hasattr(char, 'picked'):
                    char.picked = 0

            # Крис всегда picked
            if "Крис" in store.characters:
                store.pers_dict["Крис"].picked = 1

            # Устанавливаем picked для членов команды (кроме Криса)
            for slot in self.team_slots[1:]: # Итерируемся по слотам, начиная со второго
                if slot and slot in store.characters:
                    store.pers_dict[slot].picked = 1

        def reorder_team_slots_by_current_attacker(self):
            """Уплотняет и сортирует слоты 2-4 по порядку current_attacker у персонажей."""
            ordered_team_members = [
                slot for slot in self.team_slots[1:]
                if slot is not None and slot != "Крис"
            ]
            ordered_team_members.sort(key=lambda name: self.ATTACKER_ORDER.get(name, 999))

            self.team_slots = ["Крис"] + ordered_team_members[:self.MAX_TEAM_SIZE - 1]
            while len(self.team_slots) < self.MAX_TEAM_SIZE:
                self.team_slots.append(None)

        def unequip_artifacts_for_non_team_members(self):
            """Автоматически снимает артефакты со всех, кто не находится в team_slots."""
            team_members = {name for name in self.team_slots if name is not None}
            for char_name, char in store.pers_dict.items():
                if char_name not in team_members and hasattr(char, 'equipped_artifacts'):
                    if any(artifact is not None for artifact in char.equipped_artifacts):
                        char.unequip_all_artifacts(notify=False)

        # Обновляем последователей на основе выбранных персонажей
        if hasattr(store, 'update_followers_from_picked'):
            store.update_followers_from_picked()

        def get_team_position(self, slot_index):
            """Возвращает координаты для персонажа в указанном слоте."""
            # Теперь slot_index - это реальный индекс в team_slots (0 для Криса, 1 для второго и т.д.)
            ypos = self.KRIS_YPOS + slot_index * self.TEAM_MEMBER_OFFSET_Y
            return (self.KRIS_XPOS, ypos)

        def get_team_member_count(self):
            """Возвращает количество персонажей в команде."""
            # Крис всегда есть, так что считаем его + остальных
            return 1 + len([slot for slot in self.team_slots[1:] if slot is not None])

        def get_character_to_hit(self):
            """Определяет, какого персонажа атакует враг на основе параметров tank."""
            # Рассматриваем только персонажей в команде
            team_characters = []
            for slot in self.team_slots:
                if slot and slot in store.characters:
                    char = store.pers_dict[slot]
                    # === ДОБАВЬТЕ ЭТУ ПРОВЕРКУ ===
                    # Добавляем в список только ЖИВЫХ персонажей
                    if char.current_hp > 0:
                        team_characters.append(char)

            # Если команда пуста (маловероятно, но на всякий случай), возвращаем Криса
            if not team_characters:
                return store.pers_dict["Крис"]

            # Рассчитываем общий tank только для персонажей в команде
            weighted_tanks = [max(0.0, float(getattr(char, "total_tank", 0))) for char in team_characters]
            final_tank = sum(weighted_tanks)
            if final_tank <= 0:
                return team_characters[0]

            tank_choose = int(renpy.random.uniform(0.0, final_tank))

            current_sum = 0.0
            for char, char_tank in zip(team_characters, weighted_tanks):
                current_sum += char_tank
                if tank_choose <= current_sum:
                    renpy.notify(f"Общее значение tank: {final_tank}. Выпавшее значение tank: {tank_choose}")
                    return char

            #return store.pers_dict[0]  # Возвращаем первого персонажа в команде как значение по умолчанию

        def apply_damage_to_team(self):
            """
            Наносит урон всем персонажам в команде (picked = 1).
            Сырой урон зависит от зоны игрока:
            - Если зона = Stadium_z1, то сырой урон = 20
            - Иначе сырой урон = 5% от максимального HP персонажа

            Итоговый урон по каждому персонажу = сырой урон - защита персонажа
            Уменьшает HP каждого персонажа на итоговый урон.
            """
            # Проверяем, есть ли зона пуль и персонажи
            if not hasattr(store, 'current_bullet_zone') or not hasattr(store, 'pers_dict'):
                return

            current_zone = getattr(store, 'current_bullet_zone', None)

            # Проходим по всем персонажам в pers_dict
            for char_name, char in store.pers_dict.items():
                # Пропускаем персонажей, у которых picked != 1
                if not hasattr(char, 'picked') or char.picked != 1:
                    continue

                # Пропускаем мёртвых персонажей
                if char.current_hp <= 0:
                    continue

                # Вычисляем сырой урон в зависимости от зоны
                if current_zone == "Stadium_z1":
                    raw_damage = 20
                    store.raw_damage_for_vis = "20"
                if current_zone == "pipka":
                    raw_damage = 20
                    store.raw_damage_for_vis = "20"
                else:
                    # 5% от максимального HP персонажа

                    raw_damage = int(char.max_hp * 0.05)
                    store.raw_damage_for_vis = "5%"



                # Итоговый урон = сырой урон - защита. При попадании минимум 10.
                final_damage = int(max(10, raw_damage - char.defense))

                # «Правильный угол» (магия Криса ур.5): 50% шанс проигнорировать
                # урон снарядов, заряд тратится на это попадание.
                if kris_try_right_angle_dodge(char):
                    continue

                # Сильвия «Ловкость в бою» (ур.1): шанс полностью уклониться
                # от снаряда. Работает только когда цель — сама Сильвия.
                if sylvia_try_dodge(char):
                    continue

                # Фабри «Не поймаешь» (магия М-с Морковки ур.3): уклонение
                # снаряда выбранной целью. Шанс = танк цели − 35.
                if fabri_try_dodge(char):
                    continue

                # «Вернуть отправителю» Арчи ур.7: 2 хода Арчи не получает урона
                # и возвращает снаряды противника обратно в него.
                if archie_return_active() and getattr(char, "name", None) == "Арчи":
                    continue

                # «Храбрость!» Арчи ур.9: весь урон получает Арчи вместо союзника.
                if archie_redirect_damage_to_self(char):
                    _archie_holder = archie_char()
                    if _archie_holder is not None:
                        _archie_holder.current_hp = max(0, _archie_holder.current_hp - final_damage)
                    continue

                if getattr(char, 'shield', 0) > 0:
                    final_damage = 0
                    char.shield -= 1
                elif final_damage > 0:
                    final_damage = max(10, final_damage)

                    # Применяем урон напрямую, чтобы корректно работать при overheal (current_hp > max_hp)
                    old_hp = char.current_hp
                    char.current_hp = max(10, char.current_hp - final_damage)

                    # Пассивки Криса: «Вмятины на щите» и «Желание жить».
                    kris_passive_on_hero_damage(char, old_hp)
                    # Пассивки Азриеля: «Лоб в лоб», «Стойкий», «Рука помощи».
                    azri_on_damage_taken(char, old_hp)
                    azri_try_helping_hand(char)
                    # Пассивка Кловера «Шутки кончились»: первое попадание
                    # по нему даёт бафф концентрация x5.
                    clover_on_damage_received(char)
                    # Пассивка Иззи «Мы отзвуки прошлого нас»: при потерянном
                    # равновесии Иззи получает в 1.5 раза больше урона.
                    izzy_on_damage_received(char)
                    # Пассивка Арчи «Уворот! Контрудар!»: попеременно уворот
                    # и контратака при получении урона.
                    archie_on_damage_received(char)

                    # Сильвия: урон сбивает комбинацию движений («Не сбиваясь
                    # с Ритма» ур.4 даёт шанс её сохранить) и сбрасывает
                    # накопленный танк «Раскрываясь в свете прожекторов».
                    if getattr(char, "name", None) == "Сильвия":
                        sylvia_on_damage_received(final_damage)

                    # Фабри: «Рукодельные друзья» — призванные фамильяры
                    # получают урон вместе с ней. Вызов ровно один раз на
                    # попадание, здесь же, где и остальные пассивки урона.
                    if getattr(char, "name", None) == "Фабри":
                        # «Творчество будет жить...» ур.7: с крит.шансом
                        # Фабри получает 150% урона. Множитель применяем
                        # ДО передачи урона фамильярам, чтобы они делили
                        # уже итоговое значение.
                        _fabri_mult = fabri_creation_lives_multiplier(char)
                        if _fabri_mult != 1.0:
                            _extra = int(final_damage * (_fabri_mult - 1.0))
                            char.current_hp = max(0, char.current_hp - _extra)
                            final_damage += _extra
                        fabri_on_hp_change(-final_damage)
                    else:
                        # «Прикрепиться» (магия Панцыря ур.5): 30% урона по
                        # прикреплённой цели принимает на себя Панцырь,
                        # поэтому цель «лечится» на перенесённую часть.
                        _fabri_transferred = fabri_attach_damage_split(char, final_damage)
                        if _fabri_transferred != final_damage:
                            char.current_hp = char.current_hp + (final_damage - _fabri_transferred)
                            final_damage = _fabri_transferred

                    # Логирование для отладки
                    renpy.notify(f"Урон нанесён {char.name}: сырой={raw_damage}, защита={char.defense}, итоговый={final_damage}")

