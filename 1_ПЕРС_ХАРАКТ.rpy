            renpy.restart_interaction()

    class ConfirmTradeAction(Action):
        """Action для подтверждения сделки без закрытия экрана при неудаче."""

        def __call__(self):
            # Проверяем, хватает ли денег
            trade_cost = store.calculate_trade_cost()
            if trade_cost > store.money:
                # Ухудшаем отношение торговца на 0.5 (дробное для расчётов, целое для отображения)
                current_personal = store.merchants_personal_relation.get(store.current_merchant_id, 0)
                new_personal = max(-25, min(25, current_personal - 0.5))
                store.merchants_personal_relation[store.current_merchant_id] = new_personal
                renpy.notify(f"Недостаточно денег! Отношение торговца ухудшилось до {int(store.get_total_relation())}%")
                renpy.restart_interaction()
                return None  # Не закрываем экран

            # Выполняем сделку
            # Удаляем проданные артефакты игрока (с учётом множителя 0.5 и отношения)
            # И добавляем их в инвентарь торговца
            for idx in sorted(store.player_selling, reverse=True):
                inst = store.artifact_instances[idx]
                artifact_id = inst["id"]
                owner_name = inst.get("owner")

                # Если предмет был экипирован, снимаем его с персонажа
                if owner_name and owner_name in store.pers_dict:
                    char = store.pers_dict[owner_name]
                    # Находим слот с этим артефактом и снимаем его
                    for slot_idx, equipped_id in enumerate(char.equipped_artifacts):
                        if equipped_id == artifact_id:
                            char.unequip_artifact(slot_index=slot_idx, instance_index=idx)
                            break

                base_price = store.artifact_prices.get(artifact_id, 0)
                price = store.get_player_sell_price(base_price)
                store.money += price

                # Добавляем артефакт в инвентарь торговца
                store.merchant_inventory.append({"id": artifact_id, "price": base_price})

                del store.artifact_instances[idx]
                if artifact_id in store.artifact_inventory:
                    store.artifact_inventory[artifact_id] -= 1
                    if store.artifact_inventory[artifact_id] <= 0:
                        store.artifact_inventory.pop(artifact_id, None)

            # Удаляем проданные consumables игрока (с учётом множителя 0.5 и отношения)
            # И добавляем их в инвентарь торговца
            for item_id in store.player_selling_consumables:
                base_price = store.get_scaled_consumable_price(item_id) if hasattr(store, "get_scaled_consumable_price") else store.consumable_prices.get(item_id, 0)
                price = store.get_player_sell_price(base_price)
                store.money += price

                # Добавляем consumable в инвентарь торговца
                store.merchant_consumables_inventory.append({"id": item_id, "price": base_price})

                store.consumable_inventory[item_id] -= 1
                if store.consumable_inventory[item_id] <= 0:
                    store.consumable_inventory.pop(item_id, None)

            # Добавляем купленные артефакты (с учётом отношения)
            for idx in sorted(store.merchant_selling, reverse=True):
                item = store.merchant_inventory[idx]
                base_price = item["price"]
                price = store.get_merchant_sell_price(base_price)
                store.money -= price
                store.artifact_instances.append({"id": item["id"], "owner": None})
                store.artifact_inventory[item["id"]] = store.artifact_inventory.get(item["id"], 0) + 1
                del store.merchant_inventory[idx]

            # Добавляем купленные consumables (с учётом отношения)
            for item_id in store.merchant_selling_consumables:
                base_price = store.get_scaled_consumable_price(item_id) if hasattr(store, "get_scaled_consumable_price") else store.consumable_prices.get(item_id, 0)
                price = store.get_merchant_sell_price(base_price)
                store.money -= price
                store.consumable_inventory[item_id] = store.consumable_inventory.get(item_id, 0) + 1

                # Удаляем один экземпляр этого расходника у торговца
                for merch_idx, merch_item in enumerate(store.merchant_consumables_inventory):
                    if merch_item.get("id") == item_id:
                        del store.merchant_consumables_inventory[merch_idx]
                        break

            # Очищаем списки
            store.player_selling = []
            store.player_selling_consumables = []
            store.merchant_selling = []
            store.merchant_selling_consumables = []

            renpy.notify("Сделка завершена!")
            renpy.restart_interaction()
            return None  # Не закрываем экран

