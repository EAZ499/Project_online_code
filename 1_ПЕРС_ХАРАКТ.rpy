    def get_feedness_queue(char):
        """Возвращает очередь питания персонажа фиксированной длины max_feedness."""
        max_feedness = max(0, int(getattr(char, "max_feedness", 0) or 0))
        queue = list(getattr(char, "feedness_queue", []) or [])

        if len(queue) < max_feedness:
            queue.extend([None] * (max_feedness - len(queue)))
        elif len(queue) > max_feedness:
            queue = queue[-max_feedness:]

        char.feedness_queue = queue
        return queue

    def push_feedness_item(char, item_id):
        """Добавляет тип consumable в очередь питания персонажа с вытеснением первого элемента."""
        queue = get_feedness_queue(char)
        if not queue:
            return

        food_type = store.consumable_food_types.get(item_id, "other")

        if all(value is None for value in queue):
            queue[0] = food_type
        elif None in queue:
            queue[queue.index(None)] = food_type
        else:
            queue.pop(0)
            queue.append(food_type)

        char.feedness_queue = queue

    def reset_feedness_step(char):
        """Сдвигает очередь питания на 1 к началу, очищая последний слот."""
        queue = get_feedness_queue(char)
        if not queue:
            return

        queue.pop(0)
        queue.append(None)
        char.feedness_queue = queue
        char.current_feedness = max(0, min(int(getattr(char, "max_feedness", 0) or 0), sum(1 for value in queue if value is not None)))

