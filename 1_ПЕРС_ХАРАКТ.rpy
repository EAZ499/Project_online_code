                            elif modifier_type == "powerartifactmod":
                                self.powerartifactmod += modifier_value
                            elif modifier_type == "tankartifactmod":
                                self.bonus_tank += modifier_value

                    # Проходим по всем социальным модификаторам артефакта
                    for i, modifier_type in enumerate(social_modifiers):
                        if i < len(social_values):
                            modifier_value = social_values[i]

                            if modifier_type == "socializationartifactmod":
                                self.socializationartifactmod += modifier_value
                            elif modifier_type == "diplomacyartifactmod":
                                self.diplomacyartifactmod += modifier_value
                            elif modifier_type == "charmartifactmod":
                                self.charmartifactmod += modifier_value
                            elif modifier_type == "perceptionartifactmod":
                                self.perceptionartifactmod += modifier_value
                            elif modifier_type == "rhetoricartifactmod":
                                self.rhetoricartifactmod += modifier_value
                            elif modifier_type == "artistryartifactmod":
                                self.artistryartifactmod += modifier_value
                            elif modifier_type == "comfortartifactmod":
                                self.comfortartifactmod += modifier_value
                            elif modifier_type == "powerartifactmod":
                                self.powerartifactmod += modifier_value

                    # Индивидуальные (персонажные) бонусы артефакта
                    char_overrides = store.artifact_character_modifiers.get((artifact_id, self.name), {})
                    for modifier_type, modifier_value in char_overrides.items():
                        if hasattr(self, modifier_type):
                            setattr(self, modifier_type, getattr(self, modifier_type) + modifier_value)

            # ============================================================
            # СЕТОВЫЕ БОНУСЫ
            # ============================================================
            for mod_type, mod_value in get_active_set_bonuses(self).items():
                if mod_type == "tankartifactmod":
                    self.bonus_tank += mod_value
                elif hasattr(self, mod_type):
                    setattr(self, mod_type, getattr(self, mod_type) + mod_value)

            # Для обратной совместимости считаем общий artifactmod
            self.artifactmod = self.atkartifactmod + self.defartifactmod + self.maxhpartifactmod

        def get_max_slots(self):
            """Возвращает максимальное количество слотов для экипировки"""
            # Таблица базового количества слотов по уровню:
            #   1:3, 2:4, 3:5, 4:6, 5:7, 6:8, 7:8, 8:9, 9:9, 10:10
            level = self.level
            if level <= 6:
                base_slots = level + 2
            elif level <= 8:
                base_slots = level + 1
            else:
                base_slots = level
            return base_slots + self.extraequip

        def check_and_remove_excess_artifacts(self):
            """Проверяет и удаляет лишние артефакты, если их больше доступных слотов"""
            max_slots = self.get_max_slots()
            while len(self.equipped_artifacts) > max_slots:
                # Удаляем последний артефакт
                excess_item = self.equipped_artifacts.pop()
                # Освобождаем владельца в экземпляре
                for inst in store.artifact_instances:
                    if inst["id"] == excess_item and inst["owner"] == self.name:
                        inst["owner"] = None
                        break
                renpy.notify("Лишний артефакт [store.artifact_names.get(excess_item, excess_item)] снят из-за ограничения слотов!")
            self.recalc_artifactmod()

        def can_equip_artifact(self, item_id, instance_index=None):
            # Проверяем, можно ли экипировать этот артефакт
            if instance_index is not None:
                # Проверяем конкретный экземпляр: он должен существовать
                if instance_index < 0 or instance_index >= len(store.artifact_instances):
                    return False
                # Экземпляр можно экипировать, если он не принадлежит текущему персонажу
                # (если принадлежит, то это значит нужно снять и надеть заново)
                return True
            else:
                # Старое поведение: ищем любой свободный экземпляр
                free_count = 0
                for inst in store.artifact_instances:
                    if inst["id"] == item_id and inst["owner"] is None:
                        free_count += 1
                return free_count > 0

        def equip_artifact(self, item_id, instance_index=None):
            # Проверяем, есть ли свободные слоты
            max_slots = self.get_max_slots()
            equipped_count = sum(1 for x in self.equipped_artifacts if x is not None)
            if equipped_count >= max_slots:
                renpy.notify("Нет свободных слотов. Максимум: [max_slots]")
                return

            # Если указан конкретный экземпляр, работаем с ним
            if instance_index is not None:
                # Проверяем валидность индекса
                if instance_index < 0 or instance_index >= len(store.artifact_instances):
                    renpy.notify("Неверный индекс артефакта.")
                    return

                inst = store.artifact_instances[instance_index]

                # Проверяем, что это нужный тип артефакта
                if inst["id"] != item_id:
                    renpy.notify("Несовпадение типа артефакта.")
                    return

                # Если этот экземпляр уже экипирован на текущего персонажа
                if inst["owner"] == self.name:
                    renpy.notify("Этот артефакт уже надет на [self.name].")
                    return

                # Если артефакт принадлежит другому персонажу, снимаем его с него
                if inst["owner"] is not None and inst["owner"] != self.name:
                    prev_owner = store.pers_dict.get(inst["owner"])
                    if prev_owner:
                        # Снимаем артефакт с предыдущего владельца
                        if item_id in prev_owner.equipped_artifacts:
                            prev_owner.equipped_artifacts.remove(item_id)
                        prev_owner.recalc_artifactmod()

                # Экипируем артефакт на текущего персонажа
                self.equipped_artifacts.append(item_id)
                inst["owner"] = self.name
                self.recalc_artifactmod()
                notify_set_change(self, item_id, True)
                renpy.notify("[self.name] теперь экипировал этот артефакт!")
                return

            # Старое поведение: ищем свободный экземпляр
            if not self.can_equip_artifact(item_id):
                renpy.notify("Нет свободных экземпляров этого артефакта.")
                return
            # Проверяем, экипирован ли этот экземпляр на текущего персонажа
            for inst in store.artifact_instances:
                if inst["id"] == item_id and inst["owner"] == self.name:
                    renpy.notify("Этот артефакт уже надет.")
                    return

            # Находим первый свободный экземпляр этого типа артефакта
            instance_index = None
            for i, inst in enumerate(store.artifact_instances):
                if inst["id"] == item_id and inst["owner"] is None:
                    instance_index = i
                    break

            if instance_index is None:
                renpy.notify("Нет свободных экземпляров этого артефакта.")
                return

            # Артефакты больше не удаляются из инвентаря при экипировке
            self.equipped_artifacts.append(item_id)
            store.artifact_instances[instance_index]["owner"] = self.name
            self.recalc_artifactmod()
            notify_set_change(self, item_id, True)

        def unequip_artifact(self, slot_index, instance_index=None):
            if slot_index < 0 or slot_index >= len(self.equipped_artifacts):
                return
            prev = self.equipped_artifacts[slot_index]
            if prev is None:
                return

            # Если указан конкретный экземпляр, снимаем именно его
            if instance_index is not None:
                if instance_index < 0 or instance_index >= len(store.artifact_instances):
                    return
                inst = store.artifact_instances[instance_index]
                if inst["id"] == prev and inst["owner"] == self.name:
                    inst["owner"] = None
            else:
                # Старое поведение: ищем экземпляр по типу и владельцу
                for inst in store.artifact_instances:
                    if inst["id"] == prev and inst["owner"] == self.name:
                        inst["owner"] = None
                        break

            # Удаляем артефакт из списка экипированных
            self.equipped_artifacts.pop(slot_index)
            self.recalc_artifactmod()
            notify_set_change(self, prev, False)

        def use_weapon_consumable(self, item_id, target_enemy=None):
            item_display_name = getattr(store, "consumable_names", {}).get(item_id, item_id)
            if hasattr(store, 'apply_weapon_consumable_effects'):
                store.apply_weapon_consumable_effects(self, item_id, target_enemy)
                return True

            renpy.notify("Для предмета [item_display_name] не найден обработчик.")
            return False

        def use_regular_consumable(self, item_id):
            if not self.can_be_fed():
                renpy.notify("[self.name] больше не может есть сейчас.")
                return False

            if hasattr(store, 'apply_consumable_all_effects'):
                store.apply_consumable_all_effects(self, item_id)
            else:
                heal_amount = store.consumable_effects.get(item_id, 0)
                self.current_hp = min(self.current_hp + heal_amount, self.max_hp)
            self.feed_character(1)
            push_feedness_item(self, item_id)
            return True

        def use_consumable(self, item_id):
            if store.consumable_inventory.get(item_id, 0) <= 0:
                renpy.notify("Этого предмета нет в инвентаре.")
                return

            is_weapon_consumable = hasattr(store, "is_weapon_consumable_item") and store.is_weapon_consumable_item(item_id)
            item_display_name = getattr(store, "consumable_names", {}).get(item_id, item_id)

            if is_weapon_consumable:
                used = self.use_weapon_consumable(item_id, None)
            else:
                used = self.use_regular_consumable(item_id)

            if not used:
                return

            # Удаляем consumable из инвентаря
            store.consumable_inventory[item_id] = store.consumable_inventory.get(item_id, 0) - 1
            if store.consumable_inventory[item_id] <= 0:
                store.consumable_inventory.pop(item_id, None)

            if is_weapon_consumable:
                #renpy.notify("[self.name] использовал(а) [item_display_name].")
                pass
            else:
                effects1 = store.get_consumable_item_effects_level1(item_id) if hasattr(store, 'get_consumable_item_effects_level1') else (store.consumable_effects_level1.get(item_id, {}) if hasattr(store, 'consumable_effects_level1') else {})
                hp_heal = effects1.get("hp_heal", 0)
                mp_heal = effects1.get("mp_heal", 0)
                shield_heal = effects1.get("shield_heal", 0)

                message_parts = []
                if hp_heal != 0:
                    message_parts.append(f"+{hp_heal} HP")
                if mp_heal != 0:
                    message_parts.append(f"+{mp_heal} MP")
                if shield_heal != 0:
                    message_parts.append(f"+{shield_heal} Щит")

                if message_parts:
                    pass
                    #renpy.notify("[self.name]: {', '.join(message_parts)}")
                else:
                    pass
                    #renpy.notify("[self.name] использовал(а) [item_display_name]!")

        # Привязываем методы к объекту (чтобы работало без правки класса Pers)
        import types
        p.recalc_artifactmod = types.MethodType(recalc_artifactmod, p)
        p.can_equip_artifact = types.MethodType(can_equip_artifact, p)
        p.equip_artifact = types.MethodType(equip_artifact, p)
        p.unequip_artifact = types.MethodType(unequip_artifact, p)
        p.use_weapon_consumable = types.MethodType(use_weapon_consumable, p)
        p.use_regular_consumable = types.MethodType(use_regular_consumable_teamwide, p)
        p.use_consumable = types.MethodType(use_consumable, p)
        p.feedness_queue = list(getattr(p, "feedness_queue", []) or [])
        get_feedness_queue(p)

        store.pers_dict[char_id] = p




    def update_hp_preview(action_type, char_name=None, artifact_id=None, consumable_id=None):
        """
        Обновляет предпросмотр будущих значений всех характеристик.

        Параметры:
            action_type: Тип действия ("equip", "unequip", "use_consumable")
            char_name: Имя персонажа, над которым выполняется действие
            artifact_id: ID артефакта (для equip/unequip)
            consumable_id: ID consumable (для use_consumable)
        """
        # Сбрасываем словарь предпросмотра
        store.hp_preview_values = {}

        # Если действие не указано, отключаем предпросмотр
        if action_type is None:
            store.hp_preview_enabled = False
            return

        store.hp_preview_enabled = True

        # Для каждого персонажа рассчитываем будущие значения
        for name, char in store.pers_dict.items():
            future_max_hp = char.max_hp
            future_hp = char.current_hp
            future_max_mp = char.max_mp
            future_atk = char.base_atk
            future_defense = char.base_def
            future_magic = char.base_magic
            future_accuracy = char.base_dmgchance
            future_critrate = char.base_critrate
            future_crit = char.base_crit
            future_tank = char.total_tank

            # Дипломатические характеристики
            future_socialization = char.socialization
            future_diplomacy = char.diplomacy
            future_charm = char.charm
            future_perception = char.perception
            future_rhetoric = char.rhetoric
            future_artistry = char.artistry
            future_comfort = char.comfort
            future_power = char.power

            # Флаги изменения параметров
            hp_changed = False
            mp_changed = False
            atk_changed = False
            def_changed = False
            magic_changed = False
            accuracy_changed = False
            critrate_changed = False
            crit_changed = False
            tank_changed = False
            socialization_changed = False
            diplomacy_changed = False
            charm_changed = False
            perception_changed = False
            rhetoric_changed = False
            artistry_changed = False
            comfort_changed = False
            power_changed = False

            # Если это персонаж, над которым выполняется действие
            if name == char_name:
                if action_type == "use_consumable" and consumable_id:
                    # Предпросмотр лечения HP/MP для расходуемого предмета.
                    # Используем те же данные, что и фактическое применение.
                    effects1 = (store.get_consumable_item_effects_level1(consumable_id)
                                if hasattr(store, "get_consumable_item_effects_level1") else {})
                    hp_heal = effects1.get("hp_heal", 0)
                    mp_heal = effects1.get("mp_heal", 0)
                    hp_percent = effects1.get("hp_percent", 0)
                    mp_percent = effects1.get("mp_percent", 0)

                    projected_hp = hp_heal + int(char.max_hp * hp_percent)
                    projected_mp = mp_heal + int(char.max_mp * mp_percent)
                    if projected_hp:
                        future_hp = min(char.current_hp + projected_hp, char.max_hp)
                        hp_changed = future_hp != char.current_hp
                    if projected_mp:
                        future_mp = min(char.current_mp + projected_mp, char.max_mp)
                        mp_changed = future_mp != char.current_mp

                elif action_type == "equip" and artifact_id:
                    # При экипировке артефакта увеличиваем соответствующие параметры
                    modifier_types = store.artifact_modifiers.get(artifact_id, [])
                    modifier_values = store.artifact_modifier_values.get(artifact_id, [])
                    # Индивидуальные (персонажные) бонусы артефакта
