    class DoubleClickAction(Action):
        """Action для кнопок, требующих двойного нажатия.
        При первом нажатии показывает экран art_desc и предпросмотр HP,
        при втором - скрывает экран art_desc и выполняет действие."""

        def __init__(self, button_key, char_name, action_func, action_args, label=None,
                    action_type=None, item_id=None):
            self.button_key = button_key
            self.char_name = char_name
            self.action_func = action_func
            self.action_args = action_args
            self.label = label
            self.action_type = action_type  # "equip", "use_consumable"
            self.item_id = item_id  # artifact_id или consumable_id

        def __call__(self):
            # Получаем текущее состояние кнопки
            state = store.button_states.get(self.button_key, 0)

            if state == 0:
                # Первое нажатие: сбрасываем состояние предыдущей выбранной кнопки
                if store.selected_button is not None and store.selected_button != self.button_key:
                    store.button_states[store.selected_button] = 0

                # Устанавливаем состояние 1 для текущей кнопки
                store.button_states[self.button_key] = 1
                store.selected_button = self.button_key

                # Показываем экран art_desc только если pokaz_desc == 1
                #if store.pokaz_desc == 1:
                #    renpy.show_screen("art_desc")

                # Обновляем предпросмотр HP
                if self.action_type and self.char_name in store.pers_dict:
                    store.update_hp_preview(self.action_type, self.char_name, self.item_id)
                else:
                    store.update_hp_preview(None)

                renpy.restart_interaction()
            else:
                # Второе нажатие: скрываем экран art_desc, выполняем действие и сбрасываем состояние
                store.button_states[self.button_key] = 0
                store.selected_button = None

                # Скрываем экран art_desc
                renpy.hide_screen("art_desc")

                # Сбрасываем данные артефакта
                store.art_desc_artifact_id = None
                store.art_desc_instance_index = None

                # Отключаем предпросмотр перед выполнением действия
                store.update_hp_preview(None)

                if self.action_func and self.char_name in store.pers_dict:
                    char = store.pers_dict[self.char_name]
                    method = getattr(char, self.action_func)
                    if method:
                        method(*self.action_args)

        def get_label(self):
            """Возвращает текст кнопки с крестиком, если нажата 1 раз"""
            state = store.button_states.get(self.button_key, 0)
            if self.label:
                if state == 1:
                    return f"{self.label} (×)"
                return self.label
            return None

