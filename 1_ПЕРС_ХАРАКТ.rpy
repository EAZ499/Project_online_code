# Функция для инициализации и обновления игровых систем
init python:
    def reset_game_state():
        # Проверяем, существует ли уже store.pers_dict, чтобы избежать пересоздания
        if not hasattr(store, 'pers_dict') or store.pers_dict is None:
            # Сначала проверяем, доступен ли класс Pers в глобальной области
            if 'Pers' in globals() and globals()['Pers'] is not None and hasattr(globals()['Pers'], '__call__'):
                # Если класс Pers доступен, создаем персонажей
                store.pers_dict = make_Pers()
            else:
                renpy.log("ПРЕДУПРЕЖДЕНИЕ: Класс Pers недоступен при вызове reset_game_state()")
                # Пытаемся найти класс Pers в других местах
                # Это может потребовать дополнительной логики в зависимости от структуры проекта

        if not hasattr(store, 'enemies') or store.enemies is None:
            store.enemies = make_enemies()

        store.characters = store.pers_dict

        if not hasattr(store, 'team_manager') or store.team_manager is None:
            store.team_manager = TeamManager()
            store.team_manager.rebuild_team_from_picked()

        if not hasattr(store, 'battle_manager') or store.battle_manager is None:
            store.battle_manager = BattleManager()

        # Инициализация simon_game и cooking_manager
        if not hasattr(store, 'simon_game') or store.simon_game is None:
            store.simon_game = SimonGame()
        if not hasattr(store, 'cooking_manager') or store.cooking_manager is None:
            store.cooking_manager = CookingManager()

    # Инициализация при запуске игры
    if not hasattr(store, 'simon_game') or store.simon_game is None:
        store.simon_game = SimonGame()
    if not hasattr(store, 'cooking_manager') or store.cooking_manager is None:
        store.cooking_manager = CookingManager()

    def ensure_team_manager():
        """
        Гарантирует, что team_manager инициализирован.
        Если team_manager равен None, создает новый экземпляр и восстанавливает команду.
        """
        # Лог для диагностики проблемы
        if store.pers_dict is None:
            # Проверяем, доступен ли класс Pers перед вызовом make_Pers()
            if 'Pers' in globals() and globals()['Pers'] is not None and hasattr(globals()['Pers'], '__call__'):
                store.pers_dict = make_Pers()
            else:
                renpy.log("КРИТИЧЕСКАЯ ОШИБКА: Класс Pers недоступен в ensure_team_manager()")
                return

        # Миграция старых сохранений: новые персонажи добавляются в уже
        # существующий словарь без сброса прогресса старых героев.
        required_names = ("Ральзей", "Ноэлль", "Санс", "Бердли")
        missing = [name for name in required_names if name not in store.pers_dict]
        if missing:
            fresh = make_Pers()
            for name in missing:
                store.pers_dict[name] = fresh[name]

        if store.characters is None:
            renpy.log("ПРЕДУПРЕЖДЕНИЕ: store.characters равен None в ensure_team_manager()")
            renpy.log("Присваиваем store.characters = store.pers_dict")
            store.characters = store.pers_dict

        if store.team_manager is None:
            store.team_manager = TeamManager()
            store.team_manager.rebuild_team_from_picked()

    def initialize_game_state():
        """
        Выполняет первоначальную настройку состояния игры после загрузки.
        Эту функцию следует вызывать в начале игры или после загрузки сохранения.
        """
        # Убеждаемся, что team_manager инициализирован
        ensure_team_manager()

        # Обновляем ингредиенты от Седрика
        sedric = store.pers_dict["Седрик"]
        store.cooking_manager.current_animal_ing = sedric.animal_ing[sedric.level-1]
        store.cooking_manager.current_plant_ing = sedric.plant_ing[sedric.level-1]
        store.cooking_manager.current_bread_ing = sedric.bread_ing[sedric.level-1]
        store.cooking_manager.current_spices_ing = sedric.spices_ing[sedric.level-1]

        store.cooking_manager.future_current_animal_ing = store.cooking_manager.current_animal_ing
        store.cooking_manager.future_current_plant_ing = store.cooking_manager.current_plant_ing
        store.cooking_manager.future_current_bread_ing = store.cooking_manager.current_bread_ing
        store.cooking_manager.future_current_spices_ing = store.cooking_manager.current_spices_ing

        # Восстанавливаем команду из флагов 'picked'
        store.team_manager.rebuild_team_from_picked()

    def show_damage_screen(attacker_name, target_name, self_damage, target_damage):
        """Показывает экран с уроном на 2 секунды"""
        # Сохраняем текущий экран
        renpy.show_screen("damage_display_screen",
                        attacker=attacker_name,
                        target=target_name,
                        self_dmg=self_damage,
                        target_dmg=target_damage)

