        # Методы для отношений
        def calculate_rtlns_mod(self):
            """Рассчитывает бонус к атаке на основе отношений (диапазон -100 до 100)."""
            # Чем хуже отношения, тем ниже бонус. 1.0 - нейтрально.
            if self.reltns <= -80:
                return 1.5   # Превосходно
            elif self.reltns <= -60:
                return 1.375 # Очень хорошо
            elif self.reltns <= -40:
                return 1.25  # Хорошо
            elif self.reltns <= -20:
                return 1.125 # Сlightly good
            else: # reltns > -20
                return 1.0

        def calculate_rtlns_mod_for_def(self):
            """Рассчитывает бонус к защите на основе отношений (диапазон -100 до 100)."""
            if self.reltns >= 80:
                return 1.5   # Превосходная защита
            elif self.reltns >= 60:
                return 1.375 # Очень хорошая защита
            elif self.reltns >= 40:
                return 1.25  # Хорошая защита
            elif self.reltns >= 20:
                return 1.125 # Сlightly good defense
            else: # reltns > -20
                return 1.0

        def calculate_rtlns_mod_for_tank(self):
            """Рассчитывает бонус к tank на основе отношений (диапазон -100 до 100)."""
            if self.reltns >= 80:
                return 1.5   # Превосходный tank
            elif self.reltns >= 60:
                return 1.375 # Очень хороший tank
            elif self.reltns >= 40:
                return 1.25  # Хороший tank
            elif self.reltns >= 20:
                return 1.125 # Сlightly good tank
            else: # reltns < 20
                return 1.0

        def change_reltns(self, delta):
            """Изменяет отношения, ограничивая их диапазоном от -100 до 100."""
            self.reltns = max(-100, min(self.reltns + delta, 100))
            if self.name == "Крис":
                self.rtlns_mod = self.calculate_rtlns_mod()
                self.rtlns_mod_for_def = self.calculate_rtlns_mod_for_def()
                self.rtlns_mod_for_tank = self.calculate_rtlns_mod_for_tank()


