            reset_feedness_step(hero)

    def _get_feedness_tick_targets():
        """Возвращает список персонажей, у которых очередь питания не пустая."""
        targets = []
        for hero in _get_pers_dict_values():
            queue = get_feedness_queue(hero)
            if any(value is not None for value in queue):
                targets.append(hero)
        random.shuffle(targets)
        return targets

    def start_feedness_tick_cycle():
        """
        Запускает рассинхронное обновление очереди питания и дебаффов.
        Сначала уменьшается очередь/аппетит, затем персонажи обрабатываются по одному.
        """
        store.feedness_tick_targets = _get_feedness_tick_targets()
        store.feedness_tick_index = 0
        store.feedness_tick_active = bool(store.feedness_tick_targets)
        store.feedness_tick_delay = 0
        if store.feedness_tick_active:
            renpy.restart_interaction()

    def schedule_next_feedness_tick():
        """Назначает следующий запуск тика только если есть кому обновляться."""
        if getattr(store, "feedness_tick_delay", 0) > 0:
            return store.feedness_tick_delay
        if _get_feedness_tick_targets():
            store.feedness_tick_delay = random.randint(25, 35)
            return store.feedness_tick_delay
        store.feedness_tick_active = False
        store.feedness_tick_delay = 0
        return None

    def process_next_feedness_tick_target():
        """
        Обрабатывает одного персонажа из очереди feedness-tick.
        Вызывается повторяющимся таймером, чтобы обновление шло не одновременно.
        """
        targets = list(getattr(store, "feedness_tick_targets", []) or [])
        index = int(getattr(store, "feedness_tick_index", 0) or 0)

        if index >= len(targets):
            store.feedness_tick_active = False
            store.feedness_tick_delay = 0
            store.feedness_tick_targets = []
            store.feedness_tick_index = 0
            return

        hero = targets[index]
        store.feedness_tick_index = index + 1

        if hero is not None:
            reset_feedness_step(hero)
            if hasattr(hero, "name"):
                # Дебаффы обрабатываются отдельно по каждому персонажу, чтобы тик не был синхронным.
                apply_debuffs_at_round_start_for_char(hero)

        if store.feedness_tick_index >= len(targets):
            store.feedness_tick_active = False
            store.feedness_tick_delay = 0
            schedule_next_feedness_tick()

