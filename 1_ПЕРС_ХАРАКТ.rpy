        @staticmethod
        def calculate_progressive(x, thresholds):
            """Статический метод для прогрессивных штрафов"""
            result = 0
            prev_threshold = 0
            for threshold, multiplier in thresholds:
                if x <= prev_threshold:
                    break
                segment = min(x, threshold) - prev_threshold
                result += segment * multiplier
                prev_threshold = threshold
            return result

