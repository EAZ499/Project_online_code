label clicker:
$ quick_menu = False 
"{cps=50}T{nw}{/cps}"
"{sc=5}Это просто сон! Надо только проснуться!{/sc}"
$ clicks = 0
$ time_left = 8.3
$ show_button = True
show screen click_game
# Запускаем таймер
while time_left > 0.0:
    $ time_left -= 1.0
    $ renpy.pause(1.0)  # Таймер уменьшается на 1 каждую секунду
# Когда таймер закончится, проверяем результат
hide screen click_game
call check_result

label check_result:
    if clicks >= 50:
        jump success_scenario
    else:
        jump fail_scenario


# Сценарий успеха
label success_scenario:
    hide screen click_game
    stop music fadeout 3.0
    scene dark with Dissolve(2.0)
    pause 2.5
    jump hide_zhopa

# Сценарий неудачи
label fail_scenario:
    hide screen click_game
    jump screamer3

# Экран с кнопкой
screen click_game:
    text "{sc=5}{font=Wingdings.ttf}You clicked{/font}: [clicks]/50{/sc}" xpos 0.4 ypos 0.2   

    vbox:
        xpos 0.4 ypos 0.45
        # Проверяем переменную show_button, чтобы показывать либо кнопку, либо её замену
        imagebutton:
            idle "wake up.png"  # Изображение кнопки в обычном состоянии
            hover "wake up2.png"  # Изображение кнопки при наведении
            hovered Play("sound", "audio/buttonselected.mp3")
            action [Play("sound","button2.ogg"), Function(on_button_click)]





# Определяем функцию для обработки нажатия кнопки
init python:
    def on_button_click():
        global clicks, show_button

        # Увеличиваем счётчик нажатий, если меньше 20
        if clicks < 50:
            clicks += 1
        # Скрываем кнопку, показываем замену
        show_button = False
        
        # Через 0.2 секунды возвращаем кнопку обратно
        renpy.timeout(0.2)
        show_button = True

     
label game_loop:
    while time_left > 0:
        # Даем возможность Ren'Py обновлять экран
        $ renpy.pause(1.0)
        $ time_left -= 1  # Уменьшаем время каждую секунду
        if time_left <= 0:
            return

