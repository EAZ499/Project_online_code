label game_over:

    # DECAYING: каждая смерть навсегда урезает максимальное HP Криса
    # (хранится в persistent и не сбрасывается вместе со слотом сохранения).
    $ kris_decaying_register_death()

    # «Подсознательная память» Азриеля: проигранный бой навсегда прибавляет
    # ему базовой магии (7 * уровень персонажей).
    $ azri_register_battle_lost()

    hide screen team_status_display
    hide screen Heroattacks
    hide screen targettochoose_sprites
    hide screen check_enemy_status


    # Сбрасываем состояние кнопок перед началом нового хода персонажа,
    # чтобы не оставались экраны прошлой анимации (например atob/abackdis).
    $ fightchoice = 0
    $ actchoice = 0
    $ magicchoice = 0
    $ itemchoice = 0

    hide screen choose_attack_screen
    hide screen actchoice1
    hide screen choose_magic_screen
    hide screen itemchoice2

    hide screen ftoc
    hide screen atoc
    hide screen mtoc
    hide screen itoc

    hide screen ftob
    hide screen atob
    hide screen mtob
    hide screen itob

    hide screen fbackapp
    hide screen abackapp
    hide screen mbackapp
    hide screen ibackapp

    hide screen fbackdis
    hide screen abackdis
    hide screen mbackdis
    hide screen ibackdis

    $ persistent.nuzhnofastmenu = 0
    $ quick_menu = False
    $ config.skipping = False
    $ persistent.krisprologue_dead = 1
    scene dark
    stop music
    show gameover
    play sound gameoversound
    $ renpy.pause(3, hard=True)
    transform gameovera:
        xpos 0.0 ypos -0.045
    show gameovera at gameovera
    transform gameoverb:
        xpos 0.325 ypos 0.1
    show gameoverb at gameoverb with dissolve
    play music gameover
    $ renpy.pause(2, hard=True)
    hide gameover
    $ renpy.pause(3.8, hard=True)
    voice "audio/the reason why you hunted.mp3"
    "{sc=5}{font=micro-fleurons.ttf}{size=80}Dear, you cannot give up so easily.{/size}{font}{/sc}"
    scene dark
    with Dissolve(.6)  
    $ persistent.nuzhnofastmenu = 1
    $ renpy.full_restart()



