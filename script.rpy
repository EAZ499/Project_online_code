    def change_reltns(delta):
        """Обёртка для изменения отношений с Крисом."""
        if not hasattr(store, "pers_dict") or store.pers_dict is None:
            return

        kris = store.pers_dict.get("Крис")
        if kris is None:
            renpy.notify("Крис не найден.")
            return

        kris.change_reltns(delta)
        renpy.notify(f"Отношения с Крисом: {kris.reltns} ({delta:+d})")

