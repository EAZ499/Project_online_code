default timer_start1 = 0  # Время начала
default timer_running1 = False  # Статус таймера
default timer_elapsed1 = 0  # Прошедшее время

init python:
    import time

    def start_timer():
        global timer_start1, timer_running1
        timer_start1 = time.time()  # Запоминаем текущее время
        timer_running1 = True  # Запускаем таймер

    def update_timer():
        global timer_elapsed1
        if timer_running1:
            timer_elapsed1 = time.time() - timer_start1  # Обновляем прошедшее время

