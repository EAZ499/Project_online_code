    def clover_geno_route_available():
        """Р“РёРїРµСЂР»СѓС‡ РґРѕСЃС‚СѓРїРµРЅ С‚РѕР»СЊРєРѕ РЅР° СЂСѓС‚Рµ GENO.

        Р СѓС‚ С…СЂР°РЅРёС‚СЃСЏ РІ store.phone_role_mode[РёРјСЏ] Рё РїРµСЂРµРєР»СЋС‡Р°РµС‚СЃСЏ РїРѕ РџРљРњ
        РІ С‚РµР»РµС„РѕРЅРµ (СЃРј. 0_РўР•Р›Р•Р¤РћРќ.rpy, phone_toggle_role_set).
        """
        mode = (getattr(store, "phone_role_mode", {}) or {}).get("РљР»РѕРІРµСЂ")
        return str(mode).lower() == "geno"

