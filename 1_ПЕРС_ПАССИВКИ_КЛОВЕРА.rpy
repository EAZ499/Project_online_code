        return clover_caliber_data()["damage"]

    def clover_shot_cost(count=1):
        """РЎРїРёСЃС‹РІР°РµС‚ РїР°С‚СЂРѕРЅС‹. Р’РѕР·РІСЂР°С‰Р°РµС‚, СЃРєРѕР»СЊРєРѕ СЂРµР°Р»СЊРЅРѕ РїРѕС‚СЂР°С‡РµРЅРѕ."""
        available = clover_ammo_count()
        spent = min(available, max(0, int(count)))
        store.clover_ammo = available - spent
        return spent

    def clover_has_ammo(count=1):
        return clover_ammo_count() >= max(0, int(count))

    def clover_shot_bonus_perform():
        """В«РџРѕРїСЂР°РІРєР° РЅР° РІРµС‚РµСЂВ» СѓСЂ.1: РїРѕСЃС‚РѕСЏРЅРЅС‹Р№ Р±РѕРЅСѓСЃ РёСЃРїРѕР»РЅРµРЅРёСЏ 2*СѓСЂ."""
        return CLOVER_WIND_BONUS_PER_LEVEL * clover_level() / 100.0

    def clover_max_perform_bonus():
        """В«РџРѕРїСЂР°РІРєР° РЅР° РІРµС‚РµСЂВ»: РјР°РєСЃРёРјСѓРј РёСЃРїРѕР»РЅРµРЅРёСЏ РІС‹С€Рµ РЅР° 20%."""
        return CLOVER_WIND_MAX_BONUS

    # ========================================================================
    # Р—РћР РљРР™ Р“Р›РђР— - Р—РћР РљРР™ РЈРњ (СЃРѕС†. С…Р°СЂР°РєС‚РµСЂРёСЃС‚РёРєРё РѕС‚ Р±РѕРµРІС‹С…)
    # ========================================================================

    def clover_sharp_eye_bonus():
        """Р’РѕР·РІСЂР°С‰Р°РµС‚ (Рє РІРѕСЃРїСЂРёСЏС‚РёСЋ, Рє СЂРёС‚РѕСЂРёРєРµ, Рє РІР»Р°СЃС‚Рё)."""
        if clover_level() < CLOVER_SHARP_EYE_LEVEL:
            return (0, 0, 0)
        char = clover_char()
        if char is None:
            return (0, 0, 0)
        step = CLOVER_SHARP_EYE_STEP
        perception = int(float(getattr(char, "dmgchance", 0)) / step)
        rhetoric = int(float(getattr(char, "critrate", 0)) / step)
        power = int(float(getattr(char, "crit", 1.0) - 1.0) / step)
        return (perception, rhetoric, max(0, power))

    def clover_apply_sharp_eye():
        """РќР°С‡РёСЃР»СЏРµС‚ СЃРѕС†. Р±РѕРЅСѓСЃ В«Р—РѕСЂРєРѕРіРѕ РіР»Р°Р·Р°В» (РёРґРµРјРїРѕС‚РµРЅС‚РЅРѕ)."""
        if clover_level() < CLOVER_SHARP_EYE_LEVEL:
            return False
        char = clover_char()
        if char is None:
            return False
        perception, rhetoric, power = clover_sharp_eye_bonus()
        applied = getattr(store, "clover_sharp_eye_applied", None)
        current = (perception, rhetoric, power)
        if applied == current:
            return False
        # РЎРЅРёРјР°РµРј РїСЂРѕС€Р»С‹Р№ Р±РѕРЅСѓСЃ, СЃС‚Р°РІРёРј РЅРѕРІС‹Р№ вЂ” РЅРµ С‚СЂРѕРіР°РµРј РґСЂСѓРіРёРµ РёСЃС‚РѕС‡РЅРёРєРё.
        prev = applied or (0, 0, 0)
        char.bonus_perception = float(getattr(char, "bonus_perception", 0)) - prev[0] + perception
        char.bonus_rhetoric = float(getattr(char, "bonus_rhetoric", 0)) - prev[1] + rhetoric
        char.bonus_power = float(getattr(char, "bonus_power", 0)) - prev[2] + power
        store.clover_sharp_eye_applied = current
        return True

    # ========================================================================
    # Р”Р•Р›РЈ - Р’Р Р•РњРЇ, РџРћРўР•РҐР• - Р§РђРЎ (РґРµР±Р°С„С„ В«РёРіСЂРѕРјР°РЅВ»)
    # ========================================================================

    def clover_has_gambler_debuff():
        return bool(getattr(store, "clover_gambler_debuff", True))

    def clover_clear_gambler_debuff():
        """РРіСЂР° СЃС‹РіСЂР°РЅР° вЂ” РґРµР±Р°С„С„ СЃРЅСЏС‚ РґРѕ СЃР»РµРґСѓСЋС‰РµРіРѕ С…РѕРґР°."""
        store.clover_gambler_debuff = False
        return True

    def clover_apply_gambler_debuff():
        """РџСЂРѕРІРµСЂРєР° РІ РЅР°С‡Р°Р»Рµ С…РѕРґР°: Р±РµР· РёРіСЂС‹ РІРёСЃРёС‚ РґРµР±Р°С„С„ В«РёРіСЂРѕРјР°РЅВ»."""
        return clover_has_gambler_debuff()

    # ========================================================================
    # Р РђРЎРЎР›Р•Р”РћР’РђРќРР• Р”Р•Р›Рђ (С€РєР°Р»Р° РІРёРЅРѕРІРЅРѕРіРѕ, С‚СЋСЂСЊРјР°)
    # ========================================================================

    def clover_investigation_entry(name):
        crimes = getattr(store, "clover_investigation", {}) or {}
        return crimes.get(name, {"progress": 0, "prison": 0, "crimes": []})

    def get_clover_wanted_targets():
        return getattr(store, "clover_wanted_targets", {}) or {}

    def clover_record_crime(target, crime, amount=None):
        """РќР°С‡РёСЃР»СЏРµС‚ РїСЂРµСЃС‚СѓРїР»РµРЅРёРµ С†РµР»Рё. Р’РѕР·РІСЂР°С‰Р°РµС‚ Р·Р°РїРёСЃСЊ С†РµР»Рё."""
        if target is None:
            return None
        key = getattr(target, "name", None) or str(target)

        # В«РњРµС‚РєР° СЂР°Р·С‹СЃРєРёРІР°РµРјРѕРіРѕВ»: РїРѕРґ РјРµС‚РєРѕР№ С€РєР°Р»Р° РІРёРЅРѕРІРЅРѕРіРѕ РЅРµ Р·Р°РїРѕР»РЅСЏРµС‚СЃСЏ.
        if key in get_clover_wanted_targets():
            return clover_investigation_entry(key)

        if amount is None:
            amount = {
                "damage": CLOVER_CRIME_DAMAGE,
                "debuff": CLOVER_CRIME_DEBUFF,
                "stat": CLOVER_CRIME_STAT_LOSS,
                "kill": CLOVER_CRIME_KILL,
            }.get(crime, CLOVER_CRIME_DAMAGE)

        crimes = dict(getattr(store, "clover_investigation", {}) or {})
        entry = dict(crimes.get(key, {"progress": 0, "prison": 0, "crimes": []}))
        entry["progress"] = min(100, int(entry.get("progress", 0)) + int(amount))
        entry["crimes"] = list(entry.get("crimes", [])) + [crime]

        if crime == "kill":
            entry["prison"] = int(entry.get("prison", 0)) + CLOVER_PRISON_PER_KILL
        else:
            entry["prison"] = int(entry.get("prison", 0)) + CLOVER_PRISON_PER_CRIME

        crimes[key] = entry
        store.clover_investigation = crimes
        renpy.log("[РљР»РѕРІРµСЂ][Р Р°СЃСЃР»РµРґРѕРІР°РЅРёРµ] {} вЂ” {}: РІРёРЅРѕРІРЅРѕСЃС‚СЊ {}/100, С‚СЋСЂСЊРјС‹ {}".format(
            key, crime, entry["progress"], entry["prison"]))
        return entry

    def clover_on_damage(target, damage=0, debuff=False, killed=False, stat_loss=False):
        """Р•РґРёРЅР°СЏ С‚РѕС‡РєР° СѓС‡С‘С‚Р° РїСЂРµСЃС‚СѓРїР»РµРЅРёР№ (СѓСЂРѕРЅ/РґРµР±Р°С„С„/С€С‚СЂР°С„/СѓР±РёР№СЃС‚РІРѕ)."""
        if target is None:
            return None
        if killed:
            return clover_record_crime(target, "kill")
        if debuff:
            return clover_record_crime(target, "debuff")
        if stat_loss:
            return clover_record_crime(target, "stat")
        return clover_record_crime(target, "damage")

    def clover_is_wanted(target):
        key = getattr(target, "name", None) or str(target)
        return key in get_clover_wanted_targets()

    def clover_mark_wanted(target):
        """В«РњРµС‚РєР° СЂР°Р·С‹СЃРєРёРІР°РµРјРѕРіРѕВ»: С†РµР»СЊ РїРѕРґ РјРµС‚РєРѕР№ СЂРѕР·С‹СЃРєР°."""
        if target is None:
            return False
        key = getattr(target, "name", None) or str(target)
        marks = dict(get_clover_wanted_targets())
        marks[key] = True
        store.clover_wanted_targets = marks
        # РњРµС‚РєР° СЃРЅРёРјР°РµС‚ СѓР¶Рµ РЅР°РєРѕРїР»РµРЅРЅСѓСЋ РІРёРЅРѕРІРЅРѕСЃС‚СЊ.
        crimes = dict(getattr(store, "clover_investigation", {}) or {})
        if key in crimes:
            crimes.pop(key)
            store.clover_investigation = crimes
        return True

    def clover_send_to_prison(target, turns=None, ally=False):
        """РџРѕРјРµС‰Р°РµС‚ С†РµР»СЊ Р·Р° СЂРµС€С‘С‚РєСѓ РЅР° СѓРєР°Р·Р°РЅРЅРѕРµ С‡РёСЃР»Рѕ С…РѕРґРѕРІ."""
        if target is None:
            return False
        key = getattr(target, "name", None) or str(target)
        if turns is None:
            entry = clover_investigation_entry(key)
            turns = max(1, int(entry.get("prison", 1)))
        turns = max(1, int(turns))
        prison = dict(getattr(store, "clover_prison", {}) or {})
        prison[key] = {"turns": turns, "ally": bool(ally)}
        store.clover_prison = prison

        # Р—Р° СЂРµС€С‘С‚РєРѕР№ С†РµР»СЊ Р»РµР¶РёС‚ РЅРёС‡РєРѕРј, С‚Р°РЅРє РѕР±РЅСѓР»СЏРµС‚СЃСЏ: РІ В«РЎСѓРґРµВ» СѓРєР°Р·Р°РЅРѕ,
        # С‡С‚Рѕ СѓР·РЅРёРє РЅРµ РґРѕР»Р¶РµРЅ РїРµСЂРµС‚СЏРіРёРІР°С‚СЊ РЅР° СЃРµР±СЏ Р°С‚Р°РєРё (С‚Р°РЅРє = 0).
        target.prone_debuff = max(int(getattr(target, "prone_debuff", 0) or 0), turns)
        target.tank_debuff = int(getattr(target, "tank_debuff", 0) or 0) - 20
        renpy.log("[РљР»РѕРІРµСЂ][Р Р°СЃСЃР»РµРґРѕРІР°РЅРёРµ] {} Р·Р° СЂРµС€С‘С‚РєРѕР№ РЅР° {} С…РѕРґ(РѕРІ)".format(key, turns))
        return True

    def clover_prison_entry(target):
        key = getattr(target, "name", None) or str(target)
        return (getattr(store, "clover_prison", {}) or {}).get(key)

    def clover_is_in_prison(target):
        return clover_prison_entry(target) is not None

    def clover_prison_bail_cost(target):
        """В«РџРѕРјРёР»РѕРІР°С‚СЊВ»: Р·Р°Р»РѕРі = 2 * С‡РёСЃР»Рѕ РѕСЃС‚Р°РІС€РёС…СЃСЏ С…РѕРґРѕРІ."""
        entry = clover_prison_entry(target)
        if entry is None:
            return 0
        return CLOVER_BAIL_PER_TURN * max(1, int(entry.get("turns", 1)))

    def clover_free_from_prison(target):
        """РћСЃРІРѕР±РѕР¶РґР°РµС‚ С†РµР»СЊ РёР· С‚СЋСЂСЊРјС‹. Р’РѕР·РІСЂР°С‰Р°РµС‚ True РїСЂРё СѓСЃРїРµС…Рµ."""
        if target is None:
            return False
        key = getattr(target, "name", None) or str(target)
        prison = dict(getattr(store, "clover_prison", {}) or {})
        entry = prison.pop(key, None)
        if entry is None:
            return False
        store.clover_prison = prison
        target.prone_debuff = 0
        target.tank_debuff = int(getattr(target, "tank_debuff", 0) or 0) + 20
        store.clover_apply_reeducation(target, entry)
        return True

    def clover_apply_reeducation(target, entry=None):
        """В«РџСЂР°РІРёР»СЊРЅРѕРµ РїРµСЂРµРІРѕСЃРїРёС‚Р°РЅРёРµВ» СѓСЂ.4: РїРѕСЃР»Рµ РїРѕР»РЅРѕР№ РѕС‚СЃРёРґРєРё вЂ” СЃС‚Р°РєРё.

        Р’ РїСЂРѕРµРєС‚Рµ В«Р±РµР·СЂР°Р·Р»РёС‡РёРµВ» вЂ” СЌС‚Рѕ critdmg_debuff (СЃРј. 1_Р”Р•Р‘РђР¤Р«_РЎРРЎРўР•РњРђ.rpy,
        Рї.8 В«Р±РµР·СЂР°Р·Р»РёС‡РёРµ/Р·Р»РѕСЃС‚СЊВ»), В«СЃР»Р°Р±РѕСЃС‚СЊВ» вЂ” magic_debuff (Рї.5).
        """
        if clover_level() < CLOVER_REEDUCATION_LEVEL or target is None:
            return False
        if entry is not None and int(entry.get("turns", 0)) > 0:
            return False
        target.critdmg_debuff = int(getattr(target, "critdmg_debuff", 0) or 0) + CLOVER_REEDUCATION_APATHY
        target.magic_debuff = int(getattr(target, "magic_debuff", 0) or 0) + CLOVER_REEDUCATION_WEAKNESS
        renpy.log("[РљР»РѕРІРµСЂ][РџРµСЂРµРІРѕСЃРїРёС‚Р°РЅРёРµ] {}: Р±РµР·СЂР°Р·Р»РёС‡РёРµ +{}, СЃР»Р°Р±РѕСЃС‚СЊ +{}".format(
            getattr(target, "name", "?"), CLOVER_REEDUCATION_APATHY, CLOVER_REEDUCATION_WEAKNESS))
        return True

    def clover_try_prison_escape(target):
        """РџРѕР±РµРі РёР· С‚СЋСЂСЊРјС‹: РґСѓР±Р»СЊ РЅР° 2 РєСѓР±РёРєР°С… (РїСЂРѕС‚РёРІРЅРёРє вЂ” 3 РєСѓР±РёРєР°)."""
        if target is None:
            return False
        dice_count = 3 if getattr(target, "is_enemy", True) else 2
        rolls = [renpy.random.randint(1, 6) for _ in range(dice_count)]
        if len(set(rolls)) == 1:
            renpy.log("[РљР»РѕРІРµСЂ][РўСЋСЂСЊРјР°] {} РІС‹Р±СЂРѕСЃРёР» РґСѓР±Р»СЊ {} Рё РІС‹С€РµР»".format(
                getattr(target, "name", "?"), rolls))
            return clover_free_from_prison(target)
        return False

    def clover_tick_prison():
        """РљРѕРЅРµС† С…РѕРґР°: СѓРјРµРЅСЊС€Р°РµС‚ СЃСЂРѕРєРё Рё СЃРЅРёРјР°РµС‚ РѕС‚СЃРёРґРєСѓ."""
        prison = dict(getattr(store, "clover_prison", {}) or {})
        if not prison:
            return 0
        released = 0
        for key in list(prison.keys()):
            entry = dict(prison[key])
            entry["turns"] = int(entry.get("turns", 1)) - 1
            target = (getattr(store, "pers_dict", {}) or {}).get(key)
            if target is None:
                target = (getattr(store, "enemies", {}) or {}).get(key)
            if entry["turns"] <= 0:
                prison.pop(key, None)
                if target is not None:
                    target.prone_debuff = 0
                    target.tank_debuff = int(getattr(target, "tank_debuff", 0) or 0) + 20
                    store.clover_apply_reeducation(target, entry)
                released += 1
            else:
                prison[key] = entry
                if target is not None:
                    target.prone_debuff = max(int(getattr(target, "prone_debuff", 0) or 0), entry["turns"])
        store.clover_prison = prison
        return released

    def clover_prison_blocks_turn(target):
        """РќР°С…РѕРґСЏСЃСЊ Р·Р° СЂРµС€С‘С‚РєРѕР№, РїРµСЂСЃРѕРЅР°Р¶ РЅРµ РјРѕР¶РµС‚ РґРµР№СЃС‚РІРѕРІР°С‚СЊ."""
        return clover_is_in_prison(target)

    # ========================================================================
    # РџР•Р Р•РЎРўР Р•Р›РљРђ Р’ РџРћР›Р”Р•РќР¬ (РѕС‚РІРµС‚РЅС‹Р№ РІС‹СЃС‚СЂРµР»)
    # ========================================================================

    def clover_noon_available():
        return clover_level() >= CLOVER_NOON_LEVEL

    def clover_on_enemy_attack(attacker=None):
        """РћС‚РІРµС‚РЅС‹Р№ РІС‹СЃС‚СЂРµР», РєРѕРіРґР° РїСЂРѕС‚РёРІРЅРёРє Р°С‚Р°РєРѕРІР°Р» РљР»РѕРІРµСЂР°.

        РЁР°РЅСЃ РїРѕРїР°РґР°РЅРёСЏ = 18% РѕС‚ С‚РµРєСѓС‰РµРіРѕ С€Р°РЅСЃР° РїРѕРїР°РґР°РЅРёСЏ РљР»РѕРІРµСЂР°.
        РўСЂР°С‚РёС‚ РїР°С‚СЂРѕРЅ. РЈСЂРѕРЅ СѓС‡РёС‚С‹РІР°РµС‚ РєРѕСЌС„С„РёС†РёРµРЅС‚ РєР°Р»РёР±СЂР°.
        """
        char = clover_char()
        if char is None:
            return False
        if clover_level() < CLOVER_NOON_LEVEL:
            return False
        if not clover_has_ammo(1):
            return False

        chance = max(0.0, min(1.0, float(getattr(char, "dmgchance", 0)) * CLOVER_NOON_CHANCE))
        if renpy.random.random() >= chance:
            return False

        clover_shot_cost(1)
        renpy.log("[РљР»РѕРІРµСЂ][РџРµСЂРµСЃС‚СЂРµР»РєР° РІ РїРѕР»РґРµРЅСЊ] РѕС‚РІРµС‚РЅС‹Р№ РІС‹СЃС‚СЂРµР» (С€Р°РЅСЃ {:.1%})".format(chance))
        return True

    def clover_noon_damage(target):
        """РЈСЂРѕРЅ РѕС‚РІРµС‚РЅРѕРіРѕ РІС‹СЃС‚СЂРµР»Р° СЃ СѓС‡С‘С‚РѕРј РєР°Р»РёР±СЂР°."""
        char = clover_char()
        if char is None or target is None:
            return 0
        base = float(getattr(char, "atk", 0)) * clover_shot_damage_multiplier()
        armor = float(getattr(target, "armor", 0) or 0)
        return max(1, int(base - armor * 0.5))

    # ========================================================================
    # РРќРЎРўР РЈРљРўРћР  РџРћ Р‘РћР® (+С‚РѕС‡РЅРѕСЃС‚СЊ СЃРѕСЋР·РЅРёРєСѓ Р·Р° РІС‹СЃС‚СЂРµР»)
    # ========================================================================

    def clover_on_shot_fired():
        """РљР°Р¶РґС‹Р№ РІС‹СЃС‚СЂРµР»: +1-2% С‚РѕС‡РЅРѕСЃС‚Рё СЃР»СѓС‡Р°Р№РЅРѕРјСѓ СЃРѕСЋР·РЅРёРєСѓ."""
        if clover_level() < CLOVER_INSTRUCTOR_LEVEL:
            return None
        allies = [
            c for c in (getattr(store, "pers_dict", {}) or {}).values()
            if c is not None and not clover_is_char(c)
            and getattr(c, "picked", 0) == 1 and getattr(c, "current_hp", 0) > 0
        ]
        if not allies:
            return None
        ally = renpy.random.choice(allies)
        bonus = renpy.random.uniform(CLOVER_INSTRUCTOR_MIN, CLOVER_INSTRUCTOR_MAX)
        ally.bonus_dmgchance = float(getattr(ally, "bonus_dmgchance", 0)) + bonus
        store.clover_instructor_bonus = float(getattr(store, "clover_instructor_bonus", 0.0)) + bonus
        renpy.log("[РљР»РѕРІРµСЂ][РРЅСЃС‚СЂСѓРєС‚РѕСЂ РїРѕ Р±РѕСЋ] {}: С‚РѕС‡РЅРѕСЃС‚СЊ +{:.1%}".format(
            getattr(ally, "name", "?"), bonus))
        return ally

    # ========================================================================
    # РҐРћР›РћРЎРўРћР™ РќРђРћР‘РћР РћРў (СЌРєРѕРЅРѕРјРёСЏ РїР°С‚СЂРѕРЅР°)
    # ========================================================================

    def clover_blank_chance():
        """РЁР°РЅСЃ СЃСЌРєРѕРЅРѕРјРёС‚СЊ РїР°С‚СЂРѕРЅ: 3% + СѓСЂ/3 * РєРѕСЌС„С„РёС†РёРµРЅС‚ РєР°Р»РёР±СЂР°."""
        if clover_level() < CLOVER_BLANK_LEVEL:
            return 0.0
        return CLOVER_BLANK_BASE + (clover_level() / 3.0) * clover_shot_damage_multiplier() * 0.01

    def clover_try_blank_save():
        """Р’РѕР·РІСЂР°С‰Р°РµС‚ True, РµСЃР»Рё РїР°С‚СЂРѕРЅ СЃСЌРєРѕРЅРѕРјР»РµРЅ."""
        chance = clover_blank_chance()
        if chance <= 0.0:
            return False
        return renpy.random.random() < min(1.0, chance)

    # ========================================================================
    # РЈР”РђР§РќР«Р™ РџР РРЎРўР Р•Р›РћР§РќР«Р™ (РїРµСЂРІС‹Р№ РІС‹СЃС‚СЂРµР» С‚РѕС‡РЅРµРµ)
    # ========================================================================

    def clover_sighting_bonus():
        """РњРЅРѕР¶РёС‚РµР»СЊ С€Р°РЅСЃР° РїРѕРїР°РґР°РЅРёСЏ РґР»СЏ РїРµСЂРІРѕРіРѕ РІС‹СЃС‚СЂРµР»Р° Р°С‚Р°РєРё."""
        if clover_level() < CLOVER_SIGHTING_LEVEL:
            return 1.0
        return 1.0 + CLOVER_SIGHTING_PER_LEVEL * clover_level() / 10.0

    # ========================================================================
    # Р РРљРћРЁР•Рў (РѕС‚СЃРєРѕРє РІ РЅРµСЃРєРѕР»СЊРєРёС… РїСЂРѕС‚РёРІРЅРёРєРѕРІ)
    # ========================================================================

    def clover_ricochet_targets(primary=None, max_targets=3):
        """РЎРїРёСЃРѕРє РїСЂРѕС‚РёРІРЅРёРєРѕРІ РґР»СЏ СЂРёРєРѕС€РµС‚Р° СЃ РёС… С€Р°РЅСЃР°РјРё."""
        if clover_level() < CLOVER_RICOCHET_LEVEL:
            return []
        char = clover_char()
        if char is None:
            return []
        base_chance = float(getattr(char, "dmgchance", 0))
        candidates = [
            e for e in (getattr(store, "enemies", {}) or {}).values()
            if e is not None and getattr(e, "current_hp", 0) > 0 and e is not primary
        ]
        if not candidates:
            return []
        renpy.random.shuffle(candidates)
        result = []
        for index, enemy in enumerate(candidates[:max_targets]):
            chance = base_chance * CLOVER_RICOCHET_CHANCES[index]
            result.append((enemy, chance))
        return result

    def clover_ricochet_damage(target, ratio=0.5):
        """РЈСЂРѕРЅ СЂРёРєРѕС€РµС‚Р° вЂ” РґРѕР»СЏ РѕС‚ РѕР±С‹С‡РЅРѕРіРѕ РІС‹СЃС‚СЂРµР»Р°."""
        char = clover_char()
        if char is None or target is None:
            return 0
        base = float(getattr(char, "atk", 0)) * clover_shot_damage_multiplier() * ratio
        armor = float(getattr(target, "armor", 0) or 0)
        return max(1, int(base - armor * 0.5))

    # ========================================================================
    # РЁРЈРўРљР РљРћРќР§РР›РЎРЇ (РєРѕРЅС†РµРЅС‚СЂР°С†РёСЏ РїСЂРё РїРµСЂРІРѕРј РїРѕРїР°РґР°РЅРёРё)
    # ========================================================================

    def clover_on_damage_received(target=None, **kwargs):
        """РџРµСЂРІРѕРµ РїРѕРїР°РґР°РЅРёРµ РїРѕ РљР»РѕРІРµСЂСѓ РґР°С‘С‚ Р±Р°С„С„ РєРѕРЅС†РµРЅС‚СЂР°С†РёСЏ x5.

        Р’ РїСЂРѕРµРєС‚Рµ В«РєРѕРЅС†РµРЅС‚СЂР°С†РёСЏВ» вЂ” СЌС‚Рѕ РѕС‚СЂРёС†Р°С‚РµР»СЊРЅС‹Р№ accuracy_debuff
        (СЃРј. 1_РџР•Р РЎ_РҐРђР РђРљРў.rpy: <0 вЂ” РєРѕРЅС†РµРЅС‚СЂР°С†РёСЏ, >0 вЂ” СЃС‚СЂР°С…),
        РґР°СЋС‰РёР№ +5% С‚РѕС‡РЅРѕСЃС‚Рё Р·Р° СЃС‚Р°Рє.
        """
        if clover_level() < CLOVER_JOKES_OVER_LEVEL:
            return False
        char = clover_char()
        if char is None:
            return False
        if int(getattr(store, "clover_concentration_hits", 0) or 0) > 0:
            return False
        store.clover_concentration_hits = 1
        char.accuracy_debuff = int(getattr(char, "accuracy_debuff", 0) or 0) - CLOVER_CONCENTRATION_MULT
        renpy.log("[РљР»РѕРІРµСЂ][РЁСѓС‚РєРё РєРѕРЅС‡РёР»РёСЃСЊ] РєРѕРЅС†РµРЅС‚СЂР°С†РёСЏ x{} (accuracy_debuff = {})".format(
            CLOVER_CONCENTRATION_MULT, char.accuracy_debuff))
        return True

    # ========================================================================
    # Р’РќР•Р—РђРџРќРђРЇ Р—РђРќРђР§РљРђ (РІРѕСЃСЃС‚Р°РЅРѕРІР»РµРЅРёРµ РѕР±РѕР№РјС‹)
    # ========================================================================

    def clover_stash_chance():
        """10% + СѓРґР°С‡Р°*3.

        В«РЈРґР°С‡Р°В» РІ РїСЂРѕРµРєС‚Рµ вЂ” РѕС‚СЂРёС†Р°С‚РµР»СЊРЅС‹Р№ critrate_debuff, РїРѕСЌС‚РѕРјСѓ Р±РµСЂС‘Рј
        РјРѕРґСѓР»СЊ РЅР°РєРѕРїР»РµРЅРЅРѕР№ СѓРґР°С‡Рё (СЃРј. 1_РџР•Р РЎ_РҐРђР РђРљРў.rpy, Рї.7).
        """
        char = clover_char()
        luck = 0.0
        if char is not None:
            luck = max(0.0, -float(getattr(char, "critrate_debuff", 0) or 0))
        return CLOVER_STASH_BASE + luck * CLOVER_STASH_PER_LUCK / 100.0

    def clover_ammo_empty_refill():
        """РџСѓСЃС‚Р°СЏ РѕР±РѕР№РјР°: С€Р°РЅСЃ РІРѕСЃСЃС‚Р°РЅРѕРІРёС‚СЊ РїРѕР»РѕРІРёРЅСѓ РїР°С‚СЂРѕРЅРѕРІ."""
        if clover_ammo_count() > 0:
            return False
        if clover_level() < CLOVER_STASH_LEVEL:
            return False
        if renpy.random.random() >= min(1.0, clover_stash_chance()):
            return False
        restore = max(1, int(getattr(store, "clover_ammo_max", 6) / 2))
        store.clover_ammo = restore
        renpy.log("[РљР»РѕРІРµСЂ][Р’РЅРµР·Р°РїРЅР°СЏ Р·Р°РЅР°С‡РєР°] РІРѕСЃСЃС‚Р°РЅРѕРІР»РµРЅРѕ {} РїР°С‚СЂРѕРЅРѕРІ".format(restore))
        return True

    # ========================================================================
    # РЎРњР•Р РўР•Р›Р¬РќРђРЇ РЈР”РђР§Рђ (РґРІРѕР№РЅР°СЏ СѓРґР°С‡Р°)
    # ========================================================================

    def clover_apply_luck(amount):
        """Р’С‹РґР°С‘С‚ СѓРґР°С‡Сѓ; РЅР° СѓСЂ.10 РєРѕР»РёС‡РµСЃС‚РІРѕ СѓРґРІР°РёРІР°РµС‚СЃСЏ.

        Р’ РїСЂРѕРµРєС‚Рµ Р±Р°С„С„ В«СѓРґР°С‡Р°В» вЂ” СЌС‚Рѕ РѕС‚СЂРёС†Р°С‚РµР»СЊРЅС‹Р№ critrate_debuff
        (СЃРј. РєРѕРјРјРµРЅС‚Р°СЂРёР№ РІ 1_РџР•Р РЎ_РҐРђР РђРљРў.rpy: <0 вЂ” СѓРґР°С‡Р°, >0 вЂ” СЃРіР»Р°Р·).
        """
        char = clover_char()
        if char is None:
            return 0
        if clover_level() >= CLOVER_DEADLY_LUCK_LEVEL:
            amount *= 2
        amount = int(amount)
        store.clover_luck_charges = int(getattr(store, "clover_luck_charges", 0) or 0) + amount
        char.critrate_debuff = int(getattr(char, "critrate_debuff", 0) or 0) - amount
        renpy.log("[РљР»РѕРІРµСЂ][РЎРјРµСЂС‚РµР»СЊРЅР°СЏ СѓРґР°С‡Р°] СѓРґР°С‡Р° +{} (critrate_debuff = {})".format(
            amount, char.critrate_debuff))
        return amount

    def clover_apply_evil_eye(amount):
        """РЎРіР»Р°Р· вЂ” РїРѕР»РѕР¶РёС‚РµР»СЊРЅС‹Р№ critrate_debuff."""
        char = clover_char()
        if char is None:
            return 0
        amount = int(amount)
        store.clover_evil_eye_charges = int(getattr(store, "clover_evil_eye_charges", 0) or 0) + amount
        char.critrate_debuff = int(getattr(char, "critrate_debuff", 0) or 0) + amount
        renpy.log("[РљР»РѕРІРµСЂ][РЎС‚Р°РІРєР° РЅР° СѓРґР°С‡Сѓ] СЃРіР»Р°Р· +{} (critrate_debuff = {})".format(
            amount, char.critrate_debuff))
        return amount

    # ========================================================================
    # Р’РЎР•Рњ Р’ РЎРђР›РЈРќР• Р—Рђ РњРћР™ РЎР§РЃРў! (РЅР°РїРёС‚РѕРє РєРѕРјР°РЅРґРµ)
    # ========================================================================

    def clover_mark_saloon_drink(drink_id=None):
        """РљР»РѕРІРµСЂ РІС‹РїРёР» РЅР°РїРёС‚РѕРє вЂ” РІ РєРѕРЅС†Рµ С…РѕРґР° СѓРіРѕС‰Р°РµС‚ РєРѕРјР°РЅРґСѓ."""
        store.clover_saloon_pending = True
        store.clover_saloon_drink = drink_id
        return True

    def clover_apply_saloon_end_of_turn():
        """РљРѕРЅРµС† С…РѕРґР°: СЌС„С„РµРєС‚С‹ РЅР°РїРёС‚РєР° РєРѕРјР°РЅРґРµ Рё РїР°РґРµРЅРёРµ РљР»РѕРІРµСЂР° РЅРёС‡РєРѕРј."""
        if not bool(getattr(store, "clover_saloon_pending", False)):
            return False
        char = clover_char()
        if char is None:
            return False
        store.clover_saloon_pending = False

        # РЎР°Рј РљР»РѕРІРµСЂ: в€’10% С‚РѕС‡РЅРѕСЃС‚Рё, +8% РєСЂРёС‚-С€Р°РЅСЃ, +15% РєСЂРёС‚-СѓСЂРѕРЅ.
        char.bonus_dmgchance = float(getattr(char, "bonus_dmgchance", 0)) + CLOVER_SALOON_ACCURACY
        char.bonus_critrate = float(getattr(char, "bonus_critrate", 0)) + CLOVER_SALOON_CRITRATE
        char.bonus_crit = float(getattr(char, "bonus_crit", 0)) + CLOVER_SALOON_CRIT

        # РљРѕРјР°РЅРґР°: 2 РґРµР±Р°С„С„Р° СЂР°РґРѕСЃС‚Рё Рё РІРґРѕС…РЅРѕРІРµРЅРёСЏ, Р°РїРїРµС‚РёС‚ РЅРµ Р·Р°РїРѕР»РЅСЏРµС‚СЃСЏ.
        # В«Р Р°РґРѕСЃС‚СЊВ» вЂ” РѕС‚СЂРёС†Р°С‚РµР»СЊРЅС‹Р№ def_debuff, В«РІРґРѕС…РЅРѕРІРµРЅРёРµВ» вЂ” РѕС‚СЂРёС†Р°С‚РµР»СЊРЅС‹Р№
        # magic_debuff (СЃРј. 1_Р”Р•Р‘РђР¤Р«_РЎРРЎРўР•РњРђ.rpy, РїРї. 4-5).
        for ally in (getattr(store, "pers_dict", {}) or {}).values():
            if ally is None or clover_is_char(ally):
                continue
            if getattr(ally, "picked", 0) != 1 or getattr(ally, "current_hp", 0) <= 0:
                continue
            ally.def_debuff = int(getattr(ally, "def_debuff", 0) or 0) - 2
            ally.magic_debuff = int(getattr(ally, "magic_debuff", 0) or 0) - 2

        # РџРѕСЃР»Рµ СѓРіРѕС‰РµРЅРёСЏ РљР»РѕРІРµСЂ РїР°РґР°РµС‚ РЅРёС‡РєРѕРј РЅР° 1 С…РѕРґ.
        char.prone_debuff = max(int(getattr(char, "prone_debuff", 0) or 0), CLOVER_SALOON_PRONE_TURNS)
        store.clover_saloon_prone = CLOVER_SALOON_PRONE_TURNS
        renpy.log("[РљР»РѕРІРµСЂ][РЎР°Р»СѓРЅ] РєРѕРјР°РЅРґР° РІС‹РїРёР»Р°, РљР»РѕРІРµСЂ РїР°РґР°РµС‚ РЅРёС‡РєРѕРј")
        return True

    # ========================================================================
    # РџР РћР¦Р•РќРўР« РЎ РљРђР—РРќРћ (РґРѕР»СЏ РєРѕРјР°РЅРґС‹ РѕС‚ РёРіСЂ)
    # ========================================================================

    def clover_casino_share(amount):
        """РљРѕРјР°РЅРґР° РїРѕР»СѓС‡Р°РµС‚ 25% РѕС‚ РІС‹РёРіСЂС‹С€Р°/РїСЂРѕРёРіСЂС‹С€Р° РІ РёРіСЂР°С… В«РЎС‹РіСЂР°РµРј!В».

        Р”РµРЅСЊРіРё РїСЂРѕРµРєС‚Р° Р¶РёРІСѓС‚ РІ store.money (СЃРј. 1_РџР•Р РЎ_РҐРђР РђРљРў.rpy: default money).
        """
        if clover_level() < CLOVER_CASINO_LEVEL:
            return 0
        share = int(amount * CLOVER_CASINO_SHARE)
        if share != 0:
            store.money = int(getattr(store, "money", 0) or 0) + share
            persistent.clover_casino_earnings = int(
                getattr(persistent, "clover_casino_earnings", 0) or 0) + share
        return share

    def clover_current_money():
        return int(getattr(store, "money", 0) or 0)

    def clover_add_money(amount):
        store.money = clover_current_money() + int(amount)
        return store.money

    # ========================================================================
    # РЎРўРђР’РљРђ РќРђ РЈР”РђР§РЈ (СѓР»СѓС‡С€РµРЅРёРµ СѓСЂ.4)
    # ========================================================================

    def clover_apply_bet_result(won):
        """Р’С‹РёРіСЂС‹С€ вЂ” 3 СѓРґР°С‡Рё, РїСЂРѕРёРіСЂС‹С€ вЂ” 4 СЃРіР»Р°Р·Р° (СЃ СѓСЂ.4)."""
        if clover_level() < CLOVER_LUCK_BET_LEVEL:
            return 0
        char = clover_char()
        if char is None:
            return 0
        if won:
            store.clover_apply_luck(CLOVER_LUCK_BET_WIN)
            renpy.log("[РљР»РѕРІРµСЂ][РЎС‚Р°РІРєР° РЅР° СѓРґР°С‡Сѓ] РІС‹РёРіСЂС‹С€: +{} СѓРґР°С‡Рё".format(CLOVER_LUCK_BET_WIN))
            return CLOVER_LUCK_BET_WIN
        store.clover_apply_evil_eye(CLOVER_LUCK_BET_LOSE)
        renpy.log("[РљР»РѕРІРµСЂ][РЎС‚Р°РІРєР° РЅР° СѓРґР°С‡Сѓ] РїСЂРѕРёРіСЂС‹С€: +{} СЃРіР»Р°Р·Р°".format(CLOVER_LUCK_BET_LOSE))
        return -CLOVER_LUCK_BET_LOSE

    # ========================================================================
    # Р”РћРџР РћРЎ РЎ РџР РРЎРўР РђРЎРўРР•Рњ / Р›РЈР§РЁР• Р–РР’Р«Рњ (СѓР»СѓС‡С€РµРЅРёСЏ СѓСЂ.6 Рё СѓСЂ.8)
    # ========================================================================

    def clover_interrogation_advantage(target):
        """РЈСЂ.6: РїСЂРµРёРјСѓС‰РµСЃС‚РІРѕ РЅР° РІРѕСЃРїСЂРёСЏС‚РёРµ Рё РІР»Р°СЃС‚СЊ РїРѕ С†РµР»Рё РїРѕРґ РјРµС‚РєРѕР№."""
        if clover_level() < CLOVER_INTERROGATION_LEVEL or target is None:
            return False
        if not clover_is_wanted(target):
            return False
        entry = clover_investigation_entry(getattr(target, "name", str(target)))
        return len(entry.get("crimes", [])) > 0

    def clover_mercy_on_hunter_mark(target):
        """РЈСЂ.8: С†РµР»СЊ Р·Р° СЂРµС€С‘С‚РєРѕР№ РїРѕРґ РјРµС‚РєРѕР№ РѕС…РѕС‚РЅРёРєР° вЂ” РїРѕС‰Р°РґР° 100%."""
        if clover_level() < CLOVER_ALIVE_LEVEL or target is None:
            return False
        key = getattr(target, "name", None) or str(target)
        if key not in (getattr(store, "clover_hunter_mark", {}) or {}):
            return False
        if not clover_is_in_prison(target):
            return False
        target.spare_progress = int(getattr(target, "spare_max", 100) or 100)
        renpy.log("[РљР»РѕРІРµСЂ][Р›СѓС‡С€Рµ Р¶РёРІС‹Рј] {}: РїРѕС‰Р°РґР° 100%".format(key))
        return True

    def clover_mark_hunter(target):
        """РЎС‚Р°РІРёС‚ РјРµС‚РєСѓ РѕС…РѕС‚РЅРёРєР° РЅР° С†РµР»СЊ."""
        if target is None:
            return False
        key = getattr(target, "name", None) or str(target)
        marks = dict(getattr(store, "clover_hunter_mark", {}) or {})
        marks[key] = 2
        store.clover_hunter_mark = marks
        return True

    # ========================================================================
    # Р’РђР¤Р•Р›Р¬РќР«Р™ РџР•Р Р•Р Р«Р’ (РµРґР° РЅР° 3 С…РѕРґР°)
    # ========================================================================

    def clover_start_waffle():
        store.clover_waffle_turns = 3
        return True

    def clover_tick_waffle():
        """+5% С‚РѕС‡РЅРѕСЃС‚Рё Рё +3% HP РєР°Р¶РґС‹Р№ С…РѕРґ, РїРѕРєР° РљР»РѕРІРµСЂ РµСЃС‚ РІР°С„РµР»СЊРєСѓ."""
        turns = int(getattr(store, "clover_waffle_turns", 0) or 0)
        if turns <= 0:
            return False
        char = clover_char()
        if char is None:
            return False
        char.bonus_dmgchance = float(getattr(char, "bonus_dmgchance", 0)) + 0.05
        heal = max(1, int(getattr(char, "max_hp", 0) * 0.03))
        char.current_hp = min(int(getattr(char, "max_hp", 0)), int(getattr(char, "current_hp", 0)) + heal)
        store.clover_waffle_turns = turns - 1
        return True

    # ========================================================================
    # Р’Р«Р—РћР’ РќРђ Р”РЈР­Р›Р¬! (С‚Р°РЅРє РґРѕ РјР°РєСЃРёРјСѓРјР°, Р±РѕРЅСѓСЃС‹ РЅР° СЃР»РµРґСѓСЋС‰РёР№ С…РѕРґ)
    # ========================================================================

    def clover_start_duel():
        char = clover_char()
        if char is None:
            return False
        char.bonus_tank = float(getattr(char, "total_tank", 0)) or 0.0
        store.clover_duel_pending = True
        return True

    def clover_apply_duel_bonuses():
        """РЎР»РµРґСѓСЋС‰РёР№ С…РѕРґ: +15% РїРѕРїР°РґР°РЅРёСЏ, +20% РєСЂРёС‚-С€Р°РЅСЃР°, +40% РєСЂРёС‚-СѓСЂРѕРЅР°."""
        if not bool(getattr(store, "clover_duel_pending", False)):
            return False
        char = clover_char()
        if char is None:
            return False
        char.bonus_dmgchance = float(getattr(char, "bonus_dmgchance", 0)) + 0.15
        char.bonus_critrate = float(getattr(char, "bonus_critrate", 0)) + 0.20
        char.bonus_crit = float(getattr(char, "bonus_crit", 0)) + 0.40
        store.clover_duel_pending = False
        return True

    # ========================================================================
    # РћРў РЎРЈР”Р¬Р‘Р« РќР• РЈР™Р”РЃРЁР¬ (РјРµС‚РєР° СЃСѓРґСЊР±С‹)
    # ========================================================================

    def clover_mark_fate(target):
        char = clover_char()
        if char is None or target is None:
            return False
        store.clover_fate_mark = getattr(target, "name", None) or str(target)
        store.clover_fate_turns = 2
        return True

    def clover_fate_target():
        name = getattr(store, "clover_fate_mark", None)
        if name is None:
            return None
        return (getattr(store, "enemies", {}) or {}).get(name)

    def clover_fate_miss_chance(target):
        """РЁР°РЅСЃ РЅР°РЅРµСЃС‚Рё СѓСЂРѕРЅ РїСЂРё РїСЂРѕРјР°С…Рµ: РєСЂРёС‚-С€Р°РЅСЃ/2 + РїРѕРїР°РґР°РЅРёРµ/3."""
        char = clover_char()
        if char is None:
            return 0.0
        return min(1.0, float(getattr(char, "critrate", 0)) / 2.0 + float(getattr(char, "dmgchance", 0)) / 3.0)

    def clover_fate_hit_bonus():
        """Р‘РѕРЅСѓСЃ РїСЂРё РїРѕРїР°РґР°РЅРёРё Р±РµР· РїРѕРјРѕС‰Рё РїР°СЃСЃРёРІРєРё: 30% РєСЂРёС‚-С€Р°РЅСЃР° Рё 10% РєСЂРёС‚-СѓСЂРѕРЅР° РљР»РѕРІРµСЂР°."""
        char = clover_char()
        if char is None:
            return (0.0, 0.0)
        return (float(getattr(char, "critrate", 0)) * 0.30, float(getattr(char, "crit", 1.0)) * 0.10)

    def clover_tick_fate():
        turns = int(getattr(store, "clover_fate_turns", 0) or 0)
        if turns <= 0:
            store.clover_fate_mark = None
            return False
        turns -= 1
        store.clover_fate_turns = turns
        if turns <= 0:
            store.clover_fate_mark = None
        return True

