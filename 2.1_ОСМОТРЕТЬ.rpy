label check_hero_reaction(attacker_name, target):
    if target.name == attacker_name:
        call check_hero_self(attacker_name, target) from _call_check_self
        return
    if target.name == "Крис":
        call check_hero_kris(attacker_name, target) from _call_check_kris
    elif target.name == "Азриель":
        call check_hero_azriel(attacker_name, target) from _call_check_az
    elif target.name == "Чара":
        call check_hero_chara(attacker_name, target) from _call_check_chara
    elif target.name == "Фриск":
        call check_hero_frisk(attacker_name, target) from _call_check_frisk
    elif target.name == "Иззи":
        call check_hero_izzy(attacker_name, target) from _call_check_izzy
    elif target.name == "Кловер":
        call check_hero_clover(attacker_name, target) from _call_check_clover
    elif target.name == "Седрик":
        call check_hero_sedric(attacker_name, target) from _call_check_sedric
    else:
        call check_hero_generic(attacker_name, target) from _call_check_hg
    return


