init python:
    def debug_initialized_enemy_hp_lines():
        enemies = getattr(store, "enemies", None)
        if not isinstance(enemies, dict) or not enemies:
            return ["enemies: none"]

        lines = []
        for key, enemy in sorted(enemies.items(), key=lambda item: str(item[0])):
            name = getattr(enemy, "name", key)
            hp = getattr(enemy, "current_hp", None)
            max_hp = getattr(enemy, "max_hp", None)
            dmg = getattr(enemy, "damage_gain_for_vis", None)
            crit = getattr(enemy, "got_crit_for_visual", None)
            lines.append("{} [{}]: hp {}/{} dmg_vis={} crit_vis={}".format(
                name, key, hp, max_hp, dmg, crit
            ))
        return lines

    def debug_kris_fightsprite_branch():
        k = store.pers_dict.get("Крис", None)

        if k is None:
            return "Крис не найден в pers_dict"

        state = getattr(k, "state", None)
        style = getattr(k, "sprite_style", None)
        summoned = getattr(store, "summoned", None)
        hp = getattr(k, "current_hp", None)
        dmg = getattr(k, "damage_gain_for_vis", None)

        # DEAD
        if hp <= 0 and style == "up":
            branch = "Kris_dead_up_anim"
        elif hp <= 0 and style == "down":
            branch = "Kris_dead_down_anim"

        # DAMAGED
        elif dmg >= 10 and style == "up":
            branch = "Kris_damaged_up_1.png + Hero_damaged_trans"
        elif dmg >= 10 and style == "down" and summoned == 0:
            branch = "Kris_damaged_down_1.png + Hero_damaged_trans"
        elif dmg >= 10 and style == "down" and summoned == 1:
            branch = "Kris_damaged_down_mech_1.png + Hero_damaged_trans"
        elif dmg >= 10 and style == "down" and summoned == 2:
            branch = "Kris_damaged_down_shield_1.png + Hero_damaged_trans"

        # HEALED
        elif dmg <= -10 and style == "up":
            branch = "Kris_healed_up_1.png + Hero_healed_trans"
        elif dmg <= -10 and style == "down" and summoned == 0:
            branch = "Kris_healed_down_1.png + Hero_healed_trans"
        elif dmg <= -10 and style == "down" and summoned == 1:
            branch = "Kris_healed_down_mech_1.png + Hero_healed_trans"
        elif dmg <= -10 and style == "down" and summoned == 2:
            branch = "Kris_healed_down_shield_1.png + Hero_healed_trans"

        # IDLE
        elif state == "idle" and style == "up":
            branch = "Kris_idle_up_anim"
        elif state == "idle" and style == "down" and summoned == 0:
            branch = "Kris_idle_down_anim"
        elif state == "idle" and style == "down" and summoned == 1:
            branch = "Kris_idle_down_mech_anim"
        elif state == "idle" and style == "down" and summoned == 2:
            branch = "Kris_idle_down_shield_anim"

        # ACT
        elif state == "act" and style == "up":
            branch = "Kris_act_up_anim"
        elif state == "act" and style == "down" and summoned == 0:
            branch = "Kris_act_down_anim"
        elif state == "act" and style == "down" and summoned == 1:
            branch = "Kris_act_down_mech_anim"
        elif state == "act" and style == "down" and summoned == 2:
            branch = "Kris_act_down_shield_anim"

        # ITEM
        elif state == "item" and style == "up":
            branch = "Kris_item_up_anim"
        elif state == "item" and style == "down" and summoned == 0:
            branch = "Kris_item_down_anim"
        elif state == "item" and style == "down" and summoned == 1:
            branch = "Kris_item_down_mech_anim"
        elif state == "item" and style == "down" and summoned == 2:
            branch = "Kris_item_down_shield_anim"

        # ATTACKS
        elif state == "attack_ruka_1" and style == "up":
            branch = "Kris_atk1_up_anim"
        elif state == "attack_ruka_1" and style == "down":
            branch = "Kris_atk1_down_anim"
        elif state == "defend" and style == "up":
            branch = "Kris_defend_up_anim"
        elif state == "defend" and style == "down" and summoned == 0:
            branch = "Kris_defend_down_anim"
        elif state == "defend" and style == "down" and summoned == 1:
            branch = "Kris_defend_down_mech_anim"
        elif state == "defend" and style == "down" and summoned == 2:
            branch = "Kris_defend_down_shield_anim"

        else:
            branch = "НЕТ СОВПАДЕНИЯ / fallback"

        return "branch: {}\nstate: {}\nsprite_style: {}\nsummoned: {}\nhp: {}\ndamage_gain_for_vis: {}".format(
            branch, state, style, summoned, hp, dmg
        )



