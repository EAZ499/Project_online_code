    #____________________________________Союзники
    if show_team_sprites == 1:
        # Используем слоты из team_manager вместо перебора всех персонажей
        $ team_slots = store.team_manager.team_slots
        $ team_member_count = store.team_manager.get_team_member_count()
        $ base_xalign = 0.18
        $ xalign_value = base_xalign - (team_member_count * 0.0005)
        $ base_yalign = 0.25
        $ yalign_value = base_yalign + (team_member_count * 0.15)
        
        vbox:
            xalign xalign_value
