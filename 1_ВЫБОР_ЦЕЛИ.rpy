# ВСПЛЫВАЮЩЕЕ ОКНО "СНАЧАЛА ЦЕЛЬ"
# ============================================================================
# Показывается у курсора (со смещением y - 45), когда игрок пытается выбрать
# недоступную цель. Автоматически закрывается по таймеру.

default mouse_follow_pos = (640, 300)

init python:
    def update_mouse_follow_pos():
        mx, my = renpy.get_mouse_pos()
        store.mouse_follow_pos = (mx, my - 45)
        renpy.restart_interaction()

screen please_choose_target():
    zorder 300

    on "show" action Function (update_mouse_follow_pos)
    # Каждые 0.016 сек (~60 FPS) обновляем позицию и перерисовываем экран.
    timer 0.032 repeat True action Function(update_mouse_follow_pos)

    $ mx, my = mouse_follow_pos

    frame:
        at spare_bar_appear2
        # Координаты берём напрямую, без трансформа — так надёжнее,
        # потому что трансформы кэшируют значения.
        xpos mx
        ypos my
        xanchor 0.5
        yanchor 0.5

        background "#ffffff"
        padding (5, 5)
        xsize 500
        ysize 40

        frame:
            xalign 0.5
            yalign 0.5
            background "#000000"
            xsize 490
            ysize 30
            padding (0, 0)

            text "Сначала выберите цель":
                xalign 0.5
                yalign 0.5
                color "#ffffff"
                size 28
                font "determination.otf"

    timer 2.0 action Hide("please_choose_target")


# Функция для получения списка активных врагов на основе battlenumber
init  python:
    def get_active_enemies():
        """
        Возвращает список имен активных врагов на основе battlenumber.
        """
        # Проверяем, что store.enemies существует и является словарем
        if not hasattr(store, 'enemies') or not isinstance(store.enemies, dict):
            renpy.log("ПРЕДУПРЕЖДЕНИЕ: store.enemies не существует или не является словарем в get_active_enemies()")
            return []
        
        # Добавляем логирование для проверки содержимого store.enemies
        renpy.log(f"DEBUG: store.enemies содержит ключи: {list(store.enemies.keys())}")
            
        if battlenumber == 1: #Арчи
            return ["Арчи"]
        elif battlenumber == 2: #Тревор
            return ["Тревор"]
        elif battlenumber == 3: #Джевил
            return ["ДжевилV1"]
        elif battlenumber == 4: #Психолог
            return ["Психолог"]
        elif battlenumber == 5: #Спамтон
            return ["Спамтон"]
        elif battlenumber == 10: #Первые 4 врага (Арчи, Тревор, Джевил, Психолог)
            return ["Арчи", "Тревор", "ДжевилV1", "Психолог"]
        elif battlenumber == 11:
            return ["dummy", "Тревор", "ДжевилV1"]
        elif battlenumber == 13:
            return ["dummy2", "Тревор"]
        elif battlenumber == 20:  # Лягушки
            return ["Фроглин", "Фрогетта", "Фрогестер", "Фрогис"]
        else:
            return ["нет"]
    
    def check_any_regen():
        """
        Проверяет, есть ли у кого-то из активных персонажей или врагов регенерация HP или маны.
        Возвращает True, если есть хотя бы один персонаж/враг с hpregen > 0 или manaregen > 0.
        """
        # Проверяем всех персонажей в команде (picked == 1)
        if hasattr(store, 'pers_dict') and store.pers_dict:
            for char_name, char in store.pers_dict.items():
                if char.picked == 1:
                    if hasattr(char, 'hpregen') and char.hpregen > 0:
                        return True
                    if hasattr(char, 'manaregen') and char.manaregen > 0:
                        return True
        
        # Проверяем всех активных врагов
        active_enemies = get_active_enemies()
        if hasattr(store, 'enemies') and store.enemies:
            for enemy_name in active_enemies:
                if enemy_name in store.enemies:
                    enemy = store.enemies[enemy_name]
                    if hasattr(enemy, 'hpregen') and enemy.hpregen > 0:
                        return True
                    if hasattr(enemy, 'manaregen') and enemy.manaregen > 0:
                        return True
        
        return False


