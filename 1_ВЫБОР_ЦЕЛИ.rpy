    def _get_turn_effect_hero_base_offsets(team_member_count):
        # Эти значения должны совпадать с yoffset/xoffset vbox в
        # targettochoose_sprites.
        if team_member_count == 4:
            return -40, 0
        elif team_member_count == 3:
            return 0, -45
        elif team_member_count == 2:
            return 0, -70
        return 0, -20

    def _get_turn_effect_hero_positions():
        hero_positions = {}
        team_manager = getattr(store, "team_manager", None)

        if team_manager is None:
            return hero_positions

        team_slots = list(getattr(team_manager, "team_slots", []))
        team_member_count = team_manager.get_team_member_count()

        if team_member_count <= 0:
            return hero_positions

        screen_width, screen_height = _get_turn_effect_screen_size()
        base_xalign = 0.18
        base_yalign = 0.25
        xalign_value = base_xalign - (team_member_count * 0.0005)
        yalign_value = base_yalign + (team_member_count * 0.15)
        extra_x, extra_y = _get_turn_effect_hero_base_offsets(team_member_count)
        base_x = int(screen_width * xalign_value)
        base_y = int(screen_height * yalign_value)
        for slot_index, char_name in enumerate(team_slots):
            if char_name is None or char_name not in store.pers_dict:
                continue

            # Точное смещение hbox конкретного героя из targettochoose_sprites.
            offset_x = slot_index * (-50) - 32
            offset_y = slot_index * (-122) + 32

            hero_positions[char_name] = (
                base_x + extra_x + offset_x + 40,
                base_y + extra_y + offset_y + 40,
            )

        return hero_positions

    def _get_turn_effect_enemy_positions():
        enemy_positions = {}
        active_enemies = get_active_enemies()

        if not active_enemies:
            return enemy_positions

        screen_width, screen_height = _get_turn_effect_screen_size()
        cell_width = 150
        cell_height = 150
        spacing = 20
        grid_width = (cell_width * 2) + spacing
        grid_height = (cell_height * 2) + spacing
        grid_left = int((screen_width * 0.95) - (grid_width * 0.95))
        grid_top = int((screen_height * (0.3 if len(active_enemies) > 2 else 0.5)) - (grid_height * (0.3 if len(active_enemies) > 2 else 0.5)))

        for enemy_index, enemy_name in enumerate(active_enemies):
            row = enemy_index // 2
            column = enemy_index % 2
            enemy_x = grid_left + (column * (cell_width + spacing)) + (50 if enemy_index >= 2 else 0) + (cell_width // 2)
            enemy_y = grid_top + (row * (cell_height + spacing)) + (cell_height // 2)
            enemy_positions[enemy_name] = (enemy_x, enemy_y)

        return enemy_positions

    def get_kris_fight1_effect_vbox_position():
        """
        Возвращает абсолютные координаты центра спрайта Криса 
        для анимации удара неудачника.
        Исправлена проблема неверного вертикального смещения.
        """
        team_manager = getattr(store, "team_manager", None)
        if team_manager is None:
            return getattr(store, "turn_effect_source", (320, 360))
        
        team_slots = list(getattr(team_manager, "team_slots", []))
        
        # Крис всегда должен быть в слоте 0, но проверим на всякий случай
        if "Крис" not in team_slots:
            return getattr(store, "turn_effect_source", (320, 360))
            
        kris_global_index = team_slots.index("Крис")
        
        # ВАЖНО: Считаем только ЖИВЫХ и СУЩЕСТВУЮЩИХ персонажей до Криса.
        # Это соответствует тому, как vbox рендерит детей (пропуская None).
        visible_children_before_kris = 0
        for i in range(kris_global_index):
            name = team_slots[i]
            if name is not None and name in store.pers_dict:
                visible_children_before_kris += 1
                
        # Параметры позиционирования (должны совпадать с параметрами в экране targettochoose_sprites)
        team_member_count = team_manager.get_team_member_count()
        
        # Базовые координаты vbox (из вашего кода экрана)
        base_xalign = 0.18 - (team_member_count * 0.0005)
        base_yalign = 0.25 + (team_member_count * 0.15)
        
        screen_width, screen_height = _get_turn_effect_screen_size()
        vbox_x = int(screen_width * base_xalign)
        vbox_y = int(screen_height * base_yalign)
        
        # Смещения внутри vbox (из вашего цикла for i, char_name...)
        # В оригинальном коде: offset_x = i * (-50) - 32; offset_y = i * (-90 - 32) + 32
        # где i - это индекс ВИДИМОГО ребенка, а не глобальный индекс слота!
        child_offset_x = visible_children_before_kris * (-50) - 32
        child_offset_y = visible_children_before_kris * (-90 - 32) + 32
        
        # Размер спрайта
        sprite_width = 240
        sprite_height = 192
        
        # Финальные координаты центра спрайта
        final_x = vbox_x + child_offset_x + (sprite_width // 2)
        final_y = vbox_y + child_offset_y + (sprite_height // 2)
        
        return (final_x, final_y)

    def build_targettochoose_sprites_effect_layout():
        hero_positions = _get_turn_effect_hero_positions()
        enemy_positions = _get_turn_effect_enemy_positions()
        active_attacker_name = None
        attacker_name_normalizer = globals().get("normalize_current_attacker_name")

        if callable(attacker_name_normalizer):
            active_attacker_name = attacker_name_normalizer(getattr(store, "current_attacker", None))

        source_position = hero_positions.get(active_attacker_name, getattr(store, "turn_effect_source", (320, 360)))

        return {
            "heroes": hero_positions,
            "enemies": enemy_positions,
            "source": source_position,
        }

    def prepare_turn_effect_target(target_entity):
        """
        Сохраняет экранные координаты атакующего и выбранной цели до того,
        как спрайт атаки начнёт выполнять свой transform.
        """
        layout = build_targettochoose_sprites_effect_layout()
        store.turn_effect_source = layout.get("source", (320, 360))

        target_name = getattr(target_entity, "name", None)
        team_slots = list(getattr(getattr(store, "team_manager", None), "team_slots", []))
        store.turn_effect_target_is_team_member = (
            target_entity is not None and (
                target_name in team_slots or
                any(
                    store.pers_dict.get(team_member_name) is target_entity
                    for team_member_name in team_slots
                    if team_member_name is not None
                )
            )
        )
        enemy_positions = layout.get("enemies", {})
        target_position = enemy_positions.get(target_name)

        # Ключ врага в store.enemies не всегда совпадает с его полем name
        # (например, ключ "ДжевилV1"). Находим выбранный объект по идентичности,
        # чтобы третий слот не использовал старую запасную координату.
        if target_position is None and target_entity is not None:
            enemies = getattr(store, "enemies", {})
            for enemy_key in get_active_enemies():
                if enemies.get(enemy_key) is target_entity:
                    target_position = enemy_positions.get(enemy_key)
                    if target_position is not None:
                        break

        if target_position is None:
            target_position = layout.get("heroes", {}).get(target_name)

        if target_position is not None:
            store.turn_effect_target = target_position

        return store.turn_effect_target

    def build_turn_effect_positions(layout=None):
        if layout is None:
            layout = build_targettochoose_sprites_effect_layout()

        effect_positions = []

        for char_name, hero_pos in layout.get("heroes", {}).items():
            char = store.pers_dict.get(char_name)
            if char is None or getattr(char, "damage_gain_for_vis", 0) < 10:
                continue

            effect_positions.append({
                "kind": "hero",
                "name": char_name,
                "x": hero_pos[0],
                "y": hero_pos[1],
                "value": getattr(char, "damage_gain_for_vis", 0),
            })

        for enemy_name, enemy_pos in layout.get("enemies", {}).items():
            enemy = store.enemies.get(enemy_name) if hasattr(store, "enemies") else None
            if enemy is None or getattr(enemy, "damage_gain_for_vis", 0) < 10:
                continue

            effect_positions.append({
                "kind": "enemy",
                "name": enemy_name,
                "x": enemy_pos[0],
                "y": enemy_pos[1],
                "value": getattr(enemy, "damage_gain_for_vis", 0),
            })

        return effect_positions















