            elif get_character_picked_for_shift() == 3:
                #$extra_offset_when_kris_is_not_alone = -320
                yoffset -45 
            elif get_character_picked_for_shift() == 2:
                yoffset -70 #character_picked_for_shift
                #$ total_offset = -320 - 300 - extra_offset_when_kris_is_not_alon
            elif get_character_picked_for_shift() == 1:
                yoffset -20 
            
            for i, char_name in enumerate(team_slots):
                if char_name is not None and char_name in store.pers_dict:
                    $ char = store.pers_dict[char_name]
                    # Сохраняем оригинальную механику смещений
                    $ offset_x = i * (-50)-32  # каждый на 50px влево
                    $ offset_y = i * (-90-32)+32  # каждый на 90px вверх
                    
                    hbox:
                        xoffset offset_x
                        yoffset offset_y
                        
                        # Спрайт союзника без действия
