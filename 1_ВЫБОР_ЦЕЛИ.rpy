screen attack_description:

    on "show":
        action [
            SetVariable("attackdesisopen", 1),
            Function(set_ability_resource_preview, attackindexdesc)
        ]

    on "hide":
        action [
            SetVariable("attackdesisopen", 0),
            Function(clear_ability_resource_preview)
        ]

    $ desc_data = ABILITY_DESCRIPTIONS.get(attackindexdesc)

    # Данные перезарядки показываются в описании способности, а не на кнопке.
    $ _cooldown_ability = next(
        (a for a in BATTLE_ABILITY_DEFINITIONS if a["name"] == attackindexdesc),
        None
    ) if attackindexdesc else None
    $ _cooldown_is_one_time = _cooldown_ability.get("one_time", False) if _cooldown_ability else False
    $ _cooldown_initial = _cooldown_ability.get("initial_cooldown", 0) if _cooldown_ability else 0
    $ _cooldown_after = _cooldown_ability.get("cooldown_after_use", 0) if _cooldown_ability else 0
    $ _show_cooldown = bool(_cooldown_ability) and not _cooldown_is_one_time and (_cooldown_initial != 0 or _cooldown_after != 0)
    $ _cooldown_text = "Перезарядка ({}/{})".format(_cooldown_initial, _cooldown_after)

    $ mp_cost = (
        ABILITY_RESOURCE_COSTS
        .get(attackindexdesc, {})
        .get("mp", 0)
        if attackindexdesc else 0
    )

    frame:
        at desc_position

        xsize 574
        ysize 350
        padding (5, 5)
        background "#ffffff"

        frame:
            xfill True
            yfill True
            padding (15, 15)
            background "#000000"

            if desc_data:

                fixed:
                    xalign 0.0

                    # Верхняя часть: название и описание.
                    vbox:
                        xfill True
                        spacing 12

                        # Название строго по центру.
                        $ attack_display_name = "Защищаться" if isinstance(attackindexdesc, str) and attackindexdesc.startswith("защита_") else attackindexdesc
                        text attack_display_name:
                            size 38
                            color "#ffffff"

                            xfill True
                            textalign 0.5 xalign 0.5

                        # Описание занимает всю ширину.
                        text desc_data["description"]:
                            size 27
                            color "#cccccc"

                            xfill True
                            textalign 0.0
                            layout "greedy"
                            justify True
                            line_spacing 4
        
                        # Нижняя строка.
                        hbox:
                            xfill True
                            yalign 0.5

                            # Проверка действия прижата влево.
                            # Для type == "Действие" заголовок "Эффекты" не показываем.
                            vbox:
                                spacing 12
                                xfill True
                                xalign 0.0

                                if desc_data["effects"]:
                                    if desc_data.get("type") == "Действие":
                                        text desc_data["effects"]:
                                            size 27
                                            color "#ffffff"
                                            xalign 0.1
                                    else:
                                        text "Эффекты":
                                            size 30
                                            color "#fff700"
                                            xalign 0.5

                                        text desc_data["effects"]:
                                            size 27
                                            color "#ffffff"
                                            xalign 0.1
                        
                fixed:
                    # Перезарядка в левой нижней части окна описания.
                    if _show_cooldown:
                        text "[_cooldown_text]":
                            font "determination.otf"
                            size 20
                            color "#aaddff"
                            xalign 0.0
                            yalign 1.0

                    # МП прижато вправо.
                    if mp_cost > 0:

                        text "МП: [mp_cost]":
                            size 20
                            color "#66aaff"

                            xalign 1.0
                            yalign 1.0

                    $ _attacker_now = get_current_battle_character()
                    $ _social_bonus = get_social_bonus_display(_attacker_now, attackindexdesc)
                    if _social_bonus:
                        hbox:
                            xalign 0.0
                            yalign 1.0
                            spacing 12
                            yoffset -22

                            text "Бонусы: [int(_attacker_now.socialization) + int(_social_bonus['stat_value'])]":
                                size 20
                                color "#ffff00"
                                yalign 0.5

                            text "Шанс.очар.: [int(_social_bonus['charm_value'])]%":
                                size 20
                                color "#ffff00"
                                yalign 0.5


                    # ▼▼▼ Сложность броска для текущей цели ▼▼▼
                    $ _diff_text = get_action_difficulty_text(
                        store.target,
                        attackindexdesc,
                        _examine_level(store.target) if store.target else 0
                    )
                    if _diff_text:
                        text "[_diff_text]":
                            size 20
                            color "#ffff00"
                            xalign 1.0
                            yalign 1.0
                            yoffset -22
                    # ▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲

            else:

                text attackindexdesc:
                    size 36
                    color "#ffffff"

                    xfill True
                    textalign 0.5


default go = 0
default target = None  # Выбранная цель (враг или союзник)
default selected_targets = []  # Список выбранных целей для множественных атак
default actionid = None


default pokaz_poshad = 0
# показывается, когда нажата хоть какая-то кнопка
screen turntarget:
    zorder 4

    # При нехватке ресурса экран выбора цели остаётся открытым.
    # Недоступный attackindex сбрасывается, но сами панели не скрываются.
    $ resource_cost_allowed = can_pay_ability_cost(attackindex)
    if not resource_cost_allowed:
        timer 0.01 action [
            Function(renpy.notify, "Недостаточно MP или HP для этого умения."),
            SetVariable("attackindex", None)
        ]

    # Цели, после выбора которых сразу начинается исполнение действия.
    # "toally"/"tochar" — магия по союзнику (например, «Позвать за щит»).
    if resource_cost_allowed and turntype in ("toenemy", "totarget", "toally", "tochar"):
        $ renpy.log(f"DEBUG: turntype={turntype}, target={target}, attackindex={attackindex}, go={go}")

        if target is not None and attackindex is not None:
            timer 0.3 action Jump("Heroperformsturn")
        else:
            $ renpy.log("DEBUG: Цель не выбрана, остаемся на экране выбора цели")




    if turntype == "toenemy" or turntype == "tochar" or turntype == "heroacts" or turntype == 0 or turntype == "totarget":
        use targettochoose
    elif turntype == "cook":
        use cooking_interface
    elif turntype == "act":
        use targettochoose
    #добавь items
    else:
        use targettochoose
        #pass


screen targettochoose_sprites_placeholders:
    # === ОТЛАДОЧНЫЕ ПЛЕЙСХОЛДЕРЫ КООРДИНАТ ===

    # Получаем текущие количества
    $ debug_team_count = store.team_manager.get_team_member_count() if hasattr(store, 'team_manager') else 0
    $ debug_enemy_count = len(get_active_enemies()) if 'get_active_enemies' in globals() else 0

    # Получаем словари координат
    $ debug_hero_coords = get_manual_hero_coordinates(debug_team_count)
    $ debug_enemy_coords = get_manual_enemy_coordinates(debug_enemy_count)

    # Рисуем маркеры для ГЕРОЕВ (Зеленые)
    for hero_name, (hx, hy) in debug_hero_coords.items():
        add Solid("#00ff0088") xysize (40, 40) xpos hx ypos hy anchor (0.5, 0.5)
        text "[hero_name]" xpos hx ypos (hy - 30) size 14 color "#00ff00" xanchor 0.5

    # Рисуем маркеры для ВРАГОВ (Красные)
    for enemy_name, (ex, ey) in debug_enemy_coords.items():
        add Solid("#ff000088") xysize (40, 40) xpos ex ypos ey anchor (0.5, 0.5)
        text "[enemy_name]" xpos ex ypos (ey - 30) size 14 color "#ff0000" xanchor 0.5

    # === ПОЛОСКИ ПРОГРЕССА ПОЩАДЫ (видны в режиме ACT) ===
    # Скрываем полоски при выбранной цели и во время выбора персонажа.
    if actchoice == 1 and not (target is not None and attackindex is not None) and choose_attacker_active == 0:
        for enemy_name, (ex, ey) in debug_enemy_coords.items():
            $ enemy_obj = store.enemies.get(enemy_name) if hasattr(store, "enemies") else None
            if enemy_obj is not None and getattr(enemy_obj, "evaluate_success_count", 0) >= 2:
                $ spare_max_val = max(1.0, float(getattr(enemy_obj, "spare_max", 100)))
                $ spare_ratio = max(0.0, min(1.0, float(getattr(enemy_obj, "spare_progress", 0)) / spare_max_val))
                $ spare_fill_w = int(50 * spare_ratio)

                fixed:
                    # 30 пикселей вниз от нижнего края кубика (нижний край = ey + 20) и 10 вправо
                    xpos ex + 10
                    ypos ey + 50
                    xanchor 0.0
                    yanchor 0.0
                    xysize (50, 16)
                    at spare_bar_appear

                    # Фон полоски — красный, 50 в ширину и 16 в высоту
                    add Solid("#cc0000") xysize (50, 16)

                    # Заполнение — жёлтое, растёт слева направо
                    if spare_fill_w > 0:
                        add Solid("#ffff00") xysize (spare_fill_w, 16) xalign 0.0 yalign 0.5

                    # Процент пощады — белым, в правой части по xalign 1.0
                    text "[int(spare_ratio * 100)]%":
                        size 12
                        color "#ffffff"
                        xalign 1.0
                        yalign 0.5
                        xoffset -2

# Универсальный экран выбора цели (враги или союзники)
screen targettochoose:

    # Добавляем логирование для отладки

    #____________________________________Противники
    if show_enemy_status == 1:
        # Добавляем логирование, если враги должны отображаться
        $ active_enemies = get_active_enemies()
        $ enemy_count = len(active_enemies)
        $ base_yalign = 0.5
        $ yalign_value = 0.3 if enemy_count > 2 else base_yalign

        grid 2 2:
            xalign 0.95
            yalign yalign_value
            spacing 20
            

            $ active_enemies = get_active_enemies()
            
            for i, enemy_name in enumerate(active_enemies):
                $ enemy = store.enemies[enemy_name]
                $ can_target_dead_enemy = attackindex in ["food_tonic", "food_colacoffee"]
                $ can_select_enemy = enemy.current_hp > 0 or can_target_dead_enemy
                $ xoffset_value = 50 if i >= 2 else 0  # если элемент во второй строке
                
                frame:
                    xysize (150, 150)
                    background None
                    xoffset xoffset_value

                    vbox:
                        xalign 0.5
                        yalign 0.5
                        spacing 5

                        imagebutton:
                            idle "newherobox3.png"
                            hover "newherobox3hover.png"
                            action ([
                                #Function(renpy.log, f"DEBUG: Выбран враг {enemy_name}, устанавливаем target={store.enemies[enemy_name]}"),
                                SetVariable("target", store.enemies[enemy_name]),
                                #Function(renpy.log, f"DEBUG: Установили target, теперь target={target}"),
                                SetVariable("go", 1),
                                #Function(renpy.log, f"DEBUG: Установили go=1, теперь go={go}"),
                                #Function(renpy.log, f"Цель выбрана: {enemy_name}")
                            ] if can_select_enemy else Show("please_choose_target"))
                            hovered [SetVariable("target_to_dis_enemy", store.enemies[enemy_name]), Show ("enemydesc")]
                            unhovered [Hide("enemydesc")]
                    # Имя врага под кнопкой
                    #text "[enemy_name]" size 24 color "#ffffff" xalign 0.5
    else:
        text "Нет ничего"


    #____________________________________Союзники
    #
    #
    #
    #
    if show_team_status == 1:    

        hbox:
