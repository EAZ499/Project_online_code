    def get_manual_hero_coordinates(team_count):
        """
        Возвращает словарь координат { "Имя": (x, y) } для героев.
        Учитывает количество членов команды и состояние step_forward.
        Значения xoffset взяты из трансформов step_forward1_0...3.
        """
        slots = store.team_manager.team_slots if hasattr(store, 'team_manager') else []
        coords = {}
        
        # Базовые координаты (x, y) для каждого слота в зависимости от размера команды
        # Эти значения нужно настроить под ваш экран вручную
        base_positions = {}
        
        if team_count == 1:
            if len(slots) > 0 and slots[0]: base_positions[slots[0]] = (270, 330)
            
        elif team_count == 2:
            if len(slots) > 0 and slots[0]: base_positions[slots[0]] = (280, 260)
            if len(slots) > 1 and slots[1]: base_positions[slots[1]] = (230, 325)
            
        elif team_count == 3:
            if len(slots) > 0 and slots[0]: base_positions[slots[0]] = (275, 205)
            if len(slots) > 1 and slots[1]: base_positions[slots[1]] = (230, 270)
            if len(slots) > 2 and slots[2]: base_positions[slots[2]] = (180, 345)
            
        elif team_count >= 4:
            if len(slots) > 0 and slots[0]: base_positions[slots[0]] = (240, 200)
            if len(slots) > 1 and slots[1]: base_positions[slots[1]] = (190, 275)
            if len(slots) > 2 and slots[2]: base_positions[slots[2]] = (140, 345)
            if len(slots) > 3 and slots[3]: base_positions[slots[3]] = (95, 405)

        # Смещения X при step_forward == 1 (из ваших трансформов)
        # transform step_forward1_0: xoffset 55
        # transform step_forward1_1: xoffset 105
        # transform step_forward1_2: xoffset 160
        # transform step_forward1_3: xoffset 210
        step_forward_offsets_x = {
            0: 55,
            1: 105,
            2: 160,
            3: 210
        }

        for slot_index, char_name in enumerate(base_positions.keys()):
            bx, by = base_positions[char_name]
            char_obj = store.pers_dict.get(char_name)
            
            if char_obj and getattr(char_obj, 'step_forward', 0) == 1:
                # Применяем смещение из трансформа
                offset_x = step_forward_offsets_x.get(slot_index, 0)
                # При шаге вперед персонаж обычно смещается только по X (вправо)
                # Y остается прежним или меняется незначительно (здесь оставлен прежним)
                coords[char_name] = (bx + offset_x, by)
            else:
                # Обычная позиция
                coords[char_name] = (bx, by)
                
        return coords

    def get_manual_enemy_coordinates(enemy_count):
        """
        Возвращает список координат [(x, y), ...] для врагов
        в зависимости от их количества.
        """
        active_enemies = get_active_enemies() if 'get_active_enemies' in globals() else []
        coords = {}
        
        if enemy_count == 1:
            if len(active_enemies) > 0: coords[active_enemies[0]] = (965, 300)
            
        elif enemy_count == 2:
            if len(active_enemies) > 0: coords[active_enemies[0]] = (965, 300)
            if len(active_enemies) > 1: coords[active_enemies[1]] = (1125, 300)
            
        elif enemy_count == 3:
            if len(active_enemies) > 0: coords[active_enemies[0]] = (960, 210)
            if len(active_enemies) > 1: coords[active_enemies[1]] = (1125, 210)
            if len(active_enemies) > 2: coords[active_enemies[2]] = (1010, 380)
            
        elif enemy_count >= 4:
            if len(active_enemies) > 0: coords[active_enemies[0]] = (960, 210)
            if len(active_enemies) > 1: coords[active_enemies[1]] = (1125, 210)
            if len(active_enemies) > 2: coords[active_enemies[2]] = (1010, 380)
            if len(active_enemies) > 3: coords[active_enemies[3]] = (1175, 380)
            
        return coords







