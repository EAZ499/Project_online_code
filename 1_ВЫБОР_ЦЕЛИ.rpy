init python:
    def get_social_bonus_display(attacker, action_name):
        """Данные для отображения бонусов соц. действия.
        Возвращает None, если действие не социальное или данных нет."""
        if attacker is None or action_name is None:
            return None
        if not isinstance(action_name, str):
            return None
        if action_name not in ACTS_CONFIG:
            return None

        cfg = ACTS_CONFIG[action_name]
        if not cfg.get("social"):
            return None

        stat_key = cfg["check"]
        stat_ru  = ACT_STAT_RU.get(stat_key, stat_key)

        return {
            "stat_name":    stat_ru,
            "stat_value":   int(getattr(attacker, stat_key, 0)),
            "social_value": int(attacker.socialization),
            "charm_value":  int(attacker.charm),
        }

