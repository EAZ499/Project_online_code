# ---------------------------------------------------------------------
#  РЕАКЦИЯ ГЕРОЯ НА ВОПРОС
#  Роутер: по цели → по конкретному герою.
# ---------------------------------------------------------------------
label ask_hero_reaction(attacker_name, target):

    # Спросить самого себя — общий случай для всех героев
    if target.name == attacker_name:
        call ask_hero_self(attacker_name, target) from _call_ask_hero_self
        return

    # Кто именно цель?
    if target.name == "Крис":
        call ask_hero_kris(attacker_name, target) from _call_ask_hero_kris
    elif target.name == "Азриель":
        call ask_hero_azriel(attacker_name, target) from _call_ask_hero_azriel
    elif target.name == "Чара":
        call ask_hero_chara(attacker_name, target) from _call_ask_hero_chara
    elif target.name == "Фриск":
        call ask_hero_frisk(attacker_name, target) from _call_ask_hero_frisk
    elif target.name == "Иззи":
        call ask_hero_izzy(attacker_name, target) from _call_ask_hero_izzy
    elif target.name == "Кловер":
        call ask_hero_clover(attacker_name, target) from _call_ask_hero_clover
    elif target.name == "Седрик":
        call ask_hero_sedric(attacker_name, target) from _call_ask_hero_sedric
    else:
        call ask_hero_generic(attacker_name, target) from _call_ask_hero_generic

    return


# ---------------------------------------------------------------------
#  СПРОСИТЬ СЕБЯ
# ---------------------------------------------------------------------
label ask_hero_self(attacker_name, target):

    if attacker_name == "Крис":
        if try_to_nego_result:
            "Крис на секунду замолкает и мысленно спрашивает себя:\n«Когда ты в последний раз нормально спал? Не урывками между делами, а по-настоящему?»\nОтвет приходит сам собой, и Крис вздрагивает от того, как давно это было. Вопрос был не праздный — он уже давно кричит изнутри, просто Крис старался не слышать."
        else:
            "Крис пробует задать себе честный вопрос, но мысли тут же расползаются в стороны — как тараканы от света. Он хмурится, пытается поймать хотя бы одну, но в итоге только сильнее запутывается в собственных ощущениях. Может, оно и к лучшему."

    elif attacker_name == "Азриель":
        if try_to_nego_result:
            "Азриель спрашивает себя вполголоса: «А ты сам-то как, Аз? Не для других — для себя.»\nИ впервые за долгое время не отвечает дежурной улыбкой. Что-то внутри разжимается, и он признаётся самому себе: «Устал. Просто устал»."
        else:
            "Азриель пробует задать себе вопрос, но привычка быть «в порядке» перебивает его ещё до конца мысли. Он привычно улыбается собственному отражению и уходит от ответа — даже перед самим собой. Особенно перед самим собой."

    elif attacker_name == "Чара":
        if try_to_nego_result:
            "Чара резко, почти зло спрашивает себя: «Ты вообще чего хочешь, а? Чего ты добиваешься этим своим цирком?»\nИ неожиданно для себя отвечает честно — без цинизма, который обычно прикрывает всё остальное. Ответ ей не нравится, но он её. И это важно."
        else:
            "Чара пытается задать себе вопрос, но злость глушит любые ответы. Она только кривится в пустоту и отворачивается — от себя же. Проще огрызнуться, чем услышать."

    elif attacker_name == "Фриск":
        if try_to_nego_result:
            "Фриск тихо спрашивает себя: «А ты сам(а)-то как? По-настоящему, не для других.»\nИ наконец позволяет себе услышать ответ, который обычно прячет(прячет) за заботой о других. Оказывается, и у Фриска бывают трещины. И это — нормально."
        else:
            "Фриск пробует задать себе честный вопрос, но привычка «справлюсь сама» тут же затыкает его дежурной улыбкой. Фриск даже перед собой продолжает играть роль. Интересно, сколько ещё это будет продолжаться?"

    elif attacker_name == "Иззи":
        if try_to_nego_result:
            "Иззи робко, будто извиняясь за сам вопрос, спрашивает себя: «Ты… ты правда справляешься? Не обманываешь себя?»\nИ, заикаясь, всё же отвечает себе честно — без оглядки на страх, без попытки быть удобной. Так, как и должно быть."
        else:
            "Иззи пытается спросить себя, но смущение перебивает мысль ещё до конца вопроса. Она только краснеет в пустоту и мысленно извиняется за то, что вообще посмела себя о чём-то спросить."

    elif attacker_name == "Кловер":
        if try_to_nego_result:
            "Кловер с усмешкой спрашивает себя: «Ну что, снайпер, всё путём? Как сам-то?»\nИ неожиданно для себя отвечает без шутки — прямо и по делу. Так, как обычно отвечает другим, когда они попадают в беду. Оказывается, себе тоже можно."
        else:
            "Кловер пробует задать себе серьёзный вопрос, но рефлекторно уходит в шутку даже перед собой. «Всё путём, шеф, не впервой!» — бодро говорит она отражению и отворачивается, пока отражение не успело возразить."

    elif attacker_name == "Седрик":
        if try_to_nego_result:
            "Седрик спрашивает себя, устало потирая лицо: «А ты сам-то ел сегодня, а? Или опять весь день у плиты?»\nИ вздыхает — сам ответ знает, а признавать не хочется. Но всё же признаёт, тихо, без свидетелей: «Не ел»."
        else:
            "Седрик пытается честно спросить себя, но забота о других перебивает — он отмахивается от собственных мыслей и возвращается к делам. Кто-то же должен накормить всех остальных."

    else:
        if try_to_nego_result:
            "[attacker_name] спрашивает себя и неожиданно замечает что-то новое — то, что раньше упорно обходил(а) стороной."
        else:
            "[attacker_name] пытается задать вопрос себе, но путается в мыслях и оставляет эту затею до лучших времён."

    return


# ---------------------------------------------------------------------
#  КРИС — ИНДИВИДУАЛЬНЫЕ РЕАКЦИИ НА КАЖДОГО АТАКУЮЩЕГО
# ---------------------------------------------------------------------
label ask_hero_kris(attacker_name, target):

    if attacker_name == "Азриель":
        if try_to_nego_result:
            "Азриель тихо подходит ближе и осторожно спрашивает:\n«Крис, ты как? Ты в последнее время сам не свой. Я не лезу, но… если что — я рядом.»\nКрис поднимает на него усталые глаза и неожиданно для себя отвечает честно. Про то, что не спит. Про то, что что-то тянет его по ночам из кровати, и он не может это объяснить. Азриель слушает, не перебивая."
        else:
            "Азриель пробует заговорить:\n«Крис, ты как…»\nНо Крис только отмахивается и отворачивается. Слишком много всего, чтобы вывалить это сейчас, даже Азриелю. Особенно Азриелю."

    elif attacker_name == "Чара":
        if try_to_nego_result:
            "Чара резко садится напротив, без всяких предисловий:\n«Крис, ты вообще спишь? Синяки под глазами уже как у зомби.»\nКрис сначала хочет отшутиться, но под её колючим, но честным взглядом нехотя признаётся: ночи напролёт где-то пропадает. Чара кивает, будто так и знала."
        else:
            "Чара требовательно спрашивает:\n«Крис, ты вообще спишь?!»\nНо Крис только буркает: «Нормально всё», — и прячет взгляд. Чара недоверчиво хмыкает, но отступает. Пока."

    elif attacker_name == "Фриск":
        if try_to_nego_result:
            "Фриск подходит тихо, садится рядом и мягко спрашивает:\n«Крис, что с тобой происходит? Я же вижу, что не всё в порядке.»\nКрис долго молчит, глядя в сторону. А потом всё же начинает говорить — сначала сбивчиво, потом всё честнее. Фриск просто слушает, не перебивая."
        else:
            "Фриск осторожно окликает:\n«Крис…»\nНо Крис только качает головой: «Не сейчас», — и уходит в себя. Фриск понимающе кивает и не настаивает."

    elif attacker_name == "Иззи":
        if try_to_nego_result:
            "Иззи тихонько присаживается рядом и, запинаясь, спрашивает:\n«Крис… тебе плохо? Ты не думай, я не буду навязываться, просто… если тебе нужно с кем-то поговорить, то…»\nКрис устало улыбается и отвечает честно — по крайней мере, честнее, чем обычно. Иззи сияет от того, что смогла помочь."
        else:
            "Иззи пытается спросить, но Крис лишь криво улыбается и молчит. Иззи смущённо замолкает и отводит взгляд. «Ну, если захочешь — я тут», — говорит она очень тихо."

    elif attacker_name == "Кловер":
        if try_to_nego_result:
            "Кловер плюхается рядом без церемоний и хлопает по плечу:\n«Крис, ну-ка, колись, что стряслось. Вид у тебя такой, будто ты неделю не спал. И, судя по физиономии, это так и есть.»\nКрис вздыхает и что-то рассказывает. Не всё, но хоть что-то. Кловер умеет говорить с людьми так, чтобы те не закрывались."
        else:
            "Кловер настойчиво допытывается:\n«Крис, ну что, опять играешь в молчанку? Колись давай!»\nНо Крис уходит от ответа. Кловер щёлкает языком, но отступает: «Ладно, но я обижусь.»"

    elif attacker_name == "Седрик":
        if try_to_nego_result:
            "Седрик присаживается рядом и без лишних слов протягивает Крису бутерброд:\n«Держи. Тут немного еды, тебе нужно поесть. А заодно расскажешь, что стряслось.»\nКрис благодарно кивает и неожиданно соглашается поговорить — за едой как-то проще. Седрик умеет создать правильную атмосферу."
        else:
            "Седрик заботливо пытается завязать разговор, но Крис только отводит взгляд. Седрик вздыхает и оставляет еду рядом: «Ну, если что — я тут. Голодным не останешься»."

    else:
        if try_to_nego_result:
            "У [attacker_name] получилось спросить Криса. Крис отвечает — нехотя, но отвечает."
        else:
            "У [attacker_name] не получилось спросить Криса. Крис только отделывается невнятным «всё нормально»."

    return


# ---------------------------------------------------------------------
#  ЧАРА — ИНДИВИДУАЛЬНЫЕ РЕАКЦИИ НА КАЖДОГО АТАКУЮЩЕГО
# ---------------------------------------------------------------------
label ask_hero_chara(attacker_name, target):

    if attacker_name == "Крис":
        if try_to_nego_result:
            "Крис осторожно спрашивает:\n«Чара, ты чего такая злая весь день? Что-то случилось?»\nЧара сначала хочет огрызнуться — по привычке. Но взгляд Криса, уставший и внимательный, её останавливает. Она неожиданно для себя отвечает — без колкостей, без цинизма."
        else:
            "Крис пытается спросить, но Чара коротко бросает: «Отстань», — и отворачивается. Крис вздыхает, но не настаивает. С Чары как с ёжика: чем сильнее гладишь, тем сильнее колется."

    elif attacker_name == "Азриель":
        if try_to_nego_result:
            "Азриель мягко, без давления спрашивает:\n«Чара, ты в порядке? Может, поговорим?»\nЧара фыркает — она не любит, когда с ней сюсюкаются. Но что-то в его тоне её задевает. Что-то честное. И она неожиданно отвечает — грубо, но по делу."
        else:
            "Азриель осторожно спрашивает, но Чара огрызается:\n«Не лезь ко мне, принц. Со своей короной разбирайся.»\nИ уходит. Азриель не обижается — он знает, что это не про него."

    elif attacker_name == "Фриск":
        if try_to_nego_result:
            "Фриск тихо говорит:\n«Чара, я знаю, как это — носить всё в себе. Расскажи. Не обязательно сейчас, но расскажи.»\nЧара долго молчит. А потом — впервые за долгое время — выдыхает и говорит. Много. Так, будто прорвало плотину."
        else:
            "Фриск пробует заговорить, но Чара холодно бросает:\n«Ты не поймёшь.»\nИ это не оскорбление — это правда так, как она её видит. Фриск не спорит. Но и не уходит."

    elif attacker_name == "Иззи":
        if try_to_nego_result:
            "Иззи робко подходит и лепечет:\n«Ч-Чара… ты не злись, пожалуйста… я просто хотела спросить…»\nЧара смотрит на неё сверху вниз — и неожиданно смягчается. Что-то в этой маленькой девочке заставляет её снять маску. Она отвечает тихо, почти по-доброму."
        else:
            "Иззи пытается спросить, но Чара рявкает: «Чё надо?» — и бедняжка тут же замолкает, втянув голову в плечи. Чара не извиняется. Но и не так уж сильно сердится."

    elif attacker_name == "Кловер":
        if try_to_nego_result:
            "Кловер подходит с хитрой улыбкой:\n«Чара, а ты вообще улыбаться умеешь? Или это запрещено уставом? Может, тебе справку принести?»\nЧара сначала смотрит убийственно. Потом — неожиданно для себя — фыркает от смеха. И рассказывает. Немного, но честно."
        else:
            "Кловер шутит, но Чара холодно бросает:\n«Не смешно.»\nКловер пожимает плечами: «Ладно, не буду. Но если что — я рядом.» Чара не отвечает, но не уходит. Это уже что-то."

    elif attacker_name == "Седрик":
        if try_to_nego_result:
            "Седрик подходит и без слов протягивает Чаре пирожок:\n«Возьми. Ты злая, потому что голодная — я в этом разбираюсь.»\nЧара скептически смотрит. Но берёт. И, жуя, неожиданно что-то говорит — ворчливо, но честно. Седрик кивает, будто так и знал."
        else:
            "Седрик пытается угостить, но Чара отталкивает его руку:\n«Обойдусь.»\nСедрик не настаивает — только оставляет пирожок на столе. «Будет нужно — возьмёшь.» Чара отворачивается, но пирожок не выбрасывает."

    else:
        if try_to_nego_result:
            "У [attacker_name] получилось спросить Чару. Чара отвечает — колко, но по делу."
        else:
            "У [attacker_name] не получилось спросить Чару. Чара только фыркает и отворачивается."

    return


# ---------------------------------------------------------------------
#  АЗРИЕЛЬ — ИНДИВИДУАЛЬНЫЕ РЕАКЦИИ НА КАЖДОГО АТАКУЮЩЕГО
# ---------------------------------------------------------------------
label ask_hero_azriel(attacker_name, target):

    if attacker_name == "Крис":
        if try_to_nego_result:
            "Крис кладёт руку ему на плечо:\n«Аз, ты в порядке? По-настоящему.»\nАзриель улыбается привычной улыбкой, но Крис не отстаёт: «Не для других — для меня.» И Азриель сдаётся. Говорит честно."
        else:
            "Крис пытается заговорить, но Азриель только качает головой: «Не сейчас, Крис. Правда.» И отворачивается. Крис не настаивает — он знает, как это бывает."

