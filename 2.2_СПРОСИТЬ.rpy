# =====================================================================
#  ФАЙЛ: 2.2_СПРОСИТЬ.rpy
#  Действие: «Вопрос» (ACT → секция 1 → кнопка «Вопрос»)
#
#  ЦЕПОЧКА ВЫЗОВА:
#    ask_label                    — верхний роутер
#     ├─ определяет attacker_name по current_attacker
#     ├─ определяет target_is_hero / target_is_enemy
#     │
#     ├─ if target_is_hero:
#     │   └─ ask_hero_reaction
#     │       ├─ (если target == attacker) → ask_hero_self
#     │       └─ иначе → ask_hero_<имя героя>
#     │           └─ внутри — ветки по attacker_name
#     │
#     └─ if target_is_enemy:
#         └─ ask_enemy_reaction
#             ├─ ЕСЛИ try_to_nego_result:
#             │     apply_act_to_enemy(target, "Вопрос", True)
#             │     action_progress["question_progress"] += 1
#             │     spare_progress += attacker.diplomacy * dip_multiply
#             │  ИНАЧЕ:
#             │     ничего не меняется — кнопка остаётся белой
#             └─ call ask_enemy_<имя врага> — только текст/смена настроения
#
#  КЛЮЧЕВЫЕ ПЕРЕМЕННЫЕ:
#    try_to_nego_result — был ли успех проверки (True/False)
#    dip_multiply       — множитель вклада в пощаду (1 или 2)
#    current_attacker   — индекс атакующего 1..7
#    target             — объект Enemy или Pers
#
#  ХЕЛПЕРЫ (в 1_ПЕРС_ХАРАКТ.rpy):
#    apply_act_to_enemy(enemy, action_name, success=True)
#    set_enemy_mood(enemy, new_mood)  # "neutral"/"sad"/"happy"/"angry"/"feared"
#    get_act_button_color(action_name) # для цвета кнопок в UI
#
#  ЖУРНАЛ НАЖАТИЙ (у каждого врага):
#    enemy.mood_action_used = {
#        "neutral": {"Вопрос": True, ...},
#        "angry":   {"Вопрос": True, ...},
#        ...
#    }
#    При смене настроения журнал нового настроения — пустой,
#    поэтому кнопки снова белые, пока игрок не добьётся успеха.
# =====================================================================


