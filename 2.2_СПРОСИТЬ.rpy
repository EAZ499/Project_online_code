# ---------------------------------------------------------------------
#  РЕАКЦИЯ ПРОТИВНИКА НА ВОПРОС
#  Тексты делегируются конкретному врагу, а вся механика
#  (прогресс действия + пощада + отметка в журнале настроений)
#  выполняется ЗДЕСЬ, один раз для всех врагов.
# ---------------------------------------------------------------------
label ask_enemy_reaction(attacker_name, target):

    # ---- МЕХАНИКА — только при успешной проверке ----
    # При провале ни журнал, ни пощада, ни action_progress не меняются.
    # Кнопка в интерфейсе останется белой, как будто её не нажимали.
    if try_to_nego_result:
        $ apply_act_to_enemy(target, "Вопрос", True)
        $ target.action_progress["question_progress"] += 1
        $ target.spare_progress = min(
            target.spare_progress + attacker.diplomacy * dip_multiply,
            target.spare_max
        )
        if target.spare_progress >= target.spare_max:
            $ renpy.notify("[target.name] готов(а) к пощаде!")

    # ---- ТЕКСТЫ и возможная смена настроения — как было ----
    if target.name == "Тревор":
        $ _r = getattr(target, "route", None)
        if _r == "rivalry" and try_to_nego_result:
            $ trevor_switch_to_peace_route(target)
        call ask_enemy_trevor(attacker_name, target) from _call_ask_enemy_trevor
    elif target.name == "Джевил":
        call ask_enemy_jevil(attacker_name, target) from _call_ask_enemy_jevil
    else:
        call ask_enemy_generic(attacker_name, target) from _call_ask_enemy_generic

    return


