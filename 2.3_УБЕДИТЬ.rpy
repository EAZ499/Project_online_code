label argue_hero_reaction(attacker_name, target):
    if target.name == attacker_name:
        call argue_hero_self(attacker_name, target) from _call_argue_self
        return
    if target.name == "Крис":
        call argue_hero_kris(attacker_name, target) from _call_argue_kris
    elif target.name == "Азриель":
        call argue_hero_azriel(attacker_name, target) from _call_argue_az
    elif target.name == "Чара":
        call argue_hero_chara(attacker_name, target) from _call_argue_chara
    elif target.name == "Фриск":
        call argue_hero_frisk(attacker_name, target) from _call_argue_frisk
    elif target.name == "Иззи":
        call argue_hero_izzy(attacker_name, target) from _call_argue_izzy
    elif target.name == "Кловер":
        call argue_hero_clover(attacker_name, target) from _call_argue_clover
    elif target.name == "Седрик":
        call argue_hero_sedric(attacker_name, target) from _call_argue_sedric
    else:
        call argue_hero_generic(attacker_name, target) from _call_argue_hg
    return


